#cloud-config
# The node VM, laid down once on first boot: the disk the workload runtime lives on, split
# between Docker's data root and the workload checkouts, both XFS with project quotas; the
# node kit from deployment/vm-node; and the vm-manager as a service. The service starts once
# the operator has placed the SYSTEM machine's credentials in
# /etc/kinotic/vm-manager.secrets.env (deployment/terraform/proxmox/README.md).
hostname: kinotic-dev-node
manage_etc_hosts: true

users:
  - name: kinotic
    groups: [sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_public_key}

package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - unzip
  - qemu-guest-agent
  - xfsprogs

# scsi1 is the passthrough disk: half for Docker's data root (guest rootfs, per-workload disk
# caps), half for the checkouts (per-mount size limits). setup-node.sh keeps a data root that
# is already mounted with prjquota, and the fstab lines the mounts module writes carry it.
disk_setup:
  /dev/sdb:
    table_type: gpt
    layout: [50, 50]
    overwrite: false

fs_setup:
  - label: docker
    filesystem: xfs
    device: /dev/sdb1
    overwrite: false
  - label: workloads
    filesystem: xfs
    device: /dev/sdb2
    overwrite: false

mounts:
  - [LABEL=docker, /var/lib/docker, xfs, "prjquota,x-systemd.before=docker.service", "0", "2"]
  - [LABEL=workloads, /var/lib/kinotic/workloads, xfs, "prjquota", "0", "2"]

write_files:
  - path: /etc/kinotic/vm-manager.env
    permissions: "0644"
    content: |
      ${indent(6, vm_manager_env)}
%{ for name, content in vm_node_files ~}
  - path: /opt/kinotic/vm-node/${name}
    encoding: b64
    permissions: "0755"
    content: ${content}
%{ endfor ~}

runcmd:
  - systemctl enable --now qemu-guest-agent
  - /opt/kinotic/vm-node/setup-node.sh
  - mkdir -p /etc/kinotic && touch /etc/kinotic/egress-default-deny && systemctl restart kinotic-node-firewall
  - VM_MANAGER_VERSION=${vm_manager_version} /opt/kinotic/vm-node/install-vm-manager.sh
  - /opt/kinotic/vm-node/verify-node.sh
