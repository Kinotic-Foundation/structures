# The two env files kinotic-dev-server.service hands to docker compose on the platform VM.
#
# /etc/kinotic/dev-server.env — written by `terraform apply` in deployment/terraform/proxmox
# from the Azure outputs; nothing in it is secret.
DEV_SERVER_HOSTNAME=dev.kinotic.ai
KINOTIC_SYSTEMAPI_UIDEPLOYMENT_SITESDOMAIN=apps-dev.kinotic.ai
KINOTIC_SYSTEMAPI_UIDEPLOYMENT_SITESSTORAGEENDPOINT=https://stkinoticdevsites.blob.core.windows.net/
KINOTIC_DOMAIN_SECRETSTORAGE_AZURE_VAULTURL=https://kv-kinotic-dev.vault.azure.net/
KINOTIC_DOMAIN_EMAIL_ENDPOINT=https://acs-kinotic.unitedstates.communication.azure.com
KINOTIC_DOMAIN_EMAIL_SENDERADDRESS=DoNotReply@kinotic.ai
# The platform VM's LAN address: what a workload on the node VM dials, and the one
# destination every workload egress policy permits (IPv4, never a hostname)
KINOTIC_SYSTEMAPI_DEPLOYMENT_SERVERHOST=192.168.1.20
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# /etc/kinotic/secrets.env — placed on the VM by the operator (mode 0600), never through
# terraform. `terraform output -raw secrets_env` in deployment/terraform/azure/dev-server
# prints the Azure half; the rest is chosen or issued by hand.
AZURE_CLIENT_SECRET=
ELASTIC_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# 32 random bytes, base64: SecretNameDeriver derives every Key Vault secret name from it, so
# it is generated once (generate-secrets.sh) and carried to the cloud at migration
KINOTIC_DOMAIN_SECRETSTORAGE_MASTERKEY=
# The GitHub App shared by every development environment; its webhook points at this server
KINOTIC_MANAGEMENTAPI_GITHUB_APPPRIVATEKEY=
KINOTIC_MANAGEMENTAPI_GITHUB_WEBHOOKSECRET=
