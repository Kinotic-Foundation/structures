rise License","\u002Fplatform\u002Fenterprise-license","02.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":234,"title":98,"body":235,"description":1570,"extension":1571,"links":1572,"meta":1573,"navigation":1574,"path":99,"seo":1575,"stem":100,"__hash__":1576},"docs\u002F01.apps\u002F06.security\u002F01.authentication.md",{"type":236,"value":237,"toc":1557},"minimark",[238,242,246,251,268,283,287,298,360,366,370,389,557,570,581,619,723,740,744,755,862,870,874,889,1433,1452,1456,1488,1492,1502,1511,1515,1526,1533,1547,1553],[239,240,25],"h2",{"id":241},"overview",[243,244,245],"p",{},"Kinotic supports multiple authentication methods to secure your applications. Every connection to a Kinotic server requires authentication — the platform identifies the caller and establishes a session before any service calls are allowed.",[247,248,250],"h3",{"id":249},"authentication-methods","Authentication Methods",[252,253,254,262],"ul",{},[255,256,257,261],"li",{},[258,259,260],"strong",{},"Email and Password"," — Built-in user management with secure credential storage. Ideal for getting started quickly or for applications that manage their own user base.",[255,263,264,267],{},[258,265,266],{},"OIDC Providers"," — Connect any standard OpenID Connect provider including Google, Microsoft, Okta, and others. Your organization admin enables OIDC configurations for your application — including platform-provided social providers pre-registered with Kinotic OS.",[243,269,270,271,275,276,279,280,282],{},"This page covers what an application developer needs to know. For the platform-level model behind these mechanisms — scope isolation, the ",[272,273,274],"code",{},"OidcConfiguration"," entity, signup and login flows — see ",[277,278,167],"a",{"href":168}," and ",[277,281,162],{"href":163},".",[247,284,286],{"id":285},"scoped-authentication","Scoped Authentication",[243,288,289,290,293,294,297],{},"Authentication happens at the ",[258,291,292],{},"WebSocket upgrade (handshake)",", not in a STOMP CONNECT frame. Every authentication carries a ",[258,295,296],{},"scope"," that identifies which layer the caller is authenticating against. Scope is structural — it is determined by which of two optional ids are supplied:",[299,300,301,321],"table",{},[302,303,304],"thead",{},[305,306,307,313,318],"tr",{},[308,309,310],"th",{},[272,311,312],{},"organizationId",[308,314,315],{},[272,316,317],{},"applicationId",[308,319,320],{},"Resulting scope",[322,323,324,337,349],"tbody",{},[305,325,326,330,332],{},[327,328,329],"td",{},"absent",[327,331,329],{},[327,333,334],{},[272,335,336],{},"SYSTEM",[305,338,339,342,344],{},[327,340,341],{},"present",[327,343,329],{},[327,345,346],{},[272,347,348],{},"ORGANIZATION",[305,350,351,353,355],{},[327,352,341],{},[327,354,341],{},[327,356,357],{},[272,358,359],{},"APPLICATION",[243,361,362,363,365],{},"For application developers this is always the ",[272,364,359],{}," scope, so both ids are supplied: your organization's id plus your application's id. Scope isolation ensures users are authenticated against the correct user pool — a user in Application A cannot access Application B, even if both applications use the same OIDC provider.",[239,367,369],{"id":368},"connecting-with-email-and-password","Connecting with Email and Password",[243,371,372,373,376,377,380,381,380,384,380,386,388],{},"In Node, pass a ",[272,374,375],{},"BasicCredentialsResolver"," carrying the credential and scope values (",[272,378,379],{},"clientId",", ",[272,382,383],{},"clientSecret",[272,385,312],{},[272,387,317],{},"); they are presented as headers on the WebSocket upgrade:",[390,391,396],"pre",{"className":392,"code":393,"language":394,"meta":395,"style":395},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { BasicCredentialsResolver, Kinotic } from '@kinotic-ai\u002Fcore'\nimport { ensureNodeWebSocket } from '@kinotic-ai\u002Fcore\u002Fnode'\n\nensureNodeWebSocket()\nawait Kinotic.connect({\n    credentials: new BasicCredentialsResolver('user@example.com', 'password', 'my-organization', 'my-application')\n})\n","typescript","",[272,397,398,437,458,465,475,494,549],{"__ignoreMap":395},[399,400,403,407,411,415,418,421,424,427,430,434],"span",{"class":401,"line":402},"line",1,[399,404,406],{"class":405},"s7zQu","import",[399,408,410],{"class":409},"sMK4o"," {",[399,412,414],{"class":413},"sTEyZ"," BasicCredentialsResolver",[399,416,417],{"class":409},",",[399,419,420],{"class":413}," Kinotic",[399,422,423],{"class":409}," }",[399,425,426],{"class":405}," from",[399,428,429],{"class":409}," '",[399,431,433],{"class":432},"sfazB","@kinotic-ai\u002Fcore",[399,435,436],{"class":409},"'\n",[399,438,440,442,444,447,449,451,453,456],{"class":401,"line":439},2,[399,441,406],{"class":405},[399,443,410],{"class":409},[399,445,446],{"class":413}," ensureNodeWebSocket",[399,448,423],{"class":409},[399,450,426],{"class":405},[399,452,429],{"class":409},[399,454,455],{"class":432},"@kinotic-ai\u002Fcore\u002Fnode",[399,457,436],{"class":409},[399,459,461],{"class":401,"line":460},3,[399,462,464],{"emptyLinePlaceholder":463},true,"\n",[399,466,468,472],{"class":401,"line":467},4,[399,469,471],{"class":470},"s2Zo4","ensureNodeWebSocket",[399,473,474],{"class":413},"()\n",[399,476,478,481,483,485,488,491],{"class":401,"line":477},5,[399,479,480],{"class":405},"await",[399,482,420],{"class":413},[399,484,282],{"class":409},[399,486,487],{"class":470},"connect",[399,489,490],{"class":413},"(",[399,492,493],{"class":409},"{\n",[399,495,497,501,504,507,509,511,514,517,519,521,523,526,528,530,532,535,537,539,541,544,546],{"class":401,"line":496},6,[399,498,500],{"class":499},"swJcz","    credentials",[399,502,503],{"class":409},":",[399,505,506],{"class":409}," new",[399,508,414],{"class":470},[399,510,490],{"class":413},[399,512,513],{"class":409},"'",[399,515,516],{"class":432},"user@example.com",[399,518,513],{"class":409},[399,520,417],{"class":409},[399,522,429],{"class":409},[399,524,525],{"class":432},"password",[399,527,513],{"class":409},[399,529,417],{"class":409},[399,531,429],{"class":409},[399,533,534],{"class":432},"my-organization",[399,536,513],{"class":409},[399,538,417],{"class":409},[399,540,429],{"class":409},[399,542,543],{"class":432},"my-application",[399,545,513],{"class":409},[399,547,548],{"class":413},")\n",[399,550,552,555],{"class":401,"line":551},7,[399,553,554],{"class":409},"}",[399,556,548],{"class":413},[243,558,559,560,563,564,566,567,569],{},"The constructor is ",[272,561,562],{},"BasicCredentialsResolver(clientId, clientSecret, organizationId?, applicationId?)",". The ",[272,565,379],{}," is your user's email and ",[272,568,383],{}," is the password — or a machine identity's id and provisioned secret. The platform looks up the user by email within your application's scope, verifies the password against a securely stored bcrypt hash, and establishes a session.",[243,571,572,573,576,577,580],{},"Your application's users and machines connect to the app server, at your application's API host (the ",[272,574,575],{},"VITE_KINOTIC_HOST"," a UI build receives, ",[272,578,579],{},"\u003CorganizationId>--\u003CapplicationId>"," under the platform's application domain) or at the app server's own address. The app server authenticates only application identities and the runtime workloads of your organization's applications: organization and platform credentials fail there as invalid, and on an application's API host so do the credentials of any other application.",[243,582,583,584,587,588,591,592,595,596,599,600,595,603,606,607,610,611,614,615,618],{},"With no ",[272,585,586],{},"credentials"," at all, ",[272,589,590],{},"Kinotic.connect()"," resolves through the default chain: the ",[272,593,594],{},"KINOTIC_CLIENT_ID"," \u002F ",[272,597,598],{},"KINOTIC_CLIENT_SECRET"," (plus optional ",[272,601,602],{},"KINOTIC_ORGANIZATION_ID",[272,604,605],{},"KINOTIC_APPLICATION_ID",") environment variables, then the browser session. Server settings resolve the same way — the ",[272,608,609],{},"server"," option, the ",[272,612,613],{},"KINOTIC_SERVER_HOST\u002FPORT\u002FUSE_SSL"," variables, the page's own location in a browser, then the management server at ",[272,616,617],{},"https:\u002F\u002Fapi.kinotic.ai",", so an application's client names its API host. To pin the server explicitly, pass it alongside the credentials:",[390,620,622],{"className":392,"code":621,"language":394,"meta":395,"style":395},"await Kinotic.connect({\n    server: { host: 'kinotic.example.com', useSSL: true },\n    credentials: new BasicCredentialsResolver('user@example.com', 'password', 'my-organization', 'my-application')\n})\n",[272,623,624,638,673,717],{"__ignoreMap":395},[399,625,626,628,630,632,634,636],{"class":401,"line":402},[399,627,480],{"class":405},[399,629,420],{"class":413},[399,631,282],{"class":409},[399,633,487],{"class":470},[399,635,490],{"class":413},[399,637,493],{"class":409},[399,639,640,643,645,647,650,652,654,657,659,661,664,666,670],{"class":401,"line":439},[399,641,642],{"class":499},"    server",[399,644,503],{"class":409},[399,646,410],{"class":409},[399,648,649],{"class":499}," host",[399,651,503],{"class":409},[399,653,429],{"class":409},[399,655,656],{"class":432},"kinotic.example.com",[399,658,513],{"class":409},[399,660,417],{"class":409},[399,662,663],{"class":499}," useSSL",[399,665,503],{"class":409},[399,667,669],{"class":668},"sfNiH"," true",[399,671,672],{"class":409}," },\n",[399,674,675,677,679,681,683,685,687,689,691,693,695,697,699,701,703,705,707,709,711,713,715],{"class":401,"line":460},[399,676,500],{"class":499},[399,678,503],{"class":409},[399,680,506],{"class":409},[399,682,414],{"class":470},[399,684,490],{"class":413},[399,686,513],{"class":409},[399,688,516],{"class":432},[399,690,513],{"class":409},[399,692,417],{"class":409},[399,694,429],{"class":409},[399,696,525],{"class":432},[399,698,513],{"class":409},[399,700,417],{"class":409},[399,702,429],{"class":409},[399,704,534],{"class":432},[399,706,513],{"class":409},[399,708,417],{"class":409},[399,710,429],{"class":409},[399,712,543],{"class":432},[399,714,513],{"class":409},[399,716,548],{"class":413},[399,718,719,721],{"class":401,"line":467},[399,720,554],{"class":409},[399,722,548],{"class":413},[243,724,725,726,728,729,732,733,736,737,282],{},"Absent ",[272,727,609],{}," fields fall through to the environment — ",[272,730,731],{},"{ host }"," alone means no TLS and port ",[272,734,735],{},"58503",", the management server's gateway port, so a connection to a local app server names its port, ",[272,738,739],{},"58505",[239,741,743],{"id":742},"connecting-with-oidc","Connecting with OIDC",[243,745,746,747,750,751,754],{},"For token-based authentication, pass a Bearer token via ",[272,748,749],{},"BearerCredentialsResolver",". The resolver sends ",[272,752,753],{},"Authorization: Bearer \u003Ctoken>"," on every (re)connect; pass a supplier function to refresh a short-lived token before each connect:",[390,756,758],{"className":392,"code":757,"language":394,"meta":395,"style":395},"import { BearerCredentialsResolver, Kinotic } from '@kinotic-ai\u002Fcore'\nimport { ensureNodeWebSocket } from '@kinotic-ai\u002Fcore\u002Fnode'\n\nensureNodeWebSocket()\nawait Kinotic.connect({\n    credentials: new BearerCredentialsResolver(async () => await getToken())\n})\n",[272,759,760,783,801,805,811,825,856],{"__ignoreMap":395},[399,761,762,764,766,769,771,773,775,777,779,781],{"class":401,"line":402},[399,763,406],{"class":405},[399,765,410],{"class":409},[399,767,768],{"class":413}," BearerCredentialsResolver",[399,770,417],{"class":409},[399,772,420],{"class":413},[399,774,423],{"class":409},[399,776,426],{"class":405},[399,778,429],{"class":409},[399,780,433],{"class":432},[399,782,436],{"class":409},[399,784,785,787,789,791,793,795,797,799],{"class":401,"line":439},[399,786,406],{"class":405},[399,788,410],{"class":409},[399,790,446],{"class":