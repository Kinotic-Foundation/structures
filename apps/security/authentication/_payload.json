ds the session. The host names the application, so the UI never sends its organization or application id:",[390,890,892],{"className":392,"code":891,"language":394,"meta":395,"style":395},"import { Kinotic } from '@kinotic-ai\u002Fcore'\n\nconst env = import.meta.env\nconst server = { host: env.VITE_KINOTIC_HOST, port: parseInt(env.VITE_KINOTIC_PORT), useSSL: env.VITE_KINOTIC_USE_SSL === 'true' }\nconst api = `${server.useSSL ? 'https' : 'http'}:\u002F\u002F${server.host}:${server.port}\u002Fapi\u002Fauth`\nconst post = (path: string, body: object) => fetch(`${api}${path}`, {\n    method: 'POST',\n    credentials: 'include',\n    headers: { 'Content-Type': 'application\u002Fjson' },\n    body: JSON.stringify(body),\n})\n\n\u002F\u002F {type: \"password\"}, or {type: \"sso\", redirect} for a user who signs in with an identity provider\nconst lookup = await (await post('\u002Fapp\u002Flogin\u002Flookup', { email })).json()\nif (lookup.type === 'sso') {\n    window.location.assign(lookup.redirect)\n} else if ((await post('\u002Fapp\u002Flogin', { email, password })).status === 204) {\n    await Kinotic.connect({ server })\n}\n",[272,893,894,912,916,940,1006,1080,1141,1158,1174,1202,1223,1230,1235,1242,1289,1317,1345,1403,1427],{"__ignoreMap":395},[399,895,896,898,900,902,904,906,908,910],{"class":401,"line":402},[399,897,406],{"class":405},[399,899,410],{"class":409},[399,901,420],{"class":413},[399,903,423],{"class":409},[399,905,426],{"class":405},[399,907,429],{"class":409},[399,909,433],{"class":432},[399,911,436],{"class":409},[399,913,914],{"class":401,"line":439},[399,915,464],{"emptyLinePlaceholder":463},[399,917,918,921,924,927,930,932,935,937],{"class":401,"line":460},[399,919,920],{"class":839},"const",[399,922,923],{"class":413}," env ",[399,925,926],{"class":409},"=",[399,928,929],{"class":405}," import",[399,931,282],{"class":409},[399,933,934],{"class":413},"meta",[399,936,282],{"class":409},[399,938,939],{"class":413},"env\n",[399,941,942,944,947,949,95