m\u002Fdefense-in-depth","02.platform\u002F06.defense-in-depth",{"title":176,"path":177,"stem":178,"icon":179},"MCP Tools","\u002Fplatform\u002Fmcp-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":181,"path":182,"stem":183,"icon":184},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":186,"path":187,"stem":188,"icon":189},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":191,"path":192,"stem":193,"icon":194},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":196,"path":197,"stem":198,"icon":199},"Service Call Liveness","\u002Fplatform\u002Fservice-call-liveness","02.platform\u002F11.service-call-liveness","i-lucide-heart-pulse",{"title":128,"icon":129,"path":201,"stem":202,"children":203,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F12.reference",[204,209,214],{"title":205,"path":206,"stem":207,"icon":208},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":210,"path":211,"stem":212,"icon":213},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","02.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":215,"path":216,"stem":217,"icon":151},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","02.platform\u002F12.reference\u002F03.project-publishing-design",{"id":219,"title":98,"body":220,"description":999,"extension":1000,"links":1001,"meta":1002,"navigation":1003,"path":99,"seo":1004,"stem":100,"__hash__":1005},"docs\u002F01.apps\u002F06.security\u002F01.authentication.md",{"type":221,"value":222,"toc":986},"minimark",[223,227,231,236,253,268,272,283,345,351,355,374,542,555,593,697,710,714,725,832,840,844,851,890,894,917,921,931,940,944,955,962,976,982],[224,225,25],"h2",{"id":226},"overview",[228,229,230],"p",{},"Kinotic supports multiple authentication methods to secure your applications. Every connection to a Kinotic server requires authentication — the platform identifies the caller and establishes a session before any service calls are allowed.",[232,233,235],"h3",{"id":234},"authentication-methods","Authentication Methods",[237,238,239,247],"ul",{},[240,241,242,246],"li",{},[243,244,245],"strong",{},"Email and Password"," — Built-in user management with secure credential storage. Ideal for getting started quickly or for applications that manage their own user base.",[240,248,249,252],{},[243,250,251],{},"OIDC Providers"," — Connect any standard OpenID Connect provider including Google, Microsoft, Okta, and others. Your organization admin enables OIDC configurations for your application — including platform-provided social providers pre-registered with Kinotic OS.",[228,254,255,256,260,261,264,265,267],{},"This page covers what an application developer needs to know. For the platform-level model behind these mechanisms — scope isolation, the ",[257,258,259],"code",{},"OidcConfiguration"," entity, signup and login flows — see ",[262,263,167],"a",{"href":168}," and ",[262,266,162],{"href":163},".",[232,269,271],{"id":270},"scoped-authentication","Scoped Authentication",[228,273,274,275,278,279,282],{},"Authentication happens at the ",[243,276,277],{},"WebSocket upgrade (handshake)",", not in a STOMP CONNECT frame. Every authentication carries a ",[243,280,281],{},"scope"," that identifies which layer the caller is authenticating against. Scope is structural — it is determined by which of two optional ids are supplied:",[284,285,286,306],"table",{},[287,288,289],"thead",{},[290,291,292,298,303],"tr",{},[293,294,295],"th",{},[257,296,297],{},"organizationId",[293,299,300],{},[257,301,302],{},"applicationId",[293,304,305],{},"Resulting scope",[307,308,309,322,334],"tbody",{},[290,310,311,315,317],{},[312,313,314],"td",{},"absent",[312,316,314],{},[312,318,319],{},[257,320,321],{},"SYSTEM",[290,323,324,327,329],{},[312,325,326],{},"present",[312,328,314],{},[312,330,331],{},[257,332,333],{},"ORGANIZATION",[290,335,336,338,340],{},[312,337,326],{},[312,339,326],{},[312,341,342],{},[257,343,344],{},"APPLICATION",[228,346,347,348,350],{},"For application developers this is always the ",[257,349,344],{}," scope, so both ids are supplied: your organization's id plus your application's id. Scope isolation ensures users are authenticated against the correct user pool — a user in Application A cannot access Application B, even if both applications use the same OIDC provider.",[224,352,354],{"id":353},"connecting-with-email-and-password","Connecting with Email and Password",[228,356,357,358,361,362,365,366,365,369,365,371,373],{},"In Node, pass a ",[257,359,360],{},"BasicCredentialsResolver"," carrying the credential and scope values (",[257,363,364],{},"clientId",", ",[257,367,368],{},"clientSecret",[257,370,297],{},[257,372,302],{},"); they are presented as headers on the WebSocket upgrade:",[375,376,381],"pre",{"className":377,"code":378,"language":379,"meta":380,"style":380},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { BasicCredentialsResolver, Kinotic } from '@kinotic-ai\u002Fcore'\nimport { ensureNodeWebSocket } from '@kinotic-ai\u002Fcore\u002Fnode'\n\nensureNodeWebSocket()\nawait Kinotic.connect({\n    credentials: new BasicCredentialsResolver('user@example.com', 'password', 'my-organization', 'my-application')\n})\n","typescript","",[257,382,383,422,443,450,460,479,534],{"__ignoreMap":380},[384,385,388,392,396,400,403,406,409,412,415,419],"span",{"class":386,"line":387},"line",1,[384,389,391],{"class":390},"s7zQu","import",[384,393,395],{"class":394},"sMK4o"," {",[384,397,399],{"class":398},"sTEyZ"," BasicCredentialsResolver",[384,401,402],{"class":394},",",[384,404,405],{"class":398}," Kinotic",[384,407,408],{"class":394}," }",[384,410,411],{"class":390}," from",[384,413,414],{"class":394}," '",[384,416,418],{"class":417},"sfazB","@kinotic-ai\u002Fcore",[384,420,421],{"class":394},"'\n",[384,423,425,427,429,432,434,436,438,441],{"class":386,"line":424},2,[384,426,391],{"class":390},[384,428,395],{"class":394},[384,430,431],{"class":398}," ensureNodeWebSocket",[384,433,408],{"class":394},[384,435,411],{"class":390},[384,437,414],{"class":394},[384,439,440],{"class":417},"@kinotic-ai\u002Fcore\u002Fnode",[384,442,421],{"class":394},[384,444,446],{"class":386,"line":445},3,[384,447,449],{"emptyLinePlaceholder":448},true,"\n",[384,451,453,457],{"class":386,"line":452},4,[384,454,456],{"class":455},"s2Zo4","ensureNodeWebSocket",[384,458,459],{"class":398},"()\n",[384,461,463,466,468,470,473,476],{"class":386,"line":462},5,[384,464,465],{"class":390},"await",[384,467,405],{"class":398},[384,469,267],{"class":394},[384,471,472],{"class":455},"connect",[384,474,475],{"class":398},"(",[384,477,478],{"class":394},"{\n",[384,480,482,486,489,492,494,496,499,502,504,506,508,511,513,515,517,520,522,524,526,529,531],{"class":386,"line":481},6,[384,483,485],{"class":484},"swJcz","    credentials",[384,487,488],{"class":394},":",[384,490,491],{"class":394}," new",[384,493,399],{"class":455},[384,495,475],{"class":398},[384,497,498],{"class":394},"'",[384,500,501],{"class":417},"user@example.com",[384,503,498],{"class":394},[384,505,402],{"class":394},[384,507,414],{"class":394},[384,509,510],{"class":417},"password",[384,512,498],{"class":394},[384,514,402],{"class":394},[384,516,414],{"class":394},[384,518,519],{"class":417},"my-organization",[384,521,498],{"class":394},[384,523,402],{"class":394},[384,525,414],{"class":394},[384,527,528],{"class":417},"my-application",[384,530,498],{"class":394},[384,532,533],{"class":398},")\n",[384,535,537,540],{"class":386,"line":536},7,[384,538,539],{"class":394},"}",[384,541,533],{"class":398},[228,543,544,545,548,549,551,552,554],{},"The constructor is ",[257,546,547],{},"BasicCredentialsResolver(clientId, clientSecret, organizationId?, applicationId?)",". The ",[257,550,364],{}," is your user's email and ",[257,553,368],{}," is the password — or a machine identity's id and provisioned secret. The platform looks up the user by email within your application's scope, verifies the password against a securely stored bcrypt hash, and establishes a session.",[228,556,557,558,561,562,565,566,569,570,573,574,569,577,580,581,584,585,588,589,592],{},"With no ",[257,559,560],{},"credentials"," at all, ",[257,563,564],{},"Kinotic.connect()"," resolves through the default chain: the ",[257,567,568],{},"KINOTIC_CLIENT_ID"," \u002F ",[257,571,572],{},"KINOTIC_CLIENT_SECRET"," (plus optional ",[257,575,576],{},"KINOTIC_ORGANIZATION_ID",[257,578,579],{},"KINOTIC_APPLICATION_ID",") environment variables, then the browser session. Server settings resolve the same way — the ",[257,582,583],{},"server"," option, the ",[257,586,587],{},"KINOTIC_SERVER_HOST\u002FPORT\u002FUSE_SSL"," variables, the page's own location in a browser, then ",[257,590,591],{},"https:\u002F\u002Fapi.kinotic.ai",". To pin the server explicitly, pass it alongside the credentials:",[375,594,596],{"className":377,"code":595,"language":379,"meta":380,"style":380},"await Kinotic.connect({\n    server: { host: 'kinotic.example.com', useSSL: true },\n    credentials: new BasicCredentialsResolver('user@example.com', 'password', 'my-organization', 'my-application')\n})\n",[257,597,598,612,647,691],{"__ignoreMap":380},[384,599,600,602,604,606,608,610],{"class":386,"line":387},[384,601,465],{"class":390},[384,603,405],{"class":398},[384,605,267],{"class":394},[384,607,472],{"class":455},[384,609,475],{"class":398},[384,611,478],{"class":394},[384,613,614,617,619,621,624,626,628,631,633,635,638,640,644],{"class":386,"line":424},[384,615,616],{"class":484},"    server",[384,618,488],{"class":394},[384,620,395],{"class":394},[384,622,623],{"class":484}," host",[384,625,488],{"class":394},[384,627,414],{"class":394},[384,629,630],{"class":417},"kinotic.example.com",[384,632,498],{"class":394},[384,634,402],{"class":394},[384,636,637],{"class":484}," useSSL",[384,639,488],{"class":394},[384,641,643],{"class":642},"sfNiH"," true",[384,645,646],{"class":394}," },\n",[384,648,649,651,653,655,657,659,661,663,665,667,669,671,673,675,677,679,681,683,685,687,689],{"class":386,"line":445},[384,650,485],{"class":484},[384,652,488],{"class":394},[384,654,491],{"class":394},[384,656,399],{"class":455},[384,658,475],{"class":398},[384,660,498],{"class":394},[384,662,501],{"class":417},[384,664,498],{"class":394},[384,666,402],{"class":394},[384,668,414],{"class":394},[384,670,510],{"class":417},[384,672,498],{"class":394},[384,674,402],{"class":394},[384,676,414],{"class":394},[384,678,519],{"class":417},[384,680,498],{"class":394},[384,682,402],{"class":394},[384,684,414],{"class":394},[384,686,528],{"class":417},[384,688,498],{"class":394},[384,690,533],{"class":398},[384,692,693,695],{"class":386,"line":452},[384,694,539],{"class":394},[384,696,533],{"class":398},[228,698,699,700,702,703,706,707,267],{},"Absent ",[257,701,583],{}," fields fall through to the environment — ",[257,704,705],{},"{ host }"," alone means no TLS and the gateway port ",[257,708,709],{},"58503",[224,711,713],{"id":712},"connecting-with-oidc","Connecting with OIDC",[228,715,716,717,720,721,724],{},"For token-based authentication, pass a Bearer token via ",[257,718,719],{},"BearerCredentialsResolver",". The resolver sends ",[257,722,723],{},"Authorization: Bearer \u003Ctoken>"," on every (re)connect; pass a supplier function to refresh a short-lived token before each connect:",[375,726,728],{"className":377,"code":727,"language":379,"meta":380,"style":380},"import { BearerCredentialsResolver, Kinotic } from '@kinotic-ai\u002Fcore'\nimport { ensureNodeWebSocket } from '@kinotic-ai\u002Fcore\u002Fnode'\n\nensureNodeWebSocket()\nawait Kinotic.connect({\n    credentials: new BearerCredentialsResolver(async () => await getToken())\n})\n",[257,729,730,753,771,775,781,795,826],{"__ignoreMap":380},[384,731,732,734,736,739,741,743,745,747,749,751],{"class":386,"line":387},[384,733,391],{"class":390},[384,735,395],{"class":394},[384,737,738],{"class":398}," BearerCredentialsResolver",[384,740,402],{"class":394},[384,742,405],{"class":398},[384,744,408],{"class":394},[384,746,411],{"class":390},[384,748,414],{"class":394},[384,750,418],{"class":417},[384,752,421],{"class":394},[384,754,755,757,759,761,763,765,767,769],{"class":386,"line":424},[384,756,391],{"class":390},[384,758,395],{"class":394},[384,760,431],{"class":398},[384,762,408],{"class":394},[384,764,411],{"class":390},[384,766,414],{"class":394},[384,768,440],{"class":417},[384,770,421],{"class":394},[384,772,773],{"class":386,"line":445},[384,774,449],{"emptyLinePlaceholder":448},[384,776,777,779],{"class":386,"line":452},[384,778,456],{"class":455},[384,780,459],{"class":398},[384,782,783,785,787,789,791,793],{"class":386,"line":462},[384,784,465],{"class":390},[384,786,405],{"class":398},[384,788,267],{"class":394},[384,790,472],{"class":455},[384,792,475],{"class":398},[384,794,478],{"class":394},[384,796,797,799,801,803,805,807,811,814,817,820,823],{"class":386,"line":481},[384,798,485],{"class":484},[384,800,488],{"class":394},[384,802,491],{"class":394},[384,804,738],{"class":455},[384,806,475],{"class":398},[384,808,810],{"class":809},"spNyl","async",[384,812,813],{"class":394}," ()",[384,815,816],{"class":809}," =>",[384,818,819],{"class":390}," await",[384,821,822],{"class":455}," getToken",[384,824,825],{"class":398},"())\n",[384,827,828,830],{"class":386,"line":536},[384,829,539],{"class":394},[384,831,533],{"class":398},[228,833,834,835,569,837,839],{},"A Kinotic-minted JWT already carries the ",[257,836,297],{},[257,838,302],{}," claims, so no scope headers are needed alongside it. The platform validates the JWT against the OIDC configurations enabled for your application, matches the token's email to a pre-existing user in your application's scope, and establishes a session.",[232,841,843],{"id":842},"browser-applications","Browser applications",[228,845,846,847,850],{},"A browser SPA does ",[243,848,849],{},"not"," supply credentials. It logs in through the OIDC\u002FREST flow, which establishes a session cookie, then connects with nothing — the default resolution finds the session, and the server settings come from the page's own location:",[375,852,854],{"className":377,"code":853,"language":379,"meta":380,"style":380},"import { Kinotic } from '@kinotic-ai\u002Fcore'\n\nawait Kinotic.connect()\n",[257,855,856,874,878],{"__ignoreMap":380},[384,857,858,860,862,864,866,868,870,872],{"class":386,"line":387},[384,859,391],{"class":390},[384,861,395],{"class":394},[384,863,405],{"class":398},[384,865,408],{"class":394},[384,867,411],{"class":390},[384,869,414],{"class":394},[384,871,418],{"class":417},[384,873,421],{"class":394},[384,875,876],{"class":386,"line":424},[384,877,449],{"emptyLinePlaceholder":448},[384,879,880,882,884,886,888],{"class":386,"line":445},[384,881,465],{"class":390},[384,883,405],{"class":398},[384,885,267],{"class":394},[384,887,472],{"class":455},[384,889,459],{"class":398},[232,891,893],{"id":892},"how-oidc-works-with-your-application","How OIDC Works with Your Application",[895,896,897,900,903,906,914],"ol",{},[240,898,899],{},"Your platform administrator enables one or more OIDC configurations for your application (e.g., Google, Microsoft)",[240,901,902],{},"Your frontend initiates the OAuth flow with the provider — the user sees the provider's consent screen",[240,904,905],{},"The provider returns a JWT to your frontend",[240,907,908,909,569,911,913],{},"Your frontend connects to Kinotic — in the browser via the session cookie established by the REST login; the Kinotic-minted JWT carries the ",[257,910,297],{},[257,912,302],{}," claims that identify the scope",[240,915,916],{},"The platform validates the token, looks up the user, and creates a session",[232,918,920],{"id":919},"reusable-providers","Reusable Providers",[228,922,923,924,926,927,930],{},"Kinotic OS registers once with providers like Google and Microsoft. The platform operator provisions these as ",[257,925,259],{}," entities; your organization admin enables them for your application by adding the configuration id to your application's ",[257,928,929],{},"oidcConfigurationIds",". End users see \"Kinotic OS\" on the consent screen, and your application benefits without any provider registration.",[228,932,933,934,936,937,939],{},"The same ",[257,935,259],{}," shape is used for an organization's enterprise SSO (e.g. a corporate Okta instance) — see ",[262,938,167],{"href":168}," for how the platform-vs-org distinction is captured by reference rather than by a flag on the entity.",[224,941,943],{"id":942},"user-management","User Management",[228,945,946,947,950,951,954],{},"Application-scope users are ",[243,948,949],{},"pre-created"," by an administrator before they can authenticate. This is a deliberate security design — having a valid Google account does not automatically grant access to your application. Self-service signup applies to the ",[262,952,953],{"href":163},"Organization scope"," (the admin who runs the org); the same data model supports application-scope self-signup, but enabling it is admin-controlled.",[228,956,957,958,961],{},"Your organization administrator manages your application's users from the organization's ",[243,959,960],{},"Members"," page:",[237,963,964,970],{},[240,965,966,969],{},[243,967,968],{},"Local users"," are created with an email and password",[240,971,972,975],{},[243,973,974],{},"OIDC users"," are created with an email only — the OIDC subject is linked automatically on first login",[228,977,978,979,981],{},"For details on user and OIDC configuration management, see the ",[262,980,162],{"href":163}," platform guide.",[983,984,985],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .sfNiH, html code.shiki .sfNiH{--shiki-light:#FF5370;--shiki-default:#FF9CAC;--shiki-dark:#FF9CAC}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}",{"title":380,"searchDepth":424,"depth":424,"links":987},[988,992,993,998],{"id":226,"depth":424,"text":25,"children":989},[990,991],{"id":234,"depth":445,"text":235},{"id":270,"depth":445,"text":271},{"id":353,"depth":424,"text":354},{"id":712,"depth":424,"text":713,"children":994},[995,996,997],{"id":842,"depth":445,"text":843},{"id":892,"depth":445,"text":893},{"id":919,"depth":445,"text":920},{"id":942,"depth":424,"text":943},"Authentication methods and identity management in Kinotic.","md",null,{},{"icon":101},{"title":98,"description":999},"KTHmi0lMm0mZb3Et6xDYrikKMOu3j2k4FAqGvJvs4bs",[1007,1009],{"title":88,"path":89,"stem":90,"description":1008,"children":-1},"Schema evolution using versioned migration scripts for Kinotic's persistence layer.",{"title":109,"path":110,"stem":111,"description":1010,"icon":112,"children":-1},"The Kinotic deployment pipeline from development to production.",1788935618802]