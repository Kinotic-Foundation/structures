,446],{"class":413},[399,792,423],{"class":409},[399,794,426],{"class":405},[399,796,429],{"class":409},[399,798,455],{"class":432},[399,800,436],{"class":409},[399,802,803],{"class":401,"line":460},[399,804,464],{"emptyLinePlaceholder":463},[399,806,807,809],{"class":401,"line":467},[399,808,471],{"class":470},[399,810,474],{"class":413},[399,812,813,815,817,819,821,823],{"class":401,"line":477},[399,814,480],{"class":405},[399,816,420],{"class":413},[399,818,282],{"class":409},[399,820,487],{"class":470},[399,822,490],{"class":413},[399,824,493],{"class":409},[399,826,827,829,831,833,835,837,841,844,847,850,853],{"class":401,"line":496},[399,828,500],{"class":499},[399,830,503],{"class":409},[399,832,506],{"class":409},[399,834,768],{"class":470},[399,836,490],{"class":413},[399,838,840],{"class":839},"spNyl","async",[399,842,843],{"class":409}," ()",[399,845,846],{"class":839}," =>",[399,848,849],{"class":405}," await",[399,851,852],{"class":470}," getToken",[399,854,855],{"class":413},"())\n",[399,857,858,860],{"class":401,"line":551},[399,859,554],{"class":409},[399,861,548],{"class":413},[243,863,864,865,595,867,869],{},"A Kinotic-minted JWT already carries the ",[272,866,312],{},[272,868,317],{}," claims, so no scope headers are needed alongside it. The platform validates the JWT against the OIDC configurations enabled for your application, matches the token's email to a pre-existing user in your application's scope, and establishes a session.",[247,871,873],{"id":872},"browser-applications","Browser applications",[243,875,876,877,880,881,883,884,888],{},"A browser UI does ",[258,878,879],{},"not"," supply credentials. It signs its user in over REST at its application's API host, the ",[272,882,575],{}," of ",[277,885,887],{"href":886},"\u002Fapps\u002Fapplication-structure\u002Fapplications-and-projects#the-ui-build-contract","the UI build contract",", which sets a session cookie for that host, then connects to the same host with no credentials — the default resolution finds the session. The host names the application, so the UI never sends its organization or application id:",[390,890,892],{"className":392,"code":891,"language":394,"meta":395,"style":395},"import { Kinotic } from '@kinotic-ai\u002Fcore'\n\nconst env = import.meta.env\nconst server = { host: env.VITE_KINOTIC_HOST, port: parseInt(env.VITE_KINOTIC_PORT), useSSL: env.VITE_KINOTIC_USE_SSL === 'true' }\nconst api = `${server.useSSL ? 'https' : 'http'}:\u002F\u002F${server.host}:${server.port}\u002Fapi\u002Fauth`\nconst post = (path: string, body: object) => fetch(`${api}${path}`, {\n    method: 'POST',\n    credentials: 'include',\n    headers: { 'Content-Type': 'application\u002Fjson' },\n    body: JSON.stringify(body),\n})\n\n\u002F\u002F the password form\nif ((await post('\u002Fapp\u002Flogin', { email, password })).status === 204) {\n    await Kinotic.connect({ server })\n}\n\n\u002F\u002F one \"Continue with \u003Cname>\" button per provider the login offers\nconst providers = await (await fetch(`${api}\u002Fapp\u002Flogin\u002Fproviders`, { credentials: 'include' })).json()\nasync function continueWith(provider: { id: string }) {\n    const start = await (await post(`\u002Fapp\u002Flogin\u002Foidc\u002Fstart\u002F${provider.id}`, {})).json()\n    window.location.assign(start.redirect)\n}\n",[272,893,894,912,916,940,1006,1080,1141,1158,1174,1202,1223,1230,1235,1242,1298,1322,1328,1333,1339,1397,1429,1480,1508],{"__ignoreMap":395},[399,895,896,898,900,902,904,906,908,910],{"class":401,"line":402},[399,897,406],{"class":405},[399,899,410],{"class":409},[399,901,420],{"class":413},[399,903,423],{"class":409},[399,905,426],{"class":405},[399,907,429],{"class":409},[399,909,433],{"class":432},[399,911,436],{"class":409},[399,913,914],{"class":401,"line":439},[399,915,464],{"emptyLinePlaceholder":463},[399,917,918,921,924,927,930,932,935,937],{"class":401,"line":460},[399,919,920],{"class":839},"const",[399,922,923],{"class":413}," env ",[399,925,926],{"cla