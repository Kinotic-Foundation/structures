terprise License","\u002Fplatform\u002Fenterprise-license","02.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":234,"title":80,"body":235,"description":1061,"extension":1062,"links":1063,"meta":1064,"navigation":343,"path":81,"seo":1065,"stem":82,"__hash__":1066},"docs\u002F01.apps\u002F05.persistence\u002F05.named-queries.md",{"type":236,"value":237,"toc":1050},"minimark",[238,247,250,255,282,286,296,590,596,599,603,645,649,664,704,708,719,747,751,815,819,840,844,856,1038,1046],[239,240,241,242,246],"p",{},"Named queries let you define custom query methods on your repositories. You declare methods with the ",[243,244,245],"code",{},"@Query"," decorator, sync them with the server, and the CLI generates the implementation.",[239,248,249],{},"A named query belongs to the entity of its repository and acts on that entity alone: the statement names that entity, and a statement that names any other entity fails.",[251,252,254],"h2",{"id":253},"workflow","Workflow",[256,257,258,266,272],"ol",{},[259,260,261,262,265],"li",{},"Run ",[243,263,264],{},"kinotic sync"," to sync your entities and generate the base repository classes",[259,267,268,269,271],{},"Add custom methods with the ",[243,270,245],{}," decorator to the generated repository class",[259,273,261,274,277,278,281],{},[243,275,276],{},"kinotic generate"," to regenerate the repository with your query implementations (",[243,279,280],{},"generate"," runs locally without syncing to the server)",[251,283,285],{"id":284},"defining-named-queries","Defining Named Queries",[239,287,288,289,291,292,295],{},"Add methods with the ",[243,290,245],{}," decorator to your repository class. Use ",[243,293,294],{},":paramName"," syntax for parameter binding; each parameter takes the method argument of the same name.",[297,298,303],"pre",{"className":299,"code":300,"language":301,"meta":302,"style":302},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Query } from '@kinotic-ai\u002Fpersistence'\n\nexport class OrderRepository extends BaseOrderRepository {\n\n    @Query('SELECT * FROM Order WHERE status = :status ORDER BY placedAt DESC LIMIT 100')\n    findByStatus(status: string): Promise\u003COrder[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n\n    @Query('UPDATE Order SET status = :status WHERE id = :id WITH REFRESH')\n    updateStatus(id: string, status: string): Promise\u003CWriteCount[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n\n    @Query('SELECT COUNT(*) AS count FROM Order WHERE status = :status')\n    countByStatus(status: string): Promise\u003CStatusCount[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n}\n","typescript","",[243,304,305,338,345,368,373,397,436,443,449,454,472,512,517,522,527,545,574,579,584],{"__ignoreMap":302},[306,307,310,314,318,322,325,328,331,335],"span",{"class":308,"line":309},"line",1,[306,311,313],{"class":312},"s7zQu","import",[306,315,317],{"class":316},"sMK4o"," {",[306,319,321],{"class":320},"sTEyZ"," Query",[306,323,324],{"class":316}," }",[306,326,327],{"class":312}," from",[306,329,330],{"class":316}," '",[306,332,334],{"class":333},"sfazB","@kinotic-ai\u002Fpersistence",[306,336,337],{"class":316},"'\n",[306,339,341],{"class":308,"line":340},2,[306,342,344],{"emptyLinePlaceholder":343},true,"\n",[306,346,348,351,355,359,362,365],{"class":308,"line":347},3,[306,349,350],{"class":312},"export",[306,352,354],{"class":353},"spNyl"," class",[306,356,358],{"class":357},"sBMFI"," OrderRepository",[306,360,361],{"class":353}," extends",[306,363,364],{"class":357}," BaseOrderRepository",[306,366,367],{"class":316}," {\n",[306,369,371],{"class":308,"line":370},4,[306,372,344],{"emptyLinePlaceholder":343},[306,374,376,379,383,386,389,392,394],{"class":308,"line":375},5,[306,377,378],{"class":316},"    @",[306,380,382],{"class":381},"s2Zo4","Query",[306,384,385],{"class":320},"(",[306,387,388],{"class":316},"'",[306,390,391],{"class":333},"SELECT * FROM Order WHERE status = :status ORDER BY placedAt DESC LIMIT 100",[306,393,388],{"class":316},[306,395,396],{"class":320},")\n",[306,398,400,404,406,410,413,416,419,422,425,428,431,434],{"class":308,"line":399},6,[306,401,403],{"class":402},"swJcz","    findByStatus",[306,405,385],{"class":316},[306,407,409],{"class":408},"sHdIc","status",[306,411,412],{"class":316},":",[306,414,415],{"class":357}," string",[306,417,418],{"class":316},"):",[306,420,421],{"class":357}," Promise",[306,423,424],{"class":316},"\u003C",[306,426,427],{"class":357},"Order",[306,429,430],{"class":320},"[]",[306,432,433],{"class":316},">",[306,435,367],{"class":316},[306,437,439],{"class":308,"line":438},7,[306,440,442],{"class":441},"sHwdD","        \u002F\u002F Implementation is generated by the CLI\n",[306,444,446],{"class":308,"line":445},8,[306,447,448],{"class":316},"    }\n",[306,450,452],{"class":308,"line":451},9,[306,453,344],{"emptyLinePlaceholder":343},[306,455,457,459,461,463,465,468,470],{"class":308,"line":456},10,[306,458,378],{"class":316},[306,460,382],{"class":381},[306,462,385],{"class":320},[306,464,388],{"class":316},[306,466,467],{"class":333},"UPDATE Order SET status = :status WHERE id = :id WITH REFRESH",[306,469,388],{"class":316},[306,471,396],{"class":320},[306,473,475,478,480,483,485,487,490,493,495,497,499,501,503,506,508,510],{"class":308,"line":474},11,[306,476,477],{"class":402},"    updateStatus",[306,479,385],{"class":316},[306,481,482],{"class":408},"id",[306,484,412],{"class":316},[306,486,415],{"class":357},[306,488,489],{"class":316},",",[306,491,492],{"class":408}," status",[306,494,412],{"class":316},[306,496,415],{"class":357},[306,498,418],{"class":316},[306,500,421],{"class":357},[306,502,424],{"class":316},[306,504,505],{"class":357},"WriteCount",[306,507,430],{"class":320},[306,509,433],{"class":316},[306,511,367],{"class":316},[306,513,515],{"class":308,"line":514},12,[306,516,442],{"class":441},[306,518,520],{"class":308,"line":519},13,[306,521,448],{"class":316},[306,523,525],{"class":308,"line":524},14,[306,526,344],{"emptyLinePlaceholder":343},[306,528,530,532,534,536,538,541,543],{"class":308,"line":529},15,[306,531,378],{"class":316},[306,533,382],{"class":381},[306,535,385],{"class":320},[306,537,388],{"class":316},[306,539,540],{"class":333},"SELECT COUNT(*) AS count FROM Order WHERE status = :status",[306,542,388],{"class":316},[306,544,396],{"class":320},[306,546,548,551,553,555,557,559,561,563,565,568,570,572],{"class":308,"line":547},16,[306,549,550],{"class":402},"    countByStatus",[306,552,385],{"class":316},[306,554,409],{"class":408},[306,556,412],{"class":316},[306,558,415],{"class":357},[306,560,418],{"class":316},[306,562,421],{"class":357},[306,564,424],{"class":316},[306,566,567],{"class":357},"StatusCount",[306,569,430],{"class":320},[306,571,433],{"class":316},[306,573,367],{"class":316},[306,575,577],{"class":308,"line":576},17,[306,578,442],{"class":441},[306,580,582],{"class":308,"line":581},18,[306,583,448],{"class":316},[306,585,587],{"class":308,"line":586},19,[306,588,589],{"class":316},"}\n",[239,591,592,593,595],{},"The method body is left empty because ",[243,594,276],{}," fills in the implementation.",[239,597,598],{},"Named queries must be synced to the server before they can be used. If a query has not been synced, calling it will fail at runtime.",[251,600,602],{"id":601},"statements","Statements",[239,604,605,606,609,610,609,613,616,617,620,621,625,626,616,629,632,633,616,636,639,640,644],{},"A named query is one statement. ",[243,607,608],{},"SELECT",", ",[243,611,612],{},"INSERT",[243,614,615],{},"UPDATE"," and ",[243,618,619],{},"DELETE"," are statements of the ",[622,623,624],"a",{"href":140},"Kinotic SQL grammar",", the one migrations use, written without the terminating semicolon. Keywords match in any case, but entity and field names are case-sensitive and must be written the way the entity class spells them: ",[243,627,628],{},"Person",[243,630,631],{},"lastName",", not ",[243,634,635],{},"person",[243,637,638],{},"LASTNAME",". A field name in the wrong case is not an error: the query gets nothing back, no rows read and none written. See ",[622,641,643],{"href":642},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#case","Case",".",[646,647,608],"h3",{"id":648},"select",[239,650,651,652,655,656,659,660,663],{},"Returns the rows of the entity that match the ",[243,653,654],{},"WHERE"," clause, shaped the way the entity class shapes them: nested objects and lists come back whole, since the rows are read from the stored documents. ",[243,657,658],{},"SELECT *"," returns whole rows; ",[243,661,662],{},"SELECT firstName, address"," returns the listed top-level fields only, each whole.",[665,666,667,677,684],"ul",{},[259,668,669,672,673,676],{},[243,670,671],{},"ORDER BY"," orders the rows. A sort the caller gives on a ",[243,674,675],{},"Pageable"," follows it.",[259,678,679,680,683],{},"A method that returns an array gets every matching row up to ",[243,681,682],{},"LIMIT",", or 1000 rows when the statement names no limit.",[259,685,686,687,690,691,694,695,697,698,700,701,644],{},"A method with a ",[243,688,689],{},"pageable: Pageable"," parameter returns a ",[243,692,693],{},"Page",", and the ",[243,696,675],{}," sets the page size. Cursor paging orders by the statement's ",[243,699,671],{},", so give it one that orders the rows fully, such as ",[243,702,703],{},"ORDER BY lastName, id",[646,705,707],{"id":706},"insert-update-and-delete","INSERT, UPDATE and DELETE",[239,709,710,711,714,715,718],{},"A write returns one row, ",[243,712,713],{},"{ count }",", holding the number of rows it wrote. Add ",[243,716,717],{},"WITH REFRESH"," when the next read must see the write.",[665,720,721,737],{},[259,722,723,725,726,729,730,616,733,736],{},[243,724,612],{}," stores the row the way the repository's ",[243,727,728],{},"save"," would: the row states the entity's id field, and the platform stores it under the participant's tenant, so the row is found by id afterwards. ",[243,731,732],{},"ROUTING",[243,734,735],{},"DOCUMENT_ID"," are not accepted, since both are derived.",[259,738,739,616,741,743,744,746],{},[243,740,615],{},[243,742,619],{}," act on the rows that match the ",[243,745,654],{}," clause.",[646,748,750],{"id":749},"aggregates","Aggregates",[239,752,753,754,756,757,609,760,609,763,609,766,609,769,609,772,609,775,778,779,782,783,789,790,793,794,797,798,800,801,804,805,808,809,812,813,644],{},"A ",[243,755,608],{}," that calls a function (",[243,758,759],{},"COUNT(*)",[243,761,762],{},"SUM",[243,764,765],{},"AVG",[243,767,768],{},"MIN",[243,770,771],{},"MAX",[243,773,774],{},"PERCENTILE",[243,776,777],{},"HISTOGRAM",", …) or has a ",[243,780,781],{},"GROUP BY"," is an aggregate. It runs on Elasticsearch SQL, so it can call any of ",[622,784,788],{"href":785,"rel":786},"https:\u002F\u002Fwww.elastic.co\u002Fdocs\u002Freference\u002Fquery-languages\u002Fsql\u002Fsql-functions",[787],"nofollow","its functions",", and returns one row per group, shaped by the projection: ",[243,791,792],{},"AS"," names a column, and a column or group can be a sub-field (",[243,795,796],{},"address.city","). It is written in the same grammar as every other statement, with the same ",[243,799,654],{}," clause and ",[243,802,803],{},":name"," parameters, and names the query's own entity in ",[243,806,807],{},"FROM","; see ",[622,810,608],{"href":811},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#select",". A paged aggregate takes a cursor ",[243,814,675],{},[251,816,818],{"id":817},"multi-tenancy","Multi-tenancy",[239,820,821,822,824,825,827,828,830,831,833,834,836,837,839],{},"Every named query is confined to the participant's tenant, the way every repository method is: a ",[243,823,608],{}," or aggregate reads only the rows of that tenant, an ",[243,826,612],{}," stores its row under it, and an ",[243,829,615],{}," or ",[243,832,619],{}," touches only its rows, whatever the ",[243,835,654],{}," clause says. An ",[243,838,612],{}," may state the entity's tenant field with the participant's own tenant; any other value is refused.",[251,841,843],{"id":842},"admin-repository-queries","Admin Repository Queries",[239,845,846,847,851,852,855],{},"A named query on an ",[622,848,850],{"href":849},"\u002Fapps\u002Fpersistence\u002Fmulti-tenancy#admin-repository","admin repository"," runs against the tenants the caller selects, so it declares a ",[243,853,854],{},"TenantSelection"," parameter like every other admin repository method. The generated implementation sends it as the query's tenant selection rather than as a query parameter. A read runs against every tenant the selection names; a write acts on one tenant, so its selection names exactly one.",[297,857,859],{"className":299,"code":858,"language":301,"meta":302,"style":302},"import { Query, type TenantSelection } from '@kinotic-ai\u002Fpersistence'\n\nexport class OrderAdminRepository extends BaseOrderAdminRepository {\n\n    @Query('SELECT COUNT(*) AS count FROM Order WHERE status = :status')\n    countByStatus(status: string, tenantSelection: TenantSelection): Promise\u003CStatusCount[]> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n}\n\nconst openOrders = await new OrderAdminRepository().countByStatus('OPEN', ['tenant-123', 'tenant-456'])\n",[243,860,861,887,891,907,911,927,962,966,970,974,978],{"__ignoreMap":302},[306,862,863,865,867,869,871,874,877,879,881,883,885],{"class":308,"line":309},[306,864,313],{"class":312},[306,866,317],{"class":316},[306,868,321],{"class":320},[306,870,489],{"class":316},[306,872,873],{"class":312}," type",[306,875,876],{"class":320}," TenantSelection",[306,878,324],{"class":316},[306,880,327],{"class":312},[306,882,330],{"class":316},[306,884,334],{"class":333},[306,886,337],{"class":316},[306,888,889],{"class":308,"line":340},[306,890,344],{"emptyLinePlaceholder":343},[306,892,893,895,897,900,9