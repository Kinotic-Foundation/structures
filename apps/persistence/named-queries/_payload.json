eclare methods with the ",[228,229,230],"code",{},"@Query"," decorator using a SQL-like syntax, sync them with the server, and the CLI generates the implementation.",[224,233,234,235,239],{},"Currently named queries support ",[236,237,238],"strong",{},"aggregate queries"," (COUNT, SUM, AVG, MIN, MAX, etc.). Support for SELECT, UPDATE, and DELETE queries is coming soon.",[241,242,244],"h2",{"id":243},"workflow","Workflow",[246,247,248,256,262],"ol",{},[249,250,251,252,255],"li",{},"Run ",[228,253,254],{},"kinotic sync"," to sync your entities and generate the base repository classes",[249,257,258,259,261],{},"Add custom methods with the ",[228,260,230],{}," decorator to the generated repository class",[249,263,251,264,267,268,271],{},[228,265,266],{},"kinotic generate"," to regenerate the repository with your query implementations (",[228,269,270],{},"generate"," runs locally without syncing to the server)",[241,273,275],{"id":274},"defining-named-queries","Defining Named Queries",[224,277,278,279,281,282,285],{},"Add methods with the ",[228,280,230],{}," decorator to your repository class. Use ",[228,283,284],{},":paramName"," syntax for parameter binding.",[287,288,293],"pre",{"className":289,"code":290,"language":291,"meta":292,"style":292},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Query } from '@kinotic-ai\u002Fpersistence'\n\nexport class OrderRepository extends BaseOrderRepository {\n\n    @Query('SELECT COUNT(*) FROM Order WHERE status = :status')\n    countByStatus(status: string): Promise\u003Cnumber> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n\n    @Query('SELECT SUM(amount) FROM Order WHERE customerId = :customerId')\n    totalSpentByCustomer(customerId: string): Promise\u003Cnumber> {\n        \u002F\u002F Implementation is generated by the CLI\n    }\n}\n","typescript","",[228,294,295,328,335,358,363,387,423,430,436,441,459,486,491,496],{"__ignoreMap":292}