02Fdefense-in-depth","02.platform\u002F06.defense-in-depth",{"title":176,"path":177,"stem":178,"icon":179},"MCP Tools","\u002Fplatform\u002Fmcp-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":181,"path":182,"stem":183,"icon":184},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":186,"path":187,"stem":188,"icon":189},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":191,"path":192,"stem":193,"icon":194},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":196,"path":197,"stem":198,"icon":199},"Service Call Liveness","\u002Fplatform\u002Fservice-call-liveness","02.platform\u002F11.service-call-liveness","i-lucide-heart-pulse",{"title":128,"icon":129,"path":201,"stem":202,"children":203,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F12.reference",[204,209,214],{"title":205,"path":206,"stem":207,"icon":208},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":210,"path":211,"stem":212,"icon":213},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","02.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":215,"path":216,"stem":217,"icon":151},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","02.platform\u002F12.reference\u002F03.project-publishing-design",{"id":219,"title":88,"body":220,"description":776,"extension":777,"links":778,"meta":779,"navigation":780,"path":89,"seo":781,"stem":90,"__hash__":782},"docs\u002F01.apps\u002F05.persistence\u002F07.migrations.md",{"type":221,"value":222,"toc":759},"minimark",[223,232,237,240,250,253,272,279,283,300,303,307,328,332,337,340,348,352,355,364,368,371,380,384,387,402,406,409,416,443,449,472,482,523,530,538,542,545,554,558,561,570,573,603,623,627,630,639,642,657,664,684,688,691,700,704,750,755],[224,225,226,227,231],"p",{},"Migrations let you evolve your data schema in a controlled, versioned way. They are written in a SQL-like syntax and executed automatically during ",[228,229,230],"code",{},"kinotic sync",".",[233,234,236],"h2",{"id":235},"file-naming","File Naming",[224,238,239],{},"Migration files follow a strict naming convention:",[241,242,247],"pre",{"className":243,"code":245,"language":246},[244],"language-text","V\u003Cnumber>__\u003Cdescription>.sql\n","text",[228,248,245],{"__ignoreMap":249},"",[224,251,252],{},"Examples:",[254,255,256,262,267],"ul",{},[257,258,259],"li",{},[228,260,261],{},"V1__initial_schema.sql",[257,263,264],{},[228,265,266],{},"V2__add_email_field.sql",[257,268,269],{},[228,270,271],{},"V3__create_sensor_readings.sql",[224,273,274,275,278],{},"The version number determines execution order. The double underscore (",[228,276,277],{},"__",") separates the version from the description.",[233,280,282],{"id":281},"how-it-works","How It Works",[284,285,286,289,292,295],"ol",{},[257,287,288],{},"Migration files are discovered and sorted by version number",[257,290,291],{},"Only unapplied migrations are parsed and executed",[257,293,294],{},"Each migration is recorded after successful execution to prevent re-runs",[257,296,297,298],{},"Migrations run during ",[228,299,230],{},[224,301,302],{},"A migration file containing a syntax error fails the entire migration run — nothing from that file is applied and the file is not recorded. The error names the file, line, and offending token.",[233,304,306],{"id":305},"example-migration","Example Migration",[241,308,312],{"className":309,"code":310,"language":311,"meta":249,"style":249},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","-- V1__initial_schema.sql\nCREATE TABLE users (name TEXT, age INTEGER, active BOOLEAN);\n","sql",[228,313,314,322],{"__ignoreMap":249},[315,316,319],"span",{"class":317,"line":318},"line",1,[315,320,321],{},"-- V1__initial_schema.sql\n",[315,323,325],{"class":317,"line":324},2,[315,326,327],{},"CREATE TABLE users (name TEXT, age INTEGER, active BOOLEAN);\n",[233,329,331],{"id":330},"supported-statements","Supported Statements",[333,334,336],"h3",{"id":335},"create-table","CREATE TABLE",[224,338,339],{},"Create a new table with field mappings.",[241,341,342],{"className":309,"code":327,"language":311,"meta":249,"style":249},[228,343,344],{"__ignoreMap":249},[315,345,346],{"class":317,"line":318},[315,347,327],{},[333,349,351],{"id":350},"create-component-template","CREATE COMPONENT TEMPLATE",[224,353,354],{},"Define reusable templates with settings that can be applied to multiple tables.",[241,356,358],{"className":309,"code":357,"language":311,"meta":249,"style":249},"CREATE COMPONENT TEMPLATE my_settings (NUMBER_OF_SHARDS = 1, NUMBER_OF_REPLICAS = 0);\n",[228,359,360],{"__ignoreMap":249},[315,361,362],{"class":317,"line":318},[315,363,357],{},[333,365,367],{"id":366},"create-index-template","CREATE INDEX TEMPLATE",[224,369,370],{},"Create templates that automatically apply to tables matching a name pattern.",[241,372,374],{"className":309,"code":373,"language":311,"meta":249,"style":249},"CREATE INDEX TEMPLATE my_template FOR 'logs-*' USING 'my_settings';\n",[228,375,376],{"__ignoreMap":249},[315,377,378],{"class":317,"line":318},[315,379,373],{},[333,381,383],{"id":382},"alter-table-add-column","ALTER TABLE ADD COLUMN",[224,385,386],{},"Add new fields to an existing table. Composite types are supported — you can add an OBJECT, NESTED, or UNION column just like any other type.",[241,388,390],{"className":309,"code":389,"language":311,"meta":249,"style":249},"ALTER TABLE users ADD COLUMN email TEXT;\nALTER TABLE users ADD COLUMN address OBJECT (street TEXT, city KEYWORD, zip KEYWORD);\n",[228,391,392,397],{"__ignoreMap":249},[315,393,394],{"class":317,"line":318},[315,395,396],{},"ALTER TABLE users ADD COLUMN email TEXT;\n",[315,398,399],{"class":317,"line":324},[315,400,401],{},"ALTER TABLE users ADD COLUMN address OBJECT (street TEXT, city KEYWORD, zip KEYWORD);\n",[333,403,405],{"id":404},"composite-column-types","Composite Column Types",[224,407,408],{},"In addition to scalar types, columns can be structured objects.",[224,410,411,415],{},[412,413,414],"strong",{},"OBJECT"," — a single embedded sub-document:",[241,417,419],{"className":309,"code":418,"language":311,"meta":249,"style":249},"CREATE TABLE persons (\n    id KEYWORD,\n    address OBJECT (street TEXT, city KEYWORD, state KEYWORD, zip KEYWORD)\n);\n",[228,420,421,426,431,437],{"__ignoreMap":249},[315,422,423],{"class":317,"line":318},[315,424,425],{},"CREATE TABLE persons (\n",[315,427,428],{"class":317,"line":324},[315,429,430],{},"    id KEYWORD,\n",[315,432,434],{"class":317,"line":433},3,[315,435,436],{},"    address OBJECT (street TEXT, city KEYWORD, state KEYWORD, zip KEYWORD)\n",[315,438,440],{"class":317,"line":439},4,[315,441,442],{},");\n",[224,444,445,448],{},[412,446,447],{},"NESTED"," — an array of independently-queryable sub-documents. Use this when a field holds a list of items and you need to filter on individual list entries without cross-element matching:",[241,450,452],{"className":309,"code":451,"language":311,"meta":249,"style":249},"CREATE TABLE articles (\n    id KEYWORD,\n    tags NESTED (label TEXT, value KEYWORD)\n);\n",[228,453,454,459,463,468],{"__ignoreMap":249},[315,455,456],{"class":317,"line":318},[315,457,458],{},"CREATE TABLE articles (\n",[315,460,461],{"class":317,"line":324},[315,462,430],{},[315,464,465],{"class":317,"line":433},[315,466,467],{},"    tags NESTED (label TEXT, value KEYWORD)\n",[315,469,470],{"class":317,"line":439},[315,471,442],{},[224,473,474,477,478,481],{},[412,475,476],{},"UNION"," — a field that can hold one of several named object variants. All variant fields are merged into a single object. Include a shared field (e.g. ",[228,479,480],{},"kind KEYWORD",") in each variant so your application can identify which variant it received at runtime:",[241,483,485],{"className":309,"code":484,"language":311,"meta":249,"style":249},"CREATE TABLE assets (\n    id KEYWORD,\n    item UNION (\n        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n        Video (kind KEYWORD, title TEXT, duration INTEGER)\n    )\n);\n",[228,486,487,492,496,501,506,512,518],{"__ignoreMap":249},[315,488,489],{"class":317,"line":318},[315,490,491],{},"CREATE TABLE assets (\n",[315,493,494],{"class":317,"line":324},[315,495,430],{},[315,497,498],{"class":317,"line":433},[315,499,500],{},"    item UNION (\n",[315,502,503],{"class":317,"line":439},[315,504,505],{},"        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n",[315,507,509],{"class":317,"line":508},5,[315,510,511],{},"        Video (kind KEYWORD, title TEXT, duration INTEGER)\n",[315,513,515],{"class":317,"line":514},6,[315,516,517],{},"    )\n",[315,519,521],{"class":317,"line":520},7,[315,522,442],{},[224,524,525,526,529],{},"All composite types support ",[228,527,528],{},"NOT INDEXED"," (except NESTED) to store data without making it searchable. They also support recursive nesting — an OBJECT inside a NESTED, for example, is valid.",[224,531,532,533,231],{},"For the complete syntax and options, see the ",[534,535,537],"a",{"href":536},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#composite-types","Migration SQL Grammar Reference",[333,539,541],{"id":540},"reindex","REINDEX",[224,543,544],{},"Migrate data between tables with advanced options.",[241,546,548],{"className":309,"code":547,"language":311,"meta":249,"style":249},"REINDEX old_index INTO new_index WITH (SKIP_IF_NO_SOURCE = TRUE);\n",[228,549,550],{"__ignoreMap":249},[315,551,552],{"class":317,"line":318},[315,553,547],{},[333,555,557],{"id":556},"insert-into","INSERT INTO",[224,559,560],{},"Add records to a table.",[241,562,564],{"className":309,"code":563,"language":311,"meta":249,"style":249},"INSERT INTO users (name, age, active) VALUES ('Jane', 28, true) WITH REFRESH;\n",[228,565,566],{"__ignoreMap":249},[315,567,568],{"class":317,"line":318},[315,569,563],{},[224,571,572],{},"Composite columns take an object literal, and a NESTED column an array of them:",[241,574,576],{"className":309,"code":575,"language":311,"meta":249,"style":249},"INSERT INTO persons (id, address, tags) VALUES (\n    'p-1',\n    { street: '1 Main St', city: 'Springfield', zip: '11111' },\n    [ { label: 'Role', value: 'admin' }, { label: 'Team', value: 'platform' } ]\n) WITH REFRESH;\n",[228,577,578,583,588,593,598],{"__ignoreMap":249},[315,579,580],{"class":317,"line":318},[315,581,582],{},"INSERT INTO persons (id, address, tags) VALUES (\n",[315,584,585],{"class":317,"line":324},[315,586,587],{},"    'p-1',\n",[315,589,590],{"class":317,"line":433},[315,591,592],{},"    { street: '1 Main St', city: 'Springfield', zip: '11111' },\n",[315,594,595],{"class":317,"line":439},[315,596,597],{},"    [ { label: 'Role', value: 'admin' }, { label: 'Team', value: 'platform' } ]\n",[315,599,600],{"class":317,"line":508},[315,601,602],{},") WITH REFRESH;\n",[604,605,607,608,611,612,614,615,617,618,622],"callout",{"type":606},"warning","If your table has a logical ",[228,609,610],{},"id"," field, always include the ",[228,613,610],{}," column in the INSERT. The value becomes the document's storage identifier, which is how find-by-id lookups resolve the document. An INSERT that omits ",[228,616,610],{}," stores the row with a random identifier and it can only be located via search — not via a direct id lookup. See the ",[534,619,621],{"href":620},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#the-id-column","Migration SQL Grammar reference"," for details.",[333,624,626],{"id":625},"update-set-where","UPDATE ... SET ... WHERE",[224,628,629],{},"Modify existing records.",[241,631,633],{"className":309,"code":632,"language":311,"meta":249,"style":249},"UPDATE users SET active = false WHERE age \u003C 18 WITH REFRESH;\n",[228,634,635],{"__ignoreMap":249},[315,636,637],{"class":317,"line":318},[315,638,632],{},[224,640,641],{},"A composite column is set from the same literals INSERT uses. An object literal merges into the\nstored object — recursively, and leaving sub-fields it does not mention alone — so you can change\none sub-field by naming only that one. Arrays and scalars are replaced outright:",[241,643,645],{"className":309,"code":644,"language":311,"meta":249,"style":249},"-- street keeps its stored value; only city changes\nUPDATE persons SET address = { city: 'Shelbyville' } WHERE id == 'p-1' WITH REFRESH;\n",[228,646,647,652],{"__ignoreMap":249},[315,648,649],{"class":317,"line":318},[315,650,651],{},"-- street keeps its stored value; only city changes\n",[315,653,654],{"class":317,"line":324},[315,655,656],{},"UPDATE persons SET address = { city: 'Shelbyville' } WHERE id == 'p-1' WITH REFRESH;\n",[224,658,659,660,663],{},"Since omitting a sub-field keeps it, ",[228,661,662],{},"null"," is what clears one. The literal's nesting addresses the\nfield, so any depth is reachable:",[241,665,667],{"className":309,"code":666,"language":311,"meta":249,"style":249},"UPDATE persons SET address = { street: null } WHERE id == 'p-1' WITH REFRESH;          -- address.street\nUPDATE persons SET address = { coords: { lat: null } } WHERE id == 'p-1' WITH REFRESH; -- address.coords.lat\nUPDATE persons SET nickname = null WHERE id == 'p-1' WITH REFRESH;                     -- the whole column\n",[228,668,669,674,679],{"__ignoreMap":249},[315,670,671],{"class":317,"line":318},[315,672,673],{},"UPDATE persons SET address = { street: null } WHERE id == 'p-1' WITH REFRESH;          -- address.street\n",[315,675,676],{"class":317,"line":324},[315,677,678],{},"UPDATE persons SET address = { coords: { lat: null } } WHERE id == 'p-1' WITH REFRESH; -- address.coords.lat\n",[315,680,681],{"class":317,"line":433},[315,682,683],{},"UPDATE persons SET nickname = null WHERE id == 'p-1' WITH REFRESH;                     -- the whole column\n",[333,685,687],{"id":686},"delete-from-where","DELETE FROM ... WHERE",[224,689,690],{},"Remove records matching a condition.",[241,692,694],{"className":309,"code":693,"language":311,"meta":249,"style":249},"DELETE FROM users WHERE active == false WITH REFRESH;\n",[228,695,696],{"__ignoreMap":249},[315,697,698],{"class":317,"line":318},[315,699,693],{},[233,701,703],{"id":702},"best-practices","Best Practices",[254,705,706,712,722,730,738,744],{},[257,707,708,711],{},[412,709,710],{},"Increment version numbers sequentially"," - Gaps are allowed but order must be maintained",[257,713,714,721],{},[412,715,716,717,720],{},"Use ",[228,718,719],{},"IF NOT EXISTS"," where available"," - Makes migrations safe to re-run if the tracking state is reset",[257,723,724,729],{},[412,725,716,726],{},[228,727,728],{},"WITH REFRESH"," on INSERT, UPDATE, and DELETE when subsequent migrations depend on the changed data being immediately visible",[257,731,732,737],{},[412,733,716,734],{},[228,735,736],{},"SKIP_IF_NO_SOURCE = TRUE"," on REINDEX operations for idempotent data migrations",[257,739,740,743],{},[412,741,742],{},"Keep migrations small and focused"," - One logical change per migration file",[257,745,746,749],{},[412,747,748],{},"Never modify a migration after it has been applied"," - Create a new migration instead",[224,751,752,753,231],{},"For the complete SQL grammar reference, see the ",[534,754,537],{"href":140},[756,757,758],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--