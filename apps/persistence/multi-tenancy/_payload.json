terprise License","\u002Fplatform\u002Fenterprise-license","02.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":234,"title":84,"body":235,"description":1075,"extension":1076,"links":1077,"meta":1078,"navigation":322,"path":85,"seo":1079,"stem":86,"__hash__":1080},"docs\u002F01.apps\u002F05.persistence\u002F06.multi-tenancy.md",{"type":236,"value":237,"toc":1061},"minimark",[238,242,247,259,460,466,470,485,571,585,593,597,638,643,647,653,657,664,749,752,756,774,795,800,859,863,918,922,985,989,992,1036,1040,1054,1057],[239,240,241],"p",{},"Kinotic supports multi-tenant data isolation at the persistence layer. Data from different tenants is stored together but automatically filtered so each tenant only sees their own data.",[243,244,246],"h2",{"id":245},"defining-a-multi-tenant-entity","Defining a Multi-Tenant Entity",[239,248,249,250,254,255,258],{},"Add ",[251,252,253],"code",{},"@TenantId"," to a field and set the entity to ",[251,256,257],{},"MultiTenancyType.SHARED",".",[260,261,266],"pre",{"className":262,"code":263,"language":264,"meta":265,"style":265},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Entity, AutoGeneratedId, TenantId, MultiTenancyType } from '@kinotic-ai\u002Fpersistence'\n\n@Entity(MultiTenancyType.SHARED)\nexport class Person {\n    @AutoGeneratedId\n    id: string | null = null\n\n    @TenantId\n    tenantId: string = ''\n\n    firstName: string = ''\n    lastName: string = ''\n}\n","typescript","",[251,267,268,317,324,342,359,368,393,398,406,421,426,440,454],{"__ignoreMap":265},[269,270,273,277,281,285,288,291,293,296,298,301,304,307,310,314],"span",{"class":271,"line":272},"line",1,[269,274,276],{"class":275},"s7zQu","import",[269,278,280],{"class":279},"sMK4o"," {",[269,282,284],{"class":283},"sTEyZ"," Entity",[269,286,287],{"class":279},",",[269,289,290],{"class":283}," AutoGeneratedId",[269,292,287],{"class":279},[269,294,295],{"class":283}," TenantId",[269,297,287],{"class":279},[269,299,300],{"class":283}," MultiTenancyType",[269,302,303],{"class":279}," }",[269,305,306],{"class":275}," from",[269,308,309],{"class":279}," '",[269,311,313],{"class":312},"sfazB","@kinotic-ai\u002Fpersistence",[269,315,316],{"class":279},"'\n",[269,318,320],{"class":271,"line":319},2,[269,321,323],{"emptyLinePlaceholder":322},true,"\n",[269,325,327,330,334,337,339],{"class":271,"line":326},3,[269,328,329],{"class":279},"@",[269,331,333],{"class":332},"s2Zo4","Entity",[269,335,336],{"class":283},"(MultiTenancyType",[269,338,258],{"class":279},[269,340,341],{"class":283},"SHARED)\n",[269,343,345,348,352,356],{"class":271,"line":344},4,[269,346,347],{"class":275},"export",[269,349,351],{"class":350},"spNyl"," class",[269,353,355],{"class":354},"sBMFI"," Person",[269,357,358],{"class":279}," {\n",[269,360,362,365],{"class":271,"line":361},5,[269,363,364],{"class":279},"    @",[269,366,367],{"class":283},"AutoGeneratedId\n",[269,369,371,375,378,381,384,387,390],{"class":271,"line":370},6,[269,372,374],{"class":373},"swJcz","    id",[269,376,377],{"class":279},":",[269,379,380],{"class":354}," string",[269,382,383],{"class":279}," |",[269,385,386],{"class":354}," null",[269,388,389],{"class":279}," =",[269,391,392],{"class":279}," null\n",[269,394,396],{"class":271,"line":395},7,[269,397,323],{"emptyLinePlaceholder":322},[269,399,401,403],{"class":271,"line":400},8,[269,402,364],{"class":279},[269,404,405],{"class":283},"TenantId\n",[269,407,409,412,414,416,418],{"class":271,"line":408},9,[269,410,411],{"class":373},"    tenantId",[269,413,377],{"class":279},[269,415,380],{"class":354},[269,417,389],{"class":279},[269,419,420],{"class":279}," ''\n",[269,422,424],{"class":271,"line":423},10,[269,425,323],{"emptyLinePlaceholder":322},[269,427,429,432,434,436,438],{"class":271,"line":428},11,[269,430,431],{"class":373},"    firstName",[269,433,377],{"class":279},[269,435,380],{"class":354},[269,437,389],{"class":279},[269,439,420],{"class":279},[269,441,443,446,448,450,452],{"class":271,"line":442},12,[269,444,445],{"class":373},"    lastName",[269,447,377],{"class":279},[269,449,380],{"class":354},[269,451,389],{"class":279},[269,453,420],{"class":279},[269,455,457],{"class":271,"line":456},13,[269,458,459],{"class":279},"}\n",[239,461,462,463,465],{},"The ",[251,464,253],{}," field is populated automatically based on the authenticated user's tenant context. You do not need to set it manually when saving entities.",[243,467,469],{"id":468},"where-a-users-tenant-comes-from","Where a user's tenant comes from",[239,471,472,473,476,477,480,481,484],{},"Declaring the entity is only half of it. A user's tenant is assigned when the user is created, and who assigns it is the application's ",[251,474,475],{},"tenantManagement"," setting: ",[251,478,479],{},"PLATFORM"," gives every user a tenant of their own at creation, ",[251,482,483],{},"TENANT_ADMINISTRATORS"," leaves tenants to the people who create them — a customer signing up, or the organization in the portal — whose administrators decide who joins.",[486,487,488,505],"table",{},[489,490,491],"thead",{},[492,493,494,500,502],"tr",{},[495,496,497,498],"th",{},"Application ",[251,499,475],{},[495,501,333],{},[495,503,504],{},"Result",[506,507,508,523,536,556],"tbody",{},[492,509,510,515,520],{},[511,512,513],"td",{},[251,514,483],{},[511,516,517],{},[251,518,519],{},"MultiTenancyType.NONE",[511,521,522],{},"One shared dataset — every user sees every other user's rows",[492,524,525,529,533],{},[511,526,527],{},[251,528,479],{},[511,530,531],{},[251,532,519],{},[511,534,535],{},"Still one shared dataset; the setting has nothing to act on",[492,537,538,542,550],{},[511,539,540],{},[251,541,483],{},[511,543,544,547,548],{},[251,545,546],{},"SHARED"," + ",[251,549,253],{},[511,551,552,553],{},"A user created into no tenant has none, and its writes fail with ",[251,554,555],{},"tenantId cannot be null or blank for shared multi tenancy",[492,557,558,562,568],{},[511,559,560],{},[251,561,479],{},[511,563,564,547,566],{},[251,565,546],{},[251,567,253],{},[511,569,570],{},"Each user isolated in their own tenant",[239,572,573,574,577,578,580,581,258],{},"Choose it when the application is created — ",[251,575,576],{},"createApplicationIfNotExist"," takes it as an argument, defaulting to ",[251,579,483],{}," — and change it afterwards only from the portal, under ",[582,583,584],"strong",{},"Application → Settings → Tenants",[239,586,587,589,590,592],{},[251,588,479],{}," applies to users created while it is in force. Existing users are never backfilled, so choosing it for an application that already has users leaves those users without a tenant, and every write they make to a ",[251,591,546],{}," entity fails. Settle it before the application has users.",[243,594,596],{"id":595},"tenants-and-their-sites","Tenants and their sites",[239,598,599,600,602,603,606,607,610,611,614,615,618,619,622,623,626,627,631,632,634,635,637],{},"Under ",[251,601,483],{}," a tenant is a ",[251,604,605],{},"Tenant"," of the application, created by your organization in the portal or through ",[251,608,609],{},"TenantService"," (",[251,612,613],{},"createTenantIfNotExist(applicationId, name, description)","), whose id is its slugified name: lowercase letters, digits and single dashes, at most 24 characters so it leads a hostname label, and unique within your organization, so a name whose slug a tenant of another of your applications already holds is refused. The tenant's users carry that id as their ",[251,616,617],{},"tenantId",". Each of the application's published UIs is also served for the tenant at ",[251,620,621],{},"\u003CtenantId>--\u003CapplicationId>--\u003CuiName>"," under your organization's subdomain of the sites domain, and a sign-in from that site is to the tenant: it admits the tenant's users only, and offers the tenant's own identity providers (",[251,624,625],{},"TenantOidcConfiguration",") before the application's — see ",[628,629,98],"a",{"href":630},"\u002Fapps\u002Fsecurity\u002Fauthentication#signing-in-to-a-tenant",". A tenant whose users were created with a ",[251,633,617],{}," no ",[251,636,605],{}," row names has no login of its own until the row is created.",[239,639,599,640,642],{},[251,641,479],{}," tenants are minted per user and have no rows or sites; the user signs in at the application's own sites.",[243,644,646],{"id":645},"tenants-and-services","Tenants and services",[239,648,649,650,652],{},"A tenant comes from the authenticated participant, and only an application-scope participant carries one. A microservice running in a project's deployment connects at organization scope, so it cannot read or write a ",[251,651,546],{}," entity through the tenant-scoped repository — it uses the admin repository below, naming the tenants it means to act on. Per-user writes driven by the user belong on a client connected as that user.",[243,654,656],{"id":655},"tenant-isolated-repository","Tenant-Isolated Repository",[239,658,659,660,663],{},"The standard generated ",[251,661,662],{},"Repository"," automatically filters all operations to the current tenant. No additional configuration is needed.",[260,665,667],{"className":262,"code":666,"language":264,"meta":265,"style":265},"const service = new PersonRepository()\n\n\u002F\u002F Only returns people belonging to the current tenant\nconst people = await service.findAll({ page: 0, size: 10 })\n",[251,668,669,689,693,699],{"__ignoreMap":265},[269,670,671,674,677,680,683,686],{"class":271,"line":272},[269,672,673],{"class":350},"const",[269,675,676],{"class":283}," service ",[269,678,679],{"class":279},"=",[269,681,682],{"class":279}," new",[269,684,685],{"class":332}," PersonRepository",[269,687,688],{"class":283},"()\n",[269,690,691],{"class":271,"line":319},[269,692,323],{"emptyLinePlaceholder":322},[269,694,695],{"class":271,"line":326},[269,696,698],{"class":697},"sHwdD","\u002F\u002F Only returns people belonging to the current tenant\n",[269,700,701,703,706,708,711,714,716,719,722,725,728,730,734,736,739,741,744,746],{"class":271,"line":344},[269,702,673],{"class":350},[269,704,705],{"class":283}," people ",[269,707,679],{"class":279},[269,709,710],{"class":275}," await",[269,712,713],{"class":283}," service",[269,715,258],{"class":279},[269,717,718],{"class":332},"findAll",[269,720,721],{"class":283},"(",[269,723,724],{"class":279},"{",[269,726,727],{"class":373}," page",[269,729,377],{"class":279},[269,731,733],{"class":732},"sbssI"," 0",[269,735,287],{"class":279},[269,737,738],{"class":373}," size",[269,740,377],{"class":279},[269,742,743],{"class":732}," 10",[269,745,303],{"class":279},[269,747,748],{"class":283},")\n",[239,750,751],{},"All CRUD operations (save, find, update, delete, search, count) are scoped to the current tenant transparently.",[243,753,755],{"id":754},"admin-repository","Admin Repository",[239,757,758,759,762,763,765,766,769,770,773],{},"When you run ",[251,760,761],{},"kinotic sync"," on an entity with a ",[251,764,253],{}," field, the CLI generates both a tenant-scoped repository (",[251,767,768],{},"PersonRepository",") and an admin repository (",[251,771,772],{},"PersonAdminRepository",") that can access data across tenants. The admin repository is useful for administrative dashboards, reporting, and cross-tenant operations.",[260,775,777],{"className":262,"code":776,"language":264,"meta":265,"style":265},"const adminService = new PersonAdminRepository()\n",[251,778,779],{"__ignoreMap":265},[269,780,781,783,786,788,790,793],{"class":271,"line":272},[269,782,673],{"class":350},[269,784,785],{"class":283}," adminService ",[269,787,679],{"class":279},[269,789,682],{"class":279},[269,791,792],{"class":332}," PersonAdminRepository",[269,794,688],{"class":283},[796,797,799],"h3",{"id":798},"access-all-tenants","Access All Tenants",[260,801,803],{"className":262,"code":802,"language":264,"meta":265,"style":265},"const allPeople = await adminService.findAll(['*'], { page: 0, size: 10 })\n",[251,804,805],{"__ignoreMap":265},[269,806,807,809,812,814,816,819,821,823,826,829,832,834,837,839,841,843,845,847,849,851,853,855,857],{"class":271,"line":272},[269,808,673],{"class":350},[269,810,811],{"class":283}," allPeople ",[269,813,679],{"class":279},[269,815,710],{"class":275},[269,817,818],{"class":283}," adminService",[269,820,258],{"class":279},[269,822,718],{"class":332},[269,824,825],{"class":283},"([",[269,827,828],{"class":279},"'",[269,830,831],{"class":312},"*",[269,833,828],{"class":279},[269,835,836],{"class":283},"]",[269,838,287],{"class":279},[269,840,280],{"class":279},[269,842,727],{"class":373},[269,844,377],{"class":279},[269,846,733],{"class":732},[269,848,287],{"class":279},[269,850,738],{"class":373},[269,852,377],{"class":279},[269,854,743],{"class":732},[269,856,303],{"class":279},[269,858,748],{"class":283},[796,860,862],{"id":861},"access-a-specific-tenant","Access a Specific Tenant",[260,864,866],{"className":262,"code":865,"language":264,"meta":265,"style":265},"const tenantPeople = await adminService.findAll(['tenant-123'], { page: 0, size: 10 })\n",[251,867,868],{"__ignoreMap":265},[269,869,870,872,875,877,879,881,883,885,887,889,892,894,896,898,900,902,904,906,908,910,912,914,916],{"class":271,"line":272},[269,871,673],{"class":350},[269,873,874],{"class":283}," tenantPeople ",[269,876,679],{"class":279},[269,878,710],{"class":275},[269,880,818],{"class":283},[269,882,258],{"class":279},[269,884,718],{"class":332},[269,886,825],{"class":283},[269,888,828],{"class":279},[269,890,891],{"class":312},"tenant-123",[269,893,828],{"class":279},[269,895,836],{"class":283},[269,897,287],{"class":279},[269,899,280],{"class":279},[269,901,727],{"class":373},[269,903,377],{"class":279},[269,905,733],{"class":732},[269,907,287],{"class":279},[269,909,738],{"class":373},[269,911,377],{"class":279},[269,913,743],{"class":732},[269,915,303],{"class":279},[269,917,748],{"class":283},[796,919,921],{"id":920},"access-multiple-tenants","Access Multiple Tenants",[260,923,925],{"className":262,"code":924,"language":264,"meta":265,"style":265},"const multiPeople = await adminService.findAll(['tenant-123', 'tenant-456'], { page: 0, size: 10 })\n",[251,926,927],{"__ignoreMap":265},[269,928,929,931,934,936,938,940,942,944,946,948,950,952,954,956,959,961,963,965,967,969,971,973,975,977,979,981,983],{"class":271,"line":272},[269,930,673],{"class":350},[269,932,933],{"class":283}," multiPeople ",[269,935,679],{"class":279},[269,937,710],{"class":275},[269,939,818],{"class":283},[269,941,258],{"class":279},[269,943,718],{"class":332},[269,945,825],{"class":283},[269,947,828],{"class":279},[269,949,891],{"class":312},[269,951,828],{"class":279},[269,953,287],{"class":279},[269,955,309],{"class":279},[269,957,958],{"class":312},"tenant-456",[269,960,828],{"class":279},[269,962,836],{"class":283},[269,964,287],{"class":279},[269,966,280],{"class":279},[269,968,727],{"class":373},[269,970,377],{"class":279},[269,972,733],{"class":732},[269,974,287],{"class":279},[269,976,738],{"class":373},[269,978,377],{"class":279},[269,980,743],{"class":732},[269,982,303],{"class":279},[269,984,748],{"class":283},[243,986,988],{"id":987},"tenant-selection","Tenant Selection",[239,990,991],{},"Admin repository methods accept a tenant selection array as the first argument:",[486,993,994,1004],{},[489,995,996],{},[492,997,998,1001],{},[495,999,1000],{},"Selection",[495,1002,1003],{},"Behavior",[506,1005,1006,1016,1026],{},[492,1007,1008,1013],{},[511,1009,1010],{},[251,1011,1012],{},"['*']",[511,1014,1015],{},"Access data from all tenants",[492,1017,1018,1023],{},[511,1019,1020],{},[251,1021,1022],{},"['tenant-123']",[511,1024,1025],{},"Access data from a single tenant",[492,1027,1028,1033],{},[511,1029,1030],{},[251,1031,1032],{},"['tenant-123', 'tenant-456']",[511,1034,1035],{},"Access data from multiple tenants",[243,1037,1039],{"id":1038},"security-considerations","Security Considerations",[239,1041,1042,1043,1047,1048,1050,1051,1053],{},"A participant that belongs to a tenant is confined to it. Through the admin repository, including its ",[628,1044,1046],{"href":1045},"\u002Fapps\u002Fpersistence\u002Fnamed-queries#admin-repository-queries","named queries",", it may select only its own tenant; naming another tenant, or ",[251,1049,1012],{},", is refused with an authorization error. On save, a blank ",[251,1052,253],{}," is filled with the participant's tenant and any other value is rejected. Selecting other tenants is possible only for a participant without a tenant, which is how a microservice in a project's deployment connects (organization scope), and such a participant must name the tenant of every entity it saves.",[239,1055,1056],{},"The standard tenant-isolated repository is the default and should be used for regular application logic.",[1058,1059,1060],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-s