terprise License","\u002Fplatform\u002Fenterprise-license","02.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":234,"title":84,"body":235,"description":1079,"extension":1080,"links":1081,"meta":1082,"navigation":322,"path":85,"seo":1083,"stem":86,"__hash__":1084},"docs\u002F01.apps\u002F05.persistence\u002F06.multi-tenancy.md",{"type":236,"value":237,"toc":1065},"minimark",[238,242,247,259,460,466,470,485,571,585,593,597,642,647,651,657,661,668,753,756,760,778,799,804,863,867,922,926,989,993,996,1040,1044,1058,1061],[239,240,241],"p",{},"Kinotic supports multi-tenant data isolation at the persistence layer. Data from different tenants is stored together but automatically filtered so each tenant only sees their own data.",[243,244,246],"h2",{"id":245},"defining-a-multi-tenant-entity","Defining a Multi-Tenant Entity",[239,248,249,250,254,255,258],{},"Add ",[251,252,253],"code",{},"@TenantId"," to a field and set the entity to ",[251,256,257],{},"MultiTenancyType.SHARED",".",[260,261,266],"pre",{"className":262,"code":263,"language":264,"meta":265,"style":265},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Entity, AutoGeneratedId, TenantId, MultiTenancyType } from '@kinotic-ai\u002Fpersistence'\n\n@Entity(MultiTenancyType.SHARED)\nexport class Person {\n    @AutoGeneratedId\n    id: string | null = null\n\n    @TenantId\n    tenantId: string = ''\n\n    firstName: string = ''\n    lastName: string = ''\n}\n","typescript","",[251,267,268,317,324,342,359,368,393,398,406,421,426,440,454],{"__ignoreMap":265},[269,270,273,277,281,285,288,291,293,296,298,301,304,307,310,314],"span",{"class":271,"line":272},"line",1,[269,274,276],{"class":275},"s7zQu","import",[269,278,280],{"class":279},"sMK4o"," {",[269,282,284],{"class":283},"sTEyZ"," Entity",[269,286,287],{"class":279},",",[269,289,290],{"class":283}," AutoGeneratedId",[269,292,287],{"class":279},[269,294,295],{"class":283}," TenantId",[269,297,287],{"class":279},[269,299,300],{"class":283}," MultiTenancyType",[269,302,303],{"class":279}," }",[269,305,306],{"class":275}," from",[269,308,309],{"class":279}," '",[269,311,313],{"class":312},"sfazB","@kinotic-ai\u002Fpersistence",[269,315,316],{"class":279},"'\n",[269,318,320],{"class":271,"line":319},2,[269,321,323],{"emptyLinePlaceholder":322},true,"\n",[269,325,327,330,334,337,339],{"class":271,"line":326},3,[269,328,329],{"class":279},"@",[269,331,333],{"class":332},"s2Zo4","Entity",[269,335,336],{"class":283},"(MultiTenancyType",[269,338,258],{"class":279},[269,340,341],{"class":283},"SHARED)\n",[269,343,345,348,352,356],{"class":271,"line":344},4,[269,346,347],{"class":275},"export",[269,349,351],{"class":350},"spNyl"," class",[269,353,355],{"class":354},"sBMFI"," Person",[269,357,358],{"class":279}," {\n",[269,360,362,365],{"class":271,"line":361},5,[269,363,364],{"class":279},"    @",[269,366,367],{"class":283},"AutoGeneratedId\n",[269,369,371,375,378,381,384,387,390],{"class":271,"line":370},6,[269,372,374],{"class":373},"swJcz","    id",[269,376,377],{"class":279},":",[269,379,380],{"class":354}," string",[269,382,383],{"class":279}," |",[269,385,386],{"class":354}," null",[269,388,389],{"class":279}," =",[269,391,392],{"class":279}," null\n",[269,394,396],{"class":271,"line":395},7,[269,397,323],{"emptyLinePlaceholder":322},[269,399,401,403],{"class":271,"line":400},8,[269,402,364],{"class":279},[269,404,405],{"class":283},"TenantId\n",[269,407,409,412,414,416,418],{"class":271,"line":408},9,[269,410,411],{"class":373},"    tenantId",[269,413,377],{"class":279},[269,415,380],{"class":354},[269,417,389],{"class":279},[269,419,420],{"class":279}," ''\n",[269,422,424],{"class":271,"line":423},10,[269,425,323],{"emptyLinePlaceholder":322},[269,427,429,432,434,436,438],{"class":271,"line":428},11,[269,430,431],{"class":373},"    firstName",[269,433,377],{"class":279},[269,435,380],{"class":354},[269,437,389],{"class":279},[269,439,420],{"class":279},[269,441,443,446,448,450,452],{"class":271,"line":442},12,[269,444,445],{"class":373},"    lastName",[269,447,377],{"class":279},[269,449,380],{"class":354},[269,451,389],{"class":279},[269,453,420],{"class":279},[269,455,457],{"class":271,"line":456},13,[269,458,459],{"class":279},"}\n",[239,461,462,463,465],{},"The ",[251,464,253],{}," field is populated automatically based on the authenticated user's tenant context. You do not need to set it manually when saving entities.",[243,467,469],{"id":468},"where-a-users-tenant-comes-from","Where a user's tenant comes from",[239,471,472,473,476,477,480,481,484],{},"Declaring the entity is only half of it. A user's tenant is assigned when the user is created, and who assigns it is the application's ",[251,474,475],{},"tenantManagement"," setting: ",[251,478,479],{},"PLATFORM"," gives every user a tenant of their own at creation, ",[251,482,483],{},"TENANT_ADMINISTRATORS"," leaves tenants to the people who create them — a customer signing up, or the organization in the portal — whose administrators decide who joins.",[486,487,488,505],"table",{},[489,490,491],"thead",{},[492,493,494,500,502],"tr",{},[495,496,497,498],"th",{},"Application ",[251,499,475],{},[495,501,333],{},[495,503,504],{},"Result",[506,507,508,523,536,556],"tbody",{},[492,509,510,515,520],{},[511,512,513],"td",{},[251,514,483],{},[511,516,517],{},[251,518,519],{},"MultiTenancyType.NONE",[511,521,522],{},"One shared dataset — every user sees every other user's rows",[492,524,525,529,533],{},[511,526,527],{},[251,528,479],{},[511,530,531],{},[251,532,519],{},[511,534,535],{},"Still one shared dataset; the setting has nothing to act on",[492,537,538,542,550],{},[511,539,540],{},[251,541,483],{},[511,543,544,547,548],{},[251,545,546],{},"SHARED"," + ",[251,549,253],{},[511,551,552,553],{},"A user created into no tenant has none, and its writes fail with ",[251,554,555],{},"tenantId cannot be null or blank for shared multi tenancy",[492,557,558,562,568],{},[511,559,560],{},[251,561,479],{},[511,563,564,547,566],{},[251,565,546],{},[251,567,253],{},[511,569,570],{},"Each user isolated in their own tenant",[239,572,573,574,577,578,580,581,258],{},"Choose it when the application is created — ",[251,575,576],{},"createApplicationIfNotExist"," takes it as an argument, defaulting to ",[251,579,483],{}," — and change it afterwards only from the portal, under ",[582,583,584],"strong",{},"Application → Settings → Tenants",[239,586,587,589,590,592],{},[251,588,479],{}," applies to users created while it is in force. Existing users are never backfilled, so choosing it for an application that already has users leaves those users without a tenant, and every write they make to a ",[251,591,546],{}," entity fails. Settle it before the application has users.",[243,594,596],{"id":595},"tenants-and-their-sites","Tenants and their sites",[239,598,599,600,602,603,606,607,610,611,614,615,618,619,622,623,626,627,630,631,635,636,638,639,641],{},"Under ",[251,601,483],{}," a tenant is a ",[251,604,605],{},"Tenant"," of the application, created by your organization in the portal or through ",[251,608,609],{},"TenantService"," (",[251,612,613],{},"createTenantIfNotExist(applicationId, name, description)","), whose id is its slugified name: lowercase letters, digits and single dashes, at most 24 characters so it leads a hostname label, and unique within your organization, so a name whose slug a tenant of another of your applications already holds is refused. The tenant's users carry that id as their ",[251,616,617],{},"tenantId",". Each of the application's published UIs is also served for the tenant at ",[251,620,621],{},"\u003CtenantId>--\u003CapplicationId>--\u003CuiName>"," under your organization's subdomain of the sites domain, and a sign-in from that site is to the tenant: it admits the tenant's users only, and offers the tenant's own identity providers (",[251,624,625],{},"TenantOidcConfiguration",", added for the tenant on the application's ",[582,628,629],{},"Settings → Sign-in providers"," tab in the portal) before the application's — see ",[632,633,98],"a",{"href":634},"\u002Fapps\u002Fsecurity\u002Fauthentication#signing-in-to-a-tenant",". A tenant whose users were created with a ",[251,637,617],{}," no ",[251,640,605],{}," row names has no login of its own until the row is created.",[239,643,599,644,646],{},[251,645,479],{}," tenants are minted per user and have no rows or sites; the user signs in at the application's own sites.",[243,648,650],{"id":649},"tenants-and-services","Tenants and services",[239,652,653,654,656],{},"A tenant comes from the authenticated participant, and only an application-scope participant carries one. A microservice running in a project's deployment connects at organization scope, so it cannot read or write a ",[251,655,546],{}," entity through the tenant-scoped repository — it uses the admin repository below, naming the tenants it means to act on. Per-user writes driven by the user belong on a client connected as that user.",[243,658,660],{"id":659},"tenant-isolated-repository","Tenant-Isolated Repository",[239,662,663,664,667],{},"The standard generated ",[251,665,666],{},"Repository"," automatically filters all operations to the current tenant. No additional configuration is needed.",[260,669,671],{"className":262,"code":670,"language":264,"meta":265,"style":265},"const service = new PersonRepository()\n\n\u002F\u002F Only returns people belonging to the current tenant\nconst people = await service.findAll({ page: 0, size: 10 })\n",[251,672,673,693,697,703],{"__ignoreMap":265},[269,674,675,678,681,684,687,690],{"class":271,"line":272},[269,676,677],{"class":350},"const",[269,679,680],{"class":283}," service ",[269,682,683],{"class":279},"=",[269,685,686],{"class":279}," new",[269,688,689],{"class":332}," PersonRepository",[269,691,692],{"class":283},"()\n",[269,694,695],{"class":271,"line":319},[269,696,323],{"emptyLinePlaceholder":322},[269,698,699],{"class":271,"line":326},[269,700,702],{"class":701},"sHwdD","\u002F\u002F Only returns people belonging to the current tenant\n",[269,704,705,707,710,712,715,718,720,723,726,729,732,734,738,740,743,745,748,750],{"class":271,"line":344},[269,706,677],{"class":350},[269,708,709],{"class":283}," people ",[269,711,683],{"class":279},[269,713,714],{"class":275}," await",[269,716,717],{"class":283}," service",[269,719,258],{"class":279},[269,721,722],{"class":332},"findAll",[269,724,725],{"class":283},"(",[269,727,728],{"class":279},"{",[269,730,731],{"class":373}," page",[269,733,377],{"class":279},[269,735,737],{"class":736},"sbssI"," 0",[269,739,287],{"class":279},[269,741,742],{"class":373}," size",[269,744,377],{"class":279},[269,746,747],{"class":736}," 10",[269,749,303],{"class":279},[269,751,752],{"class":283},")\n",[239,754,755],{},"All CRUD operations (save, find, update, delete, search, count) are scoped to the current tenant transparently.",[243,757,759],{"id":758},"admin-repository","Admin Repository",[239,761,762,763,766,767,769,770,773,774,777],{},"When you run ",[251,764,765],{},"kinotic sync"," on an entity with a ",[251,768,253],{}," field, the CLI generates both a tenant-scoped repository (",[251,771,772],{},"PersonRepository",") and an admin repository (",[251,775,776],{},"PersonAdminRepository",") that can access data across tenants. The admin repository is useful for administrative dashboards, reporting, and cross-tenant operations.",[260,779,781],{"className":262,"code":780,"language":264,"meta":265,"style":265},"const adminService = new PersonAdminRepository()\n",[251,782,783],{"__ignoreMap":265},[269,784,785,787,790,792,794,797],{"class":271,"line":272},[269,786,677],{"class":350},[269,788,789],{"class":283}," adminService ",[269,791,683],{"class":279},[269,793,686],{"class":279},[269,795,796],{"class":332}," PersonAdminRepository",[269,798,692],{"class":283},[800,801,803],"h3",{"id":802},"access-all-tenants","Access All Tenants",[260,805,807],{"className":2