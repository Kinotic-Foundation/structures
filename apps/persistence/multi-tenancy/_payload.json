terprise License","\u002Fplatform\u002Fenterprise-license","02.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":234,"title":84,"body":235,"description":1014,"extension":1015,"links":1016,"meta":1017,"navigation":322,"path":85,"seo":1018,"stem":86,"__hash__":1019},"docs\u002F01.apps\u002F05.persistence\u002F06.multi-tenancy.md",{"type":236,"value":237,"toc":1001},"minimark",[238,242,247,259,460,466,470,477,565,576,582,586,592,596,603,688,691,695,713,734,739,798,802,857,861,924,928,931,975,979,994,997],[239,240,241],"p",{},"Kinotic supports multi-tenant data isolation at the persistence layer. Data from different tenants is stored together but automatically filtered so each tenant only sees their own data.",[243,244,246],"h2",{"id":245},"defining-a-multi-tenant-entity","Defining a Multi-Tenant Entity",[239,248,249,250,254,255,258],{},"Add ",[251,252,253],"code",{},"@TenantId"," to a field and set the entity to ",[251,256,257],{},"MultiTenancyType.SHARED",".",[260,261,266],"pre",{"className":262,"code":263,"language":264,"meta":265,"style":265},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Entity, AutoGeneratedId, TenantId, MultiTenancyType } from '@kinotic-ai\u002Fpersistence'\n\n@Entity(MultiTenancyType.SHARED)\nexport class Person {\n    @AutoGeneratedId\n    id: string | null = null\n\n    @TenantId\n    tenantId: string = ''\n\n    firstName: string = ''\n    lastName: string = ''\n}\n","typescript","",[251,267,268,317,324,342,359,368,393,398,406,421,426,440,454],{"__ignoreMap":265},[269,270,273,277,281,285,288,291,293,296,298,301,304,307,310,314],"span",{"class":271,"line":272},"line",1,[269,274,276],{"class":275},"s7zQu","import",[269,278,280],{"class":279},"sMK4o"," {",[269,282,284],{"class":283},"sTEyZ"," Entity",[269,286,287],{"class":279},",",[269,289,290],{"class":283}," AutoGeneratedId",[269,292,287],{"class":279},[269,294,295],{"class":283}," TenantId",[269,297,287],{"class":279},[269,299,300],{"class":283}," MultiTenancyType",[269,302,303],{"class":279}," }",[269,305,306],{"class":275}," from",[269,308,309],{"class":279}," '",[269,311,313],{"class":312},"sfazB","@kinotic-ai\u002Fpersistence",[269,315,316],{"class":279},"'\n",[269,318,320],{"class":271,"line":319},2,[269,321,323],{"emptyLinePlaceholder":322},true,"\n",[269,325,327,330,334,337,339],{"class":271,"line":326},3,[269,328,329],{"class":279},"@",[269,331,333],{"class":332},"s2Zo4","Entity",[269,335,336],{"class":283},"(MultiTenancyType",[269,338,258],{"class":279},[269,340,341],{"class":283},"SHARED)\n",[269,343,345,348,352,356],{"class":271,"line":344},4,[269,346,347],{"class":275},"export",[269,349,351],{"class":350},"spNyl"," class",[269,353,355],{"class":354},"sBMFI"," Person",[269,357,358],{"class":279}," {\n",[269,360,362,365],{"class":271,"line":361},5,[269,363,364],{"class":279},"    @",[269,366,367],{"class":283},"AutoGeneratedId\n",[269,369,371,375,378,381,384,387,390],{"class":271,"line":370},6,[269,372,374],{"class":373},"swJcz","    id",[269,376,377],{"class":279},":",[269,379,380],{"class":354}," string",[269,382,383],{"class":279}," |",[269,385,386],{"class":354}," null",[269,388,389],{"class":279}," =",[269,391,392],{"class":279}," null\n",[269,394,396],{"class":271,"line":395},7,[269,397,323],{"emptyLinePlaceholder":322},[269,399,401,403],{"class":271,"line":400},8,[269,402,364],{"class":279},[269,404,405],{"class":283},"TenantId\n",[269,407,409,412,414,416,418],{"class":271,"line":408},9,[269,410,411],{"class":373},"    tenantId",[269,413,377],{"class":279},[269,415,380],{"class":354},[269,417,389],{"class":279},[269,419,420],{"class":279}," ''\n",[269,422,424],{"class":271,"line":423},10,[269,425,323],{"emptyLinePlaceholder":322},[269,427,429,432,434,436,438],{"class":271,"line":428},11,[269,430,431],{"class":373},"    firstName",[269,433,377],{"class":279},[269,435,380],{"class":354},[269,437,389],{"class":279},[269,439,420],{"class":279},[269,441,443,446,448,450,452],{"class":271,"line":442},12,[269,444,445],{"class":373},"    lastName",[269,447,377],{"class":279},[269,449,380],{"class":354},[269,451,389],{"class":279},[269,453,420],{"class":279},[269,455,457],{"class":271,"line":456},13,[269,458,459],{"class":279},"}\n",[239,461,462,463,465],{},"The ",[251,464,253],{}," field is populated automatically based on the authenticated user's tenant context. You do not need to set it manually when saving entities.",[243,467,469],{"id":468},"where-a-users-tenant-comes-from","Where a user's tenant comes from",[239,471,472,473,476],{},"Declaring the entity is only half of it. A user's tenant is assigned when the user is created, and only when the owning application has ",[251,474,475],{},"tenantPerUser"," enabled — the setting that decides whether each user of the application is isolated or everyone shares one set of data.",[478,479,480,497],"table",{},[481,482,483],"thead",{},[484,485,486,492,494],"tr",{},[487,488,489,490],"th",{},"Application ",[251,491,475],{},[487,493,333],{},[487,495,496],{},"Result",[498,499,500,516,530,550],"tbody",{},[484,501,502,508,513],{},[503,504,505],"td",{},[251,506,507],{},"false",[503,509,510],{},[251,511,512],{},"MultiTenancyType.NONE",[503,514,515],{},"One shared dataset — every user sees every other user's rows",[484,517,518,523,527],{},[503,519,520],{},[251,521,522],{},"true",[503,524,525],{},[251,526,512],{},[503,528,529],{},"Still one shared dataset; the setting has nothing to act on",[484,531,532,536,544],{},[503,533,534],{},[251,535,507],{},[503,537,538,541,542],{},[251,539,540],{},"SHARED"," + ",[251,543,253],{},[503,545,546,547],{},"Users have no tenant, and writes fail with ",[251,548,549],{},"tenantId cannot be null or blank for shared multi tenancy",[484,551,552,556,562],{},[503,553,554],{},[251,555,522],{},[503,557,558,541,560],{},[251,559,540],{},[251,561,253],{},[503,563,564],{},"Each user isolated in their own tenant",[239,566,567,568,571,572,258],{},"Choose it when the application is created — ",[251,569,570],{},"createApplicationIfNotExist"," takes it as an argument — and change it afterwards only from the portal, under ",[573,574,575],"strong",{},"Application → Settings → Tenant per user",[239,577,578,579,581],{},"It applies to users created while it is enabled. Existing users are never backfilled, so enabling it on an application that already has users leaves those users without a tenant, and every write they make to a ",[251,580,540],{}," entity fails. Settle it before the application has users.",[243,583,585],{"id":584},"tenants-and-services","Tenants and services",[239,587,588,589,591],{},"A tenant comes from the authenticated participant, and only an application-scope participant carries one. A microservice running in a project's deployment connects at organization scope, so it cannot read or write a ",[251,590,540],{}," entity through the tenant-scoped repository — it uses the admin repository below, naming the tenants it means to act on. Per-user writes driven by the user belong on a client connected as that user.",[243,593,595],{"id":594},"tenant-isolated-repository","Tenant-Isolated Repository",[239,597,598,599,602],{},"The standard generated ",[251,600,601],{},"Repository"," automatically filters all operations to the current tenant. No additional configuration is needed.",[260,604,606],{"className":262,"code":605,"language":264,"meta":265,"style":265},"const service = new PersonRepository()\n\n\u002F\u002F Only returns people belonging to the current tenant\nconst people = await service.findAll({ page: 0, size: 10 })\n",[251,607,608,628,632,638],{"__ignoreMap":265},[269,609,610,613,616,619,622,625],{"class":271,"line":272},[269,611,612],{"class":350},"const",[269,614,615],{"class":283}," service ",[269,617,618],{"class":279},"=",[269,620,621],{"class":279}," new",[269,623,624],{"class":332}," PersonRepository",[269,626,627],{"class":283},"()\n",[269,629,630],{"class":271,"line":319},[269,631,323],{"emptyLinePlaceholder":322},[269,633,634],{"class":271,"line":326},[269,635,637],{"class":636},"sHwdD","\u002F\u002F Only returns people belonging to the current tenant\n",[269,639,640,642,645,647,650,653,655,658,661,664,667,669,673,675,678,680,683,685],{"class":271,"line":344},[269,641,612],{"class":350},[269,643,644],{"class":283}," people ",[269,646,618],{"class":279},[269,648,649],{"class":275}," await",[269,651,652],{"class":283}," service",[269,654,258],{"class":279},[269,656,657],{"class":332},"findAll",[269,659,660],{"class":283},"(",[269,662,663],{"class":279},"{",[269,665,666],{"class":373}," page",[269,668,377],{"class":279},[269,670,672],{"class":671},"sbssI"," 0",[269,674,287],{"class":279},[269,676,677],{"class":373}," size",[269,679,377],{"class":279},[269,681,682],{"class":671}," 10",[269,684,303],{"class":279},[269,686,687],{"class":283},")\n",[239,689,690],{},"All CRUD operations (save, find, update, delete, search, count) are scoped to the current tenant transparently.",[243,692,694],{"id":693},"admin-repository","Admin Repository",[239,696,697,698,701,702,704,705,708,709,712],{},"When you run ",[251,699,700],{},"kinotic sync"," on an entity with a ",[251,703,253],{}," field, the CLI generates both a tenant-scoped repository (",[251,706,707],{},"PersonRepository",") and an admin repository (",[251,710,711],{},"PersonAdminRepository",") that can access data across tenants. The admin repository is useful for administrative dashboards, reporting, and cross-tenant operations.",[260,714,716],{"className":262,"code":715,"language":264,"meta":265,"style":265},"const adminService = new PersonAdminRepository()\n",[251,717,718],{"__ignoreMap":265},[269,719,720,722,725,727,729,732],{"class":271,"line":272},[269,721,612],{"class":350},[269,723,724],{"class":283}," adminService ",[269,726,618],{"class":279},[269,728,621],{"class":279},[269,730,731],{"class":332}," PersonAdminRepository",[269,733,627],{"class":283},[735,736,738],"h3",{"id":737},"access-all-tenants","Access All Tenan