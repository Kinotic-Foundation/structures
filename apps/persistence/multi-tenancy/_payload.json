upports multi-tenant data isolation at the persistence layer. Data from different tenants is stored together but automatically filtered so each tenant only sees their own data.",[228,229,231],"h2",{"id":230},"defining-a-multi-tenant-entity","Defining a Multi-Tenant Entity",[224,233,234,235,239,240,243],{},"Add ",[236,237,238],"code",{},"@TenantId"," to a field and set the entity to ",[236,241,242],{},"MultiTenancyType.SHARED",".",[245,246,251],"pre",{"className":247,"code":248,"language":249,"meta":250,"style":250},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { Entity, AutoGeneratedId, TenantId, MultiTenancyType } from '@kinotic-ai\u002Fpersistence'\n\n@Entity(MultiTenancyType.SHARED)\nexport class Person {\n    @AutoGeneratedId\n    id: string | null = null\n\n    @TenantId\n    tenantId: string = ''\n\n    firstName: string = ''\n    lastName: string = ''\n}\n","typescript","",[236,252,253,302,309,327,344,353,378,383,391,406,411,425,439],{"__ignoreMap":250},[254,255,258,262,266,270,273,276,278,281,283,286,289,292,295,299],"span",{"class":256,"line":257},"line",1,[254,259,261],{"class":260},"s7zQu","import",[254,263,265],{"class":264},"sMK4o"," {",[254,267,269],{"class":268},"sTEyZ"," Entity",[254,271,272],{"class":264},",",[254,274,275],{"class":268}," AutoGeneratedId",[254,277,272],{"class":264},[254,279,280],{"class":268}," TenantId",[254,282,272],{"class":264},[254,284,285],{"class":268}," MultiTenancyType",[254,287,288],{"class":264}," }",[254,290,291],{"class":260}," from",[254,293,294],{"class":264}," '",[254,296,298],{"class":297},"sfazB","@kinotic-ai\u002Fpersistence",[254,300,301],{"class":264},"'\n",[254,303,305],{"class":256,"line":304},2,[254,306,308],{"emptyLinePlaceholder":307},true,"\n",[254,310,312,315,319,322,324],{"class":256,"line":311},3,[254,313,314],{"class":264},"@",[254,316,318],{"class":317},"s2Zo4","Entity",[254,320,321],{"class":268},"(MultiTenancyType",[254,323,243],{"class":264},[254,325,326],{"class":268},"SHARED)\n",[254,328,330,333,337,341],{"class":256,"line":329},4,[254,331,332],{"class":260},"export",[254,334,336],{"class":335},"spNyl"," class",[254,338,340],{"class":339},"sBMFI"," Person",[254,342,343],{"class":264}," {\n",[254,345,347,350],{"class":256,"line":346},5,[254,348,349],{"class":264},"    @",[254,351,352],{"class":268},"AutoGeneratedId\n",[254,354,356,360,363,366,369,372,375],{"class":256,"line":355},6,[254,357,359],{"class":358},"swJcz","    id",[254,361,362],{"class":264},":",[254,364,365],{"class":339}," string",[254,367,368],{"class":264}," |",[254,370,371],{"class":339}," null",[254,373,374],{"class":264}," =",[254,376,377],{"class":264}," null\n",[254,379,381],{"class":256,"line":380},7,[254,382,308],{"emptyLinePlaceholder":307},[254,384,386,388],{"class":256,"line":385},8,[254,387,349],{"class":264},[254,389,390],{"class":268},"TenantId\n",[254,392,394,397,399,401,403],{"class":256,"line":393},9,[254,395,396],{"class":358},"    tenantId",[254,398,362],{"class":264},[254,400,365],{"class":339},[254,402,374],{"class":264},[254,404,405],{"class":264}," ''\n",[254,407,409],{"class":256,"line":408},10,[254,410,308],{"emptyLinePlaceholder":307},[254,412,414,417,419,421,423],{"class":256,"line":413},11,[254,415,416],{"class":358},"    firstName",[254,418,362],{"class":264},[254,420,365],{"class":339},[254,422,374],{"class":264},[254,424,405],{"class":264},[254,426,428,431,433,435,437],{"class":256,"line":427},12,[254,429,430],{"class":358},"    lastName",[254,432,362],{"class":264},[254,434,365],{"class":339},[254,436,374],{"class":264},[254,438,405],{"class":264},[254,440,442],{"class":256,"line":441},13,[254,443,444],{"class":264},"}\n",[224,446,447,448,450],{},"The ",[236,449,238],{}," field is populated automatically based on the authenticated user's tenant context. You do not need to set it manually when saving entities.",[228,452,454],{"id":453},"where-a-users-tenant-comes-from","Where a user's tenant comes from",[224,456,457,458,461],{},"Declaring the entity is only half of it. A user's tenant is assigned when the user is created, and only when the owning application has ",[236,459,460],{},"tenantPerUser"," enabled — the setting that decides whether each user of the application is isolated or everyone shares one set of data.",[463,464,465,482],"table",{},[466,467,468],"thead",{},[469,470,471,477,479],"tr",{},[472,473,474,475],"th",{},"Application ",[236,476,460],{},[472,478,318],{},[472,480,481],{},"Result",[483,484,485,501,515,535],"tbody",{},[469,486,487,493,498],{},[488,489,490],"td",{},[236,491,492],{},"false",[488,494,495],{},[236,496,497],{},"MultiTenancyType.NONE",[488,499,500],{},"One shared dataset — every user sees every other user's rows",[469,502,503,508,512],{},[488,504,505],{},[236,506,507],{},"true",[488,509,510],{},[236,511,497],{},[488,513,514],{},"Still one shared dataset; the setting has nothing to act on",[469,516,517,521,529],{},[488,518,519],{},[236,520,492],{},[488,522,523,526,527],{},[236,524,525],{},"SHARED"," + ",[236,528,238],{},[488,530,531,532],{},"Users have no tenant, and writes fail with ",[236,533,534],{},"tenantId cannot be null or blank for shared multi tenancy",[469,536,537,541,547],{},[488,538,539],{},[236,540,507],{},[488,542,543,526,545],{},[236,544,525],{},[236,546,238],{},[488,548,549],{},"Each user isolated in their own tenant",[224,551,552,553,556,557,243],{},"Choose it when the application is created — ",[236,554,555],{},"createApplicationIfNotExist"," takes it as an argument — and change it afterwards only from the portal, under ",[558,559,560],"strong",{},"Application → Settings → Tenant per user",[224,562,563,564,566],{},"It applies to users created while it is enabled. Existing users are never backfilled, so enabling it on an application that already has users leaves those users without a tenant, and every write they make to a ",[236,565,525],{}," entity fails. Settle it before the application has users.",[228,568,570],{"id":569},"tenants-and-services","Tenants and services",[224,572,573,574,576],{},"A tenant comes from the authenticated participant, and only an application-scope participant carries one. A microservice running in a project's deployment connects at organization scope, so it cannot read or write a ",[236,575,525],{}," entity through the tenant-scoped repository — it uses the admin repository below, naming the tenants it means to act on. Per-user writes driven by the user belong on a client connected as that user.",[228,578,580],{"id":579},"tenant-isolated-repository","Tenant-Isolated Repository",[224,582,583,584,587],{},"The standard generated ",[236,585,586],{},"Repository"," automatically filters all operations to the current tenant. No additional configuration is needed.",[245,589,591],{"className":247,"code":590,"language":249,"meta":250,"style":250},"const service = new PersonRepository()\n\n\u002F\u002F Only returns people belonging to the current tenant\nconst people = await service.findAll({ page: 0, size: 10 })\n",[236,592,593,613,617,623],{"__ignoreMap":250},[254,594,595,598,601,604,607,610],{"class":256,"line":257},[254,596,597],{"class":335},"const",[254,599,600],{"class":268}," service ",[254,602,603],{"class":264},"=",[254,605,606],{"class":264}," new",[254,608,609],{"class":317}," PersonRepository",[254,611,612],{"class":268},"()\n",[254,614,615],{"class":256,"line":304},[254,616,308],{"emptyLinePlaceholder":307},[254,618,619],{"class":256,"line":311},[254,620,622],{"class":621},"sHwdD","\u002F\u002F Only returns people belonging to the current tenant\n",[254,624,625,627,630,632,635,638,640,643,646,649,652,654,658,660,663,665,668,670],{"class":256,"line":329},[254,626,597],{"class":335},[254,628,629],{"class":268}," people ",[254,631,603],{"class":264},[254,633,634],{"class":260}," await",[254,636,637],{"class":268}," service",[254,639,243],{"class":264},[254,641,642],{"class":317},"findAll",[254,644,645],{"class":268},"(",[254,647,648],{"class":264},