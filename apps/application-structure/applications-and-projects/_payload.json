,636],"h4",{"id":635},"fields","Fields",[638,639,640,652],"table",{},[641,642,643],"thead",{},[644,645,646,650],"tr",{},[647,648,649],"th",{},"Field",[647,651,297],{},[653,654,655,669,681,697,713,727,762,777,789],"tbody",{},[644,656,657,663],{},[658,659,660],"td",{},[262,661,662],{},"organizationId",[658,664,665,668],{},[257,666,667],{},"Required."," The id of the Kinotic organization this project belongs to.",[644,670,671,676],{},[658,672,673],{},[262,674,675],{},"applicationId",[658,677,678,680],{},[257,679,667],{}," The application id this project belongs to. Must match the application id registered with Kinotic OS: lowercase letters, digits, and interior dashes.",[644,682,683,688],{},[658,684,685],{},[262,686,687],{},"projectId",[658,689,690,692,693,696],{},[257,691,667],{}," The id of this project in Kinotic OS. Provisioned repositories carry the id of the project that created them; ",[262,694,695],{},"kinotic sync"," addresses this project and fails when it does not exist.",[644,698,699,704],{},[658,700,701],{},[262,702,703],{},"name",[658,705,706,707,709,710,712],{},"Optional project name. When omitted, the ",[262,708,703],{}," from the project's ",[262,711,333],{}," is used.",[644,714,715,720],{},[658,716,717],{},[262,718,719],{},"description",[658,721,722,723,709,725,712],{},"Optional project description. When omitted, the ",[262,724,719],{},[262,726,333],{},[644,728,729,734],{},[658,730,731],{},[262,732,733],{},"entitiesPaths",[658,735,736,738,739,742,743,746,747,750,751,754,755,758,759,761],{},[257,737,667],{}," An array whose entries are either a plain path string or an ",[262,740,741],{},"EntitiesPathConfig"," object with ",[262,744,745],{},"path"," (the directory containing entity definitions), ",[262,748,749],{},"repositoryPath"," (where the CLI writes generated repository classes), and ",[262,752,753],{},"mirrorFolderStructure"," (whether to replicate the entity directory structure in the output, default ",[262,756,757],{},"true","). The CLI scans these paths when you run ",[262,760,695],{},".",[644,763,764,769],{},[658,765,766],{},[262,767,768],{},"generatedPath",[658,770,771,772,774,775,761],{},"The default output path for generated files, used for ",[262,773,733],{}," entries that are plain strings. Ignored for entries that use ",[262,776,741],{},[644,778,779,784],{},[658,780,781],{},[262,782,783],{},"fileExtensionForImports",[658,785,786,787,761],{},"The extension the CLI writes on import paths in generated code. Defaults to ",[262,788,575],{},[644,790,791,796],{},[658,792,793],{},[262,794,795],{},"validate",[658,797,798],{},"When true, generated repository classes validate data before sending it to the server.",[340,800,802],{"id":801},"project-dependencies","Project Dependencies",[239,804,805,806,808],{},"Projects within the same application can depend on each other. For example, a microservice project might import entity types defined in a persistence project. These dependencies are managed through standard ",[262,807,333],{}," -- you add the dependency just like any other Bun package.",[358,810,814],{"className":811,"code":812,"language":813,"meta":363,"style":363},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","{\n    \"dependencies\": {\n        \"@my-org\u002Fdata\": \"workspace:*\"\n    }\n}\n","json",[262,815,816,821,835,855,859],{"__ignoreMap":363},[367,817,818],{"class":369,"line":370},[367,819,820],{"class":380},"{\n",[367,822,823,826,829,831,833],{"class":369,"line":404},[367,824,825],{"class":380},"    \"",[367,827,828],{"class":414},"dependencies",[367,830,448],{"class":380},[367,832,421],{"class":380},[367,834,430],{"class":380},[367,836,837,840,843,845,847,849,852],{"class":369,"line":411},[367,838,839],{"class":380},"        \"",[367,841,842],{"class":424},"@my-org\u002Fdata",[367,844,448],{"class":380},[367,846,421],{"class":380},[367,848,442],{"class":380},[367,850,851],{"class":397},"workspace:*",[367,853,854],{"class":380},"\"\n",[367,856,857],{"class":369,"line":433},[367,858,554],{"class":380},[367,860,861],{"class":369,"line":454},[367,862,596],{"class":380},[239,864,865],{},"When the application is deployed, the platform resolves these internal dependencies and ensures all projects are available to each other through the Service Directory.",[243,867,869],{"id":868},"deployable-packages","Deployable packages",[239,871,872,873,875],{},"When a push deploys a project (see ",[277,874,119],{"href":120},"), the\nplatform finds the packages it deploys by where they sit in the workspace:",[251,877,878,899],{},[254,879,880,883,884,887,888,890,891,894,895,898],{},[257,881,882],{},"Microservices"," live directly under ",[262,885,886],{},"packages\u002Fmicroservices",", one package each. A\nmicroservice runs in a VM of its own from its ",[262,889,333],{}," ",[262,892,893],{},"main",", or ",[262,896,897],{},"src\u002Fmain.ts"," when\nit declares none.",[254,900,901,883,904,907,908,911,912,915,916,918,919,921],{},[257,902,903],{},"UIs",[262,905,906],{},"packages\u002Fui",", one package each, and declare a ",[262,909,910],{},"build"," script\nthat writes ",[262,913,914],{},"dist\u002Findex.html",". A package under ",[262,917,906],{}," without a ",[262,920,910],{}," script is a\nlibrary and is left alone.",[239,923,924,925,890,927,929,930,933,934,937],{},"A package's identity is the unscoped part of its ",[262,926,333],{},[262,928,703],{}," (",[262,931,932],{},"@acme\u002Fadmin"," is\n",[262,935,936],{},"admin","), which must be lowercase letters, digits, and interior dashes and unique among the\npackages of its kind. The directory name never matters.",[239,939,940,941,943,944,946],{},"A UI's name also names its site, ",[262,942,291],{},", so it must\nnot contain ",[262,945,283],{},", and it belongs to one project of the application: a project publishing a\nUI whose name another project of the application already published fails its deployment\nuntil that UI's deployment is removed.",[340,948,950],{"id":949},"the-ui-build-contract","The UI build contract",[239,952,953,954,957,958,960,961,964],{},"Every UI is built during the deployment with ",[262,955,956],{},"bun run build",", and the build is handed its\napplication's API host, ",[262,959,287],{}," under the platform's application\ndomain, as three variables. Vite exposes ",[262,962,963],{},"VITE_*"," variables to the page on its\nown, so a Vite project reads them with no configuration; a UI with another build tool must\npass them through itself:",[638,966,967,980],{},[641,968,969],{},[644,970,971,974,977],{},[647,972,973],{},"Variable",[647,975,976],{},"Value",[647,978,979],{},"What the UI does with it",[653,981,982,998,1013],{},[644,983,984,989,995],{},[658,985,986],{},[262,987,988],{},"VITE_KINOTIC_HOST",[658,990,991,992],{},"e.g. ",[262,993,994],{},"acme--orders.apps-api.kinotic.ai",[658,996,997],{},"The host the UI connects to Kinotic on from a browser",[644,999,1000,1005,1010],{},[658,1001,1002],{},[262,1003,1004],{},"VITE_KINOTIC_PORT",[658,1006,991,1007],{},[262,1008,1009],{},"443",[658,1011,1012],{},"Its port",[644,1014,1015,1020,1027],{},[658,1016,1017],{},[262,1018,1019],{},"VITE_KINOTIC_USE_SSL",[658,1021,1022,627,1024],{},[262,1023,757],{},[262,1025,1026],{},"false",[658,1028,1029],{},"Whether to connect over TLS",[358,1031,1033],{"className":360,"code":1032,"language":362,"meta":363,"style":363},"await Kinotic.connect({\n    server: {\n        host: import.meta.env.VITE_KINOTIC_HOST,\n        port: parseInt(import.meta.env.VITE_KINOTIC_PORT),\n        useSSL: import.meta.env.VITE_KINOTIC_USE_SSL === 'true',\n    },\n})\n",[262,1034,1035,1054,1063,1089,1118,1152,1157],{"__ignoreMap":363},[367,1036,1037,1040,1043,1045,1049,1052],{"class":369,"line":370},[367,1038,1039],{"class":373},"await",[367,1041,1042],{"class":384}," Kinotic",[367,1044,761],{"class":380},[367,1046,1048],{"class":1047},"s2Zo4","connect",[367,1050,1051],{"class":384},"(",[367,1053,820],{"class":380},[367,1055,1056,1059,1061],{"class":369,"line":404},[367,1057,1058],{"class":436},"    server",[367,1060,421],{"class":380},[367,1062,430],{"class":380},[367,1064,1065,1068,1070,1073,1075,1078,1080,1083,1085,1087],{"class":369,"line":411},[367,1066,1067],{"class":436},"        host",[367,1069,421],{"class":380},[367,1071,1072],{"class":373}," import",[367,1074,761],{"class":380},[367,1076,1077],{"class":384},"meta",[367,1079,761],{"class":380},[367,1081,1082],{"class":384},"env",[367,1084,761],{"class":380},[367,1086,988],{"class":384},[367,1088,451],{"class":380},[367,1090,1091,1094,1096,1099,1101,1103,1105,1107,1109,1111,1113,1116],{"class":369,"line":433},[367,1092,1093],{"class":436},"        port",[367,1095,421],{"class":380},[367,1097,1098],{"class":1047}," parseInt",[367,1100,1051],{"class":384},[367,1102,374],{"class":373},[367,1104,761],{"class":380},[367,1106,1077],{"class":384},[367,1108,761],{"class":380},[367,1110,1082],{"class":384},[367,1112,761],{"class":380},[367,1114,1115],{"class":384},"VITE_KINOTIC_PORT)",[367,1117,451],{"class":380},[367,1119,1120,1123,1125,1127,1129,1131,1133,1135,1137,1140,1143,1145,1147,1150],{"class":369,"line":454},[367,1121,1122],{"class":436},"        useSSL",[367,1124,421],{"class":380},[367,1126,1072],{"class":373},[367,1128,761],{"class":380},[367,1130,1077],{"class":384},[367,1132,761],{"class":380},[367,1134,1082],{"class":384},[367,1136,761],{"class":380},[367,1138,1139],{"class":384},"VITE_KINOTIC_USE_SSL ",[367,1141,1142],{"class":380},"===",[367,1144,394],{"class":380},[367,1146,757],{"class":397},[367,1148,1149],{"class":380},"'",[367,1151,451],{"class":380},[367,1153,1154],{"class":369,"line":471},[367,1155,1156],{"class":380},"    },\n",[367,1158,1159,1162],{"class":369,"line":488},[367,1160,1161],{"class":380},"}",[367,1163,1164],{"class":384},")\n",[239,1166,1167,1168,1170],{},"A build that does not write ",[262,1169,914],{}," fails the deployment naming the UI.",[239,1172,1173,1176,1177,1180,1181,1184,1185,1188,1189,1192],{},[262,1174,1175],{},"dist"," is published as it is, from the site's root: files under ",[262,1178,1179],{},"assets\u002F"," carry a content\nhash in their name and are cached for a year, everything else is never cached. Each site\nalso publishes the commit it serves as ",[262,1182,1183],{},"version.json"," next to its ",[262,1186,1187],{},"index.html",", never\ncached, as ",[262,1190,1191],{},"{ \"commitSha\": \"\u003Ccommit>\" }",". A publish replaces the previous commit's files;\na tab left open on the previous commit loads the new commit when it next reloads.",[340,1194,1196],{"id":1195},"developing-a-ui-locally","Developing a UI locally",[239,1198,1199],{},"A UI served by its Vite dev server reaches a local app server through the dev server itself:\npoint the three variables at the dev server, and have it proxy the API to the app server under\nyour application's API host, so the page and its API share an origin and a session cookie:",[358,1201,1205],{"className":1202,"code":1203,"language":1204,"meta":363,"style":363},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","# .env.development\nVITE_KINOTIC_HOST=localhost\nVITE_KINOTIC_PORT=5173\nVITE_KINOTIC_USE_SSL=false\n","bash",[262,1206,1207,1213,1223,1232],{"__ignoreMap":363},[367,1208,1209],{"class":369,"line":370},[367,1210,1212],{"class":1211},"sHwdD","# .env.development\n",[367,1214,1215,1217,1220],{"class":369,"line":404},[367,1216,988],{"class":384},[367,1218,1219],{"class":380},"=",[367,1221,1222],{"class":397},"localhost\n",[367,1224,1225,1227,1229],{"class":369,"line":411},[367,1226,1004],{"class":384},[367,1228,1219],{"class":380},[367,1230,1231],{"class":397},"5173\n",[367,1233,1234,1236,1238],{"class":369,"line":433},[367,1235,1019],{"class":384},[367,1237,1219],{"class":380},[367,1239,1240],{"class":397},"false\n",[358,1242,1244],{"className":360,"code":1243,"language":362,"meta":363,"style":363},"\u002F\u002F vite.config.ts\nconst APP_API_HOST = 'acme--orders.localhost:5