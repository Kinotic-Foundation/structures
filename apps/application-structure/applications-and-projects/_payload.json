],{"id":949,"depth":411,"text":950},{"id":1195,"depth":411,"text":1196},{"id":1438,"depth":404,"text":1439},"Learn how to configure Kinotic applications and the projects that compose them.","md",null,{},{"title":29,"description":1479},"ekHgVZdz3zqfH_597qYUKEnwIfxBuik_dOB9W5Wra2U",[1486,1488],{"title":25,"path":26,"stem":27,"description":1487,"children":-1},"Understand how Kinotic apps are organized -- from organizations down to individual artifacts.",{"title":33,"path":34,"stem":35,"description":1489,"children":-1},"Learn about the different artifact types a Kinotic project can contribute -- from persistence and microservices to frontends.",1792031562982]