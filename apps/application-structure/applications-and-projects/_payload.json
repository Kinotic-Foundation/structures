e":229,"path":230,"stem":231,"icon":232},"Enterprise License","\u002Fplatform\u002Fenterprise-license","02.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":234,"title":29,"body":235,"description":1479,"extension":1480,"links":1481,"meta":1482,"navigation":407,"path":30,"seo":1483,"stem":31,"__hash__":1484},"docs\u002F01.apps\u002F03.application-structure\u002F02.applications-and-projects.md",{"type":236,"value":237,"toc":1466},"minimark",[238,242,247,250,321,324,328,339,347,357,614,632,637,799,803,809,863,866,870,876,922,938,947,951,965,1030,1165,1171,1193,1197,1200,1241,1429,1436,1440,1456,1462],[239,240,241],"p",{},"An application is the deployable unit in Kinotic. Projects are the building blocks that make up an application. This page explains how to configure both.",[243,244,246],"h2",{"id":245},"applications","Applications",[239,248,249],{},"Every application has:",[251,252,253,266,293,299],"ul",{},[254,255,256,260,261,265],"li",{},[257,258,259],"strong",{},"Name"," -- A human-readable name (e.g., ",[262,263,264],"code",{},"Inventory App",").",[254,267,268,271,272,275,276,280,281,284,285,288,289,292],{},[257,269,270],{},"Id"," -- Derived from the name at creation: the slugified name, made of lowercase letters, digits, and single interior dashes (e.g., ",[262,273,274],{},"inventory-app","). The id forms the final label of the application's ",[277,278,279],"a",{"href":206},"zone",", and joined to the organization id with ",[262,282,283],{},"--"," it forms the application's host label, ",[262,286,287],{},"\u003CorganizationId>--\u003CapplicationId>",". Each of its UIs' sites extends that label to ",[262,290,291],{},"\u003CorganizationId>--\u003CapplicationId>--\u003CuiName>",", which DNS limits to 63 characters, so a name that leaves no room for a UI name there is rejected.",[254,294,295,298],{},[257,296,297],{},"Description"," -- A human-readable summary of what the application does.",[254,300,301,304,305,308,309,312,313,316,317,320],{},[257,302,303],{},"Primary UI"," -- The name of the UI whose site the application's browser flows return to, chosen on the application's Settings page: OAuth consent opens its ",[262,306,307],{},"\u002Foauth\u002Fconsent"," page, and a sign-in an identity provider fails returns to its ",[262,310,311],{},"\u002Flogin"," page with an ",[262,314,315],{},"error"," parameter. Until one is chosen, the application's OAuth authorization endpoint answers ",[262,318,319],{},"400",". It must name a UI one of the application's projects has published; it stays set if that UI's deployment is later removed.",[239,322,323],{},"Applications are created and managed through the Kinotic CLI and the Kinotic OS dashboard.",[243,325,327],{"id":326},"projects","Projects",[239,329,330,331,334,335,338],{},"A project is a directory with its own ",[262,332,333],{},"package.json"," and a ",[262,336,337],{},".config\u002Fkinotic.config.ts"," configuration file. The CLI uses that config to understand how the project fits into the broader application.",[340,341,343,344,346],"h3",{"id":342},"the-configkinoticconfigts-file","The ",[262,345,337],{}," File",[239,348,349,350,352,353,356],{},"Every project carries a ",[262,351,337],{},", created when Kinotic OS provisions\nthe project repository. It is a TypeScript module exporting a ",[262,354,355],{},"KinoticProjectConfig",", so\nyour editor type-checks it:",[358,359,364],"pre",{"className":360,"code":361,"language":362,"meta":363,"style":363},"language-ts shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import type { KinoticProjectConfig } from '@kinotic-ai\u002Fmanagement-api'\n\nconst config: KinoticProjectConfig = {\n  organizationId: \"my-org\",\n  applicationId: \"my-app\",\n  projectId: \"my-app-main\",\n  entitiesPaths: [\n    {\n      path: \"packages\u002Fdomain\u002Fmodel\",\n      repositoryPath: \"packages\u002Fdomain\u002Frepositories\",\n      mirrorFolderStructure: true\n    }\n  ],\n  fileExtensionForImports: \".js\",\n  validate: false\n}\n\nexport default config\n","ts","",[262,365,366,402,409,431,452,469,486,497,503,520,537,549,555,563,580,591,597,602],{"__ignoreMap":363},[367,368,371,375,378,382,386,389,392,395,399],"span",{"class":369,"line":370},"line",1,[367,372,374],{"class":373},"s7zQu","import",[367,376,377],{"class":373}," type",[367,379,381],{"class":380},"sMK4o"," {",[367,383,385],{"class":384},"sTEyZ"," KinoticProjectConfig",[367,387,388],{"class":380}," }",[367,390,391],{"class":373}," from",[367,393,394],{"class":380}," '",[367,396,398],{"class":397},"sfazB","@kinotic-ai\u002Fmanagement-api",[367,400,401],{"class":380},"'\n",[367,403,405],{"class":369,"line":404},2,[367,406,408],{"emptyLinePlaceholder":407},true,"\n",[367,410,412,416,419,422,425,428],{"class":369,"line":411},3,[367,413,415],{"class":414},"spNyl","const",[367,417,418],{"class":384}," config",[367,420,421],{"class":380},":",[367,423,385],{"class":424},"sBMFI",[367,426,427],{"class":380}," =",[367,429,430],{"class":380}," {\n",[367,432,434,438,440,443,446,449],{"class":369,"line":433},4,[367,435,437],{"class":436},"swJcz","  organizationId",[367,439,421],{"class":380},[367,441,442],{"class":380}," \"",[367,444,445],{"class":397},"my-org",[367,447,448],{"class":380},"\"",[367,450,451],{"class":380},",\n",[367,453,455,458,460,462,465,467],{"class":369,"line":454},5,[367,456,457],{"class":436},"  applicationId",[367,459,421],{"class":380},[367,461,442],{"class":380},[367,463,464],{"class":397},"my-app",[367,466,448],{"class":380},[367,468,451],{"class":380},[367,470,472,475,477,479,482,484],{"class":369,"line":471},6,[367,473,474],{"class":436},"  projectId",[367,476,421],{"class":380},[367,478,442],{"class":380},[367,480,481],{"class":397},"my-app-main",[367,483,448],{"class":380},[367,485,451],{"class":380},[367,487,489,492,494],{"class":369,"line":488},7,[367,490,491],{"class":436},"  entitiesPaths",[367,493,421],{"class":380},[367,495,496],{"class":384}," [\n",[367,498,500],{"class":369,"li