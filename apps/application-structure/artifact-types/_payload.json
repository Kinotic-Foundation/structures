in Depth","\u002Fplatform\u002Fdefense-in-depth","02.platform\u002F06.defense-in-depth",{"title":176,"path":177,"stem":178,"icon":179},"MCP Tools","\u002Fplatform\u002Fmcp-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":181,"path":182,"stem":183,"icon":184},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":186,"path":187,"stem":188,"icon":189},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":191,"path":192,"stem":193,"icon":194},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":196,"path":197,"stem":198,"icon":199},"Service Call Liveness","\u002Fplatform\u002Fservice-call-liveness","02.platform\u002F11.service-call-liveness","i-lucide-heart-pulse",{"title":128,"icon":129,"path":201,"stem":202,"children":203,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F12.reference",[204,209,214],{"title":205,"path":206,"stem":207,"icon":208},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":210,"path":211,"stem":212,"icon":213},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","02.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":215,"path":216,"stem":217,"icon":151},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","02.platform\u002F12.reference\u002F03.project-publishing-design",{"id":219,"title":33,"body":220,"description":507,"extension":508,"links":509,"meta":510,"navigation":511,"path":34,"seo":512,"stem":35,"__hash__":513},"docs\u002F01.apps\u002F03.application-structure\u002F03.artifact-types.md",{"type":221,"value":222,"toc":497},"minimark",[223,232,236,239,244,268,273,284,287,291,298,302,310,314,329,332,336,339,343,351,355,363,367,370,374,379,383,388,392,395,399,404,408,416,420,423,494],[224,225,226,227,231],"p",{},"Every project in a Kinotic application contributes one or more ",[228,229,230],"strong",{},"artifacts",". An artifact is a typed output that the platform knows how to build, deploy, and manage. This page describes each artifact type and when to use it.",[233,234,59],"h2",{"id":235},"persistence",[224,237,238],{},"The most common starting point. A persistence artifact defines your domain models (entities) and gets auto-generated CRUD services in return.",[224,240,241],{},[228,242,243],{},"What you provide:",[245,246,247],"ul",{},[248,249,250,251,255,256,259,260,263,264,267],"li",{},"Entity classes decorated with ",[252,253,254],"code",{},"@Entity"," and field-level annotations like ",[252,257,258],{},"@NotNull",", ",[252,261,262],{},"@Precision",", and ",[252,265,266],{},"@AutoGeneratedId",".",[224,269,270],{},[228,271,272],{},"What the platform provides:",[245,274,275,278,281],{},[248,276,277],{},"Full CRUD operations (save, find, delete) with pagination and sorting.",[248,279,280],{},"Named queries derived from method naming conventions.",[248,282,283],{},"Automatic storage provisioning and indexing.",[224,285,286],{},"Persistence is typically the first artifact you create because it establishes the data model that the rest of the application builds on.",[233,288,290],{"id":289},"microservice","Microservice",[224,292,293,294,267],{},"A microservice artifact is long-running code that executes in a pod or VM. It publishes services that other parts of the application can discover and call through ",[295,296,297],"a",{"href":52},"service proxies",[224,299,300],{},[228,301,243],{},[245,303,304,307],{},[248,305,306],{},"TypeScript classes that implement your business logic.",[248,308,309],{},"Service interfaces that you want to expose to the rest of the application.",[224,311,312],{},[228,313,272],{},[245,315,316,319,326],{},[248,317,318],{},"Automatic service registration in the Service Directory.",[248,320,321,322,325],{},"Service discovery and zone-based routing so other projects can call your service through a ",[295,323,324],{"href":52},"service proxy"," with a simple function call.",[248,327,328],{},"Lifecycle management, scaling, and health monitoring.",[224,330,331],{},"Use a microservice when your logic goes beyond simple CRUD -- orchestrating across multiple entities, calling external APIs, or running long-lived workflows.",[233,333,335],{"id":334},"batch-job","Batch Job",[224,337,338],{},"A batch job artifact is code that runs on a schedule. It is ideal for periodic tasks like data aggregation, report generation, cleanup routines, or syncing with external systems.",[224,340,341],{},[228,342,243],{},[245,344,345,348],{},[248,346,347],{},"TypeScript code that performs the job.",[248,349,350],{},"A schedule definition (cron expression or interval).",[224,352,353],{},[228,354,272],{},[245,356,357,360],{},[248,358,359],{},"Scheduled execution with retry and failure handling.",[248,361,362],{},"Logging and observability for each run.",[233,364,366],{"id":365},"ui-component","UI Component",[224,368,369],{},"A UI component artifact produces reusable building blocks that can be shared across multiple frontends within the application. Think of it as an internal component library.",[224,371,372],{},[228,373,243],{},[245,375,376],{},[248,377,378],{},"Reusable UI components packaged for consumption by frontend projects.",[224,380,381],{},[228,382,272],{},[245,384,385],{},[248,386,387],{},"Versioning and distribution within the application.",[233,389,391],{"id":390},"frontend","Frontend",[224,393,394],{},"A frontend artifact is a complete user interface that gets deployed as a static site. It consumes services published by other projects in the application.",[224,396,397],{},[228,398,243],{},[245,400,401],{},[248,402,403],{},"A web application (built with any framework) that compiles to static assets.",[224,405,406],{},[228,407,272],{},[245,409,410,413],{},[248,411,412],{},"Static hosting with CDN distribution.",[248,414,415],{},"Automatic connection to the application's services through the Kinotic client libraries.",[233,417,419],{"id":418},"combining-artifact-types","Combining Artifact Types",[224,421,422],{},"Most real-world applications combine several artifact types. A typical setup might look like this:",[424,425,426,442],"table",{},[427,428,429],"thead",{},[430,431,432,436,439],"tr",{},[433,434,435],"th",{},"Project",[433,437,438],{},"Artifact Type",[433,440,441],{},"Role",[443,444,445,458,470,482],"tbody",{},[430,446,447,453,455],{},[448,449,450],"td",{},[252,451,452],{},"data",[448,454,59],{},[448,456,457],{},"Defines entities and provides auto-generated CRUD services",[430,459,460,465,467],{},[448,461,462],{},[252,463,464],{},"services",[448,466,290],{},[448,468,469],{},"Implements business rules that orchestrate across entities",[430,471,472,477,479],{},[448,473,474],{},[252,475,476],{},"jobs",[448,478,335],{},[448,480,481],{},"Runs nightly data aggregation",[430,483,484,489,491],{},[448,485,486],{},[252,487,488],{},"web",[448,490,391],{},[448,492,493],{},"The main user interface",[224,495,496],{},"Each project is independently developed and versioned, but they all deploy as part of the same application and communicate through the Service Directory.",{"title":498,"searchDepth":499,"depth":499,"links":500},"",2,[501,502,503,504,505,506],{"id":235,"depth":499,"text":59},{"id":289,"depth":499,"text":290},{"id":334,"depth":499,"text":335},{"id":365,"depth":499,"text":366},{"id":390,"depth":499,"text":391},{"id":418,"depth":499,"text":419},"Learn about the different artifact types a Kinotic project can contribute -- from persistence and microservices to frontends.","md",null,{},true,{"title":33,"description":507},"ks4mH_HWM4uaDA9Vwx-yIdl366mKkKWDw9PgfC_UDoU",[515,517],{"title":29,"path":30,"stem":31,"description":516,"children":-1},"Learn how to configure Kinotic applications and the projects that compose them.",{"title":25,"path":44,"stem":45,"description":518,"children":-1},"How services work in Kinotic and the communication patterns they support.",1788936693677]