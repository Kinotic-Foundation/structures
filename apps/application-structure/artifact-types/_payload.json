3},"Defense in Depth","\u002Fplatform\u002Fdefense-in-depth","02.platform\u002F06.defense-in-depth",{"title":176,"path":177,"stem":178,"icon":179},"MCP Tools","\u002Fplatform\u002Fmcp-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":181,"path":182,"stem":183,"icon":184},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":186,"path":187,"stem":188,"icon":189},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":191,"path":192,"stem":193,"icon":194},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":196,"path":197,"stem":198,"icon":199},"Service Call Liveness","\u002Fplatform\u002Fservice-call-liveness","02.platform\u002F11.service-call-liveness","i-lucide-heart-pulse",{"title":128,"icon":129,"path":201,"stem":202,"children":203,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F12.reference",[204,209,214],{"title":205,"path":206,"stem":207,"icon":208},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":210,"path":211,"stem":212,"icon":213},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","02.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":215,"path":216,"stem":217,"icon":151},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","02.platform\u002F12.reference\u002F03.project-publishing-design",{"title":219,"path":220,"stem":221,"icon":222},"Development Server","\u002Fplatform\u002Fdevelopment-server","02.platform\u002F13.development-server","i-lucide-server-cog",{"title":224,"path":225,"stem":226,"icon":227},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","02.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":229,"path":230,"stem":231,"icon":232},"Enterprise License","\u002Fplatform\u002Fenterprise-license","02.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":234,"title":33,"body":235,"description":522,"extension":523,"links":524,"meta":525,"navigation":526,"path":34,"seo":527,"stem":35,"__hash__":528},"docs\u002F01.apps\u002F03.application-structure\u002F03.artifact-types.md",{"type":236,"value":237,"toc":512},"minimark",[238,247,251,254,259,283,288,299,302,306,313,317,325,329,344,347,351,354,358,366,370,378,382,385,389,394,398,403,407,410,414,419,423,431,435,438,509],[239,240,241,242,246],"p",{},"Every project in a Kinotic application contributes one or more ",[243,244,245],"strong",{},"artifacts",". An artifact is a typed output that the platform knows how to build, deploy, and manage. This page describes each artifact type and when to use it.",[248,249,59],"h2",{"id":250},"persistence",[239,252,253],{},"The most common starting point. A persistence artifact defines your domain models (entities) and gets auto-generated CRUD services in return.",[239,255,256],{},[243,257,258],{},"What you provide:",[260,261,262],"ul",{},[263,264,265,266,270,271,274,275,278,279,282],"li",{},"Entity classes decorated with ",[267,268,269],"code",{},"@Entity"," and field-level annotations like ",[267,272,273],{},"@NotNull",", ",[267,276,277],{},"@Precision",", and ",[267,280,281],{},"@AutoGeneratedId",".",[239,284,285],{},[243,286,287],{},"What the platform provides:",[260,289,290,293,296],{},[263,291,292],{},"Full CRUD operations (save, find, delete) with pagination and sorting.",[263,294,295],{},"Named queries derived from method naming conventions.",[263,297,298],{},"Automatic storage provisioning and indexing.",[239,300,301],{},"Persistence is typically the first artifact you create because it establishes the data model that the rest of the application builds on.",[248,303,305],{"id":304},"microservice","Microservice",[239,307,308,309,282],{},"A microservice artifact is long-running code that executes in a pod or VM. It publishes services that other parts of the application can discover and call through ",[310,311,312],"a",{"href":52},"service proxies",[239,314,315],{},[243,316,258],{},[260,318,319,322],{},[263,320,321],{},"TypeScript classes that implement your business logic.",[263,323,324],{},"Service interfaces that you want to expose to the rest of the application.",[239,326,327],{},[243,328,287],{},[260,330,331,334,341],{},[263,332,333],{},"Automatic service registration in the Service Directory.",[263,335,336,337,340],{},"Service discovery and zone-based routing so other projects can call your service through a ",[310,338,339],{"href":52},"service proxy"," with a simple function call.",[263,342,343],{},"Lifecycle management, scaling, and health monitoring.",[239,345,346],{},"Use a microservice when your logic goes beyond simple CRUD -- orchestrating across multiple entities, calling external APIs, or running long-lived workflows.",[248,348,350],{"id":349},"batch-job","Batch Job",[239,352,353],{},"A batch job artifact is code that runs on a schedule. It is ideal for periodic tasks like data aggregation, report generation, cleanup routines, or syncing with external systems.",[239,355,356],{},[243,357,258],{},[260,359,360,363],{},[263,361,362],{},"TypeScript code that performs the job.",[263,364,365],{},"A schedule definition (cron expression or interval).",[239,367,368],{},[243,369,287],{},[260,371,372,375],{},[263,373,374],{},"Scheduled execution with retry and failure handling.",[263,376,377],{},"Logging and observability for each run.",[248,379,381],{"id":380},"ui-component","UI Component",[239,383,384],{},"A UI component artifact produces reusable building blocks that can be shared across multiple frontends within the application. Think of it as an internal component library.",[239,386,387],{},[243,388,258],{},[260,390,391],{},[263,392,393],{},"Reusable UI components packaged for consumption by frontend projects.",[239,395,396],{},[243,397,287],{},[260,399,400],{},[263,401,402],{},"Versioning and distribution within the application.",[248,404,406],{"id":405},"frontend","Frontend",[239,408,409],{},"A frontend artifact is a complete user interface that gets deployed as a static site. It consumes services published by other projects in the application.",[239,411,412],{},[243,413,258],{},[260,415,416],{},[263,417,418],{},"A web application (built with any framework) that compiles to static assets.",[239,420,421],{},[243,422,287],{},[260,424,425,428],{},[263,426,427],{},"Static hosting with CDN distribution.",[263,429,430],{},"Automatic connection to the application's services through the Kinotic client libraries.",[248,432,434],{"id":433},"combining-artifact-types","Combining Artifact Types",[239,436,437],{},"Most real-world applications combine several artifact types. A typical setup might look like this:",[439,440,441,457],"table",{},[442,443,444],"thead",{},[445,446,447,451,454],"tr",{},[448,449,450],"th",{},"Project",[448,452,453],{},"Artifact Type",[448,455,456],{},"Role",[458,459,460,473,485,497],"tbody",{},[445,461,462,468,470],{},[463,464,465],"td",{},[267,466,467],{},"data",[463,469,59],{},[463,471,472],{},"Defines entities and provides auto-generated CRUD services",[445,474,475,480,482],{},[463,476,477],{},[267,478,479],{},"services",[463,481,305],{},[463,483,484],{},"Implements business rules that orchestrate across entities",[445,486,487,492,494],{},[463,488,489],{},[267,490,491],{},"jobs",[463,493,350],{},[463,495,496],{},"Runs nightly data aggregation",[445,498,499,504,506],{},[463,500,501],{},[267,502,503],{},"web",[463,505,406],{},[463,507,508],{},"The main user interface",[239,510,511],{},"Each project is independently developed and versioned, but they all deploy as part of the same application and communicate through the Service Directory.",{"title":513,"searchDepth":514,"depth":514,"links":515},"",2,[516,517,518,519,520,521],{"id":250,"depth":514,"text":59},{"id":304,"depth":514,"text":305},{"id":349,"depth":514,"text":350},{"id":380,"depth":514,"text":381},{"id":405,"depth":514,"text":406},{"id":433,"depth":514,"text":434},"Learn about the different artifact types a Kinotic project can contribute -- from persistence and microservices to frontends.","md",null,{},true,{"title":33,"description":522},"ks4mH_HWM4uaDA9Vwx-yIdl366mKkKWDw9PgfC_UDoU",[530,532],{"title":29,"path":30,"stem":31,"description":531,"children":-1},"Learn how to configure Kinotic applications and the projects that compose them.",{"title":25,"path":44,"stem":45,"description":533,"children":-1},"How services work in Kinotic and the communication patterns they support.",1792489713177]