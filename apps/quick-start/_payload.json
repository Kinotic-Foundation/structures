"line":543},12,[291,545,546],{"class":482},"    lastName",[291,548,368],{"class":305},[291,550,488],{"class":297},[291,552,497],{"class":305},[291,554,528],{"class":305},[291,556,558],{"class":293,"line":557},13,[291,559,434],{"emptyLinePlaceholder":433},[291,561,563,565,568,571,573],{"class":293,"line":562},14,[291,564,473],{"class":305},[291,566,567],{"class":322},"Precision",[291,569,570],{"class":312},"(PrecisionType",[291,572,357],{"class":305},[291,574,575],{"class":312},"SHORT)\n",[291,577,579,582,584,587,589],{"class":293,"line":578},15,[291,580,581],{"class":482},"    age",[291,583,368],{"class":305},[291,585,586],{"class":297}," number",[291,588,497],{"class":305},[291,590,592],{"class":591},"sbssI"," 0\n",[291,594,596],{"class":293,"line":595},16,[291,597,598],{"class":305},"}\n",[224,600,601],{},"A few things to note:",[233,603,604,610,616,622],{},[236,605,606,609],{},[273,607,608],{},"@Entity(MultiTenancyType.NONE)"," marks the class as a persisted entity with no multi-tenancy.",[236,611,612,615],{},[273,613,614],{},"@AutoGeneratedId"," tells the platform to generate an ID when one is not provided.",[236,617,618,621],{},[273,619,620],{},"@NotNull"," enforces that a field must have a value.",[236,623,624,627],{},[273,625,626],{},"@Precision(PrecisionType.SHORT)"," tells the platform this number is a short integer, which influences how it is stored and indexed.",[228,629,631],{"id":630},"generate-the-repository","Generate the Repository",[266,633,635],{"className":285,"code":634,"language":287,"meta":275,"style":275},"bun run generate\nbun run type-check\n",[273,636,637,647],{"__ignoreMap":275},[291,638,639,641,644],{"class":293,"line":294},[291,640,339],{"class":297},[291,642,643],{"class":301}," run",[291,645,646],{"class":301}," generate\n",[291,648,649,651,653],{"class":293,"line":336},[291,650,339],{"class":297},[291,652,643],{"class":301},[291,654,655],{"class":301}," type-check\n",[224,657,658,659,662,663,666],{},"This writes ",[273,660,661],{},"pa