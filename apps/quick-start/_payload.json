e Repository",[281,648,650],{"className":300,"code":649,"language":302,"meta":290,"style":290},"bun run generate\nbun run type-check\n",[288,651,652,662],{"__ignoreMap":290},[306,653,654,656,659],{"class":308,"line":309},[306,655,354],{"class":312},[306,657,658],{"class":316}," run",[306,660,661],{"class":316}," generate\n",[306,663,664,666,668],{"class":308,"line":351},[306,665,354],{"class":312},[306,667,658],{"class":316},[306,669,670],{"class":316}," type-check\n",[239,672,673,674,677,678,681],{},"This writes ",[288,675,676],{},"packages\u002Fdomain\u002Frepositories\u002FPersonRepository.ts"," (yours to extend) along with a generated base class, and saves the entity's schema under ",[288,679,680],{},".config\u002Fc3\u002F",". Export both from the domain package's entry so other packages can import them:",[281,683,685],{"className":386,"code":684,"language":388,"meta":290,"style":290},"\u002F\u002F packages\u002Fdomain\u002Findex.ts\nexport * from '.\u002Fmodel\u002FPerson.js'\nexport * from '.\u002Frepositories\u002FPersonRepository.js'\n",[288,686,687,693,709],{"__ignoreMap":290},[306,688,689],{"class":308,"line":309},[306,690,692],{"class":691},"sHwdD","\u002F\u002F packages\u002Fdomain\u002Findex.ts\n",[306,694,695,697,700,702,704,707],{"class":308,"line":351},[306,696,472],{"class":395},[306,698,699],{"class":320}," *",[306,701,434],{"class":395},[306,703,437],{"class":320},[306,705,706],{"class":316},".\u002Fmodel\u002FPerson.js",[306,708,443],{"class":320},[306,710,711,713,715,717,719,722],{"class":308,"line":452},[306,712,472],{"class":395},[306,714,699],{"class":320},[306,716,434],{"class":395},[306,718,437],{"class":320},[306,720,721],{"class":316},".\u002Frepositories\u002FPersonRepository.js",[306,723,443],{"class":320},[243,725,727],{"id":726},"push-to-sync","Push to Sync",[281,729,731],{"className":300,"code":730,"language":302,"meta":290,"style":290},"git add . && git commit -m \"Add Person entity\" && git push\n",[288,732,733],{"__ignoreMap":290},[306,734,735,737,740,743,745,748,751,754,757,760,763,765,767],{"class":308,"line":309},[306,736,313],{"class":312},[306,738,739],{"class":316}," add",[306,741,742],{"class":316}," .",[306,744,334],{"class":320},[306,746,747],{"class":312}," git",[306,749,750],{"class":316}," commit",[306,752,753],{"class":316}," -m",[306,755,756],{"class":320}," \"",[306,758,759],{"class":316},"Add Person entity",[306,761,762],{"class":320},"\"",[306,764,334],{"class":320},[306,766,747],{"class":312},[306,768,769],{"class":316}," push\n",[239,771,772],{},"Kinotic OS reads entity definitions from the connected GitHub repository and synchronizes them for you -- publishing the entity creates the backing storage and registers its services. There is nothing to log in to or push from your machine besides git.",[243,774,776],{"id":775},"use-the-generated-repository","Use the Generated Repository",[239,778,779,780,783,784,787],{},"The provisioned repository ships a starter microservice at ",[288,781,782],{},"packages\u002Fmicroservices\u002Fmain"," that already sets the zone and connects. Extend its ",[288,785,786],{},"src\u002Fmain.ts"," to try the repository out:",[281,789,791],{"className":386,"code":790,"language":388,"meta":290,"style":290},"import { Kinotic, Pageable } from '@kinotic-ai\u002Fcore'\nimport { PersistencePlugin } from '@kinotic-ai\u002Fpersistence'\nimport { PersonRepository } from '@my-app\u002Fdomain'\nimport { appZone } from '@kinotic-ai\u002Fmanagement-api'\nimport config from '..\u002F..\u002F..\u002F..\u002F.config\u002Fkinotic.config'\n\nKinotic.use(PersistencePlugin)\nKinotic.zonePrefix = appZone(config.organizationId, config.applicationId)\n\n\u002F\u002F server and credentials resolve from the environment: KINOTIC_SERVER_HOST\u002FPORT\u002FUSE_SSL,\n\u002F\u002F KINOTIC_CLIENT_ID\u002FKINOTIC_CLIENT_SECRET, which a deployment sets to the app server and the\n\u002F\u002F microservice's own machine identity. With nothing set it dials https:\u002F\u002Fapi.kinotic.ai, the org\n\u002F\u002F server, which admits no runtime\nawait Kinotic.connect()\n\nconst personRepository = new PersonRepository()\n\n\u002F\u002F Create a person\nconst person = await personRepository.save({\n    id: null,\n    firstName: 'Jane',\n    lastName: 'Doe',\n    age: 28\n})\n\nconsole.log('Saved:', person)\n\n\u002F\u002F Find all people\nconst page = await personRepository.findAll(Pageable.create(0, 10))\nconsole.log('People:', page.content)\n",[288,792,793,818,837,857,877,894,898,911,943,947,952,957,962,967,982,986,1003,1008,1014,1041,1051,1069,1085,1095,1104,1109,1134,1139,1145,1185],{"__ignoreMap":290},[306,794,795,797,799,802,804,807,809,811,813,816],{"class":308,"line":309},[306,796,396],{"class":395},[306,798,399],{"class":320},[306,800,801],{"class":327}," Kinotic",[306,803,405],{"class":320},[306,805,806],{"class":327}," Pageable",[306,808,431],{"class":320},[306,810,434],{"class":395},[306,812,437],{"class":320},[306,814,815],{"class":316},"@kinotic-ai\u002Fcore",[306,817,443],{"class":320},[306,819,820,822,824,827,829,831,833,835],{"class":308,"line":351},[306,821,396],{"class":395},[306,823,399],{"class":320},[306,825,826],{"class":327}," PersistencePlugin",[306,828,431],{"class":320},[306,830,434],{"class":395},[306,832,437],{"class":320},[306,834,440],{"class":316},[306,836,443],{"class":320},[306,838,839,841,843,846,848,850,852,855],{"class":308,"line":452},[306,840,396],{"class":395},[306,842,399],{"class":320},[306,844,845],{"class":327}," PersonRepository",[306,847,431],{"class":320},[306,849,434],{"class":395},[306,851,437],{"class":320},[306,853,854],{"class":316},"@my-app\u002Fdomain",[306,856,443],{"class":320},[306,858,859,861,863,866,868,870,872,875],{"class":308,"line":469},[306,860,396],{"class":395},[306,862,399],{"class":320},[306,864,865],{"class":327}," appZone",[306,867,431],{"class":320},[306,869,434],{"class":395},[306,871,437],{"class":320},[306,873,874],{"class":316},"@kinotic-ai\u002Fmanagement-api",[306,876,443]