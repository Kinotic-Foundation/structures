rise License","\u002Fplatform\u002Fenterprise-license","02.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":234,"title":51,"body":235,"description":954,"extension":955,"links":956,"meta":957,"navigation":362,"path":52,"seo":958,"stem":53,"__hash__":959},"docs\u002F01.apps\u002F04.services\u002F03.service-proxies.md",{"type":236,"value":237,"toc":947},"minimark",[238,242,247,250,278,283,719,723,883,887,890,943],[239,240,241],"p",{},"Service proxies let you call remote services as if they were local objects. You define a typed interface, create a class that implements it, and delegate calls to the remote service through the Kinotic connection.",[243,244,246],"h2",{"id":245},"writing-a-service-proxy","Writing a Service Proxy",[239,248,249],{},"The pattern is:",[251,252,253,257,260,267],"ol",{},[254,255,256],"li",{},"Define an interface describing the service methods",[254,258,259],{},"Create a class that implements the interface",[254,261,262,263],{},"In the constructor, obtain a proxy via ",[264,265,266],"code",{},"kinotic.serviceProxy()",[254,268,269,270,273,274,277],{},"Implement methods by calling ",[264,271,272],{},"invoke()"," or ",[264,275,276],{},"invokeStream()"," on the proxy",[279,280,282],"h3",{"id":281},"example","Example",[284,285,290],"pre",{"className":286,"code":287,"language":288,"meta":289,"style":289},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import type { IKinotic, IServiceProxy } from '@kinotic-ai\u002Fcore'\nimport type { Observable } from 'rxjs'\n\nexport interface INotificationService {\n    sendAlert(message: string): Promise\u003Cvoid>\n    watchAlerts(severity: string): Observable\u003CAlert>\n}\n\nexport class NotificationService implements INotificationService {\n\n    private readonly serviceProxy: IServiceProxy\n\n    constructor(kinotic: IKinotic) {\n        \u002F\u002F A proxy targets the service's full address, including its zone (see CRI Format).\n        \u002F\u002F A platform service is reached in management-api or app-api; an application's own service\n        \u002F\u002F is reached in its app zone, e.g. app.acme-org.orders-app~com.example.NotificationService\n        this.serviceProxy = kinotic.serviceProxy('app.acme-org.orders-app~com.example.NotificationService')\n    }\n\n    sendAlert(message: string): Promise\u003Cvoid> {\n        return this.serviceProxy.invoke('sendAlert', [message])\n    }\n\n    watchAlerts(severity: string): Observable\u003CAlert> {\n        return this.serviceProxy.invokeStream('watchAlerts', [severity])\n    }\n}\n","typescript","",[264,291,292,334,357,364,381,416,442,448,453,471,476,493,498,518,525,531,537,571,577,582,608,643,648,653,678,709,714],{"__ignoreMap":289},[293,294,297,301,304,308,312,315,318,321,324,327,331],"span",{"class":295,"line":296},"line",1,[293,298,300],{"class":299},"s7zQu","import",[293,302,303],{"class":299}," type",[293,305,307],{"class":306},"sMK4o"," {",[293,309,311],{"class":310},"sTEyZ"," IKinotic",[293,313,314],{"class":306},",",[293,316,317],{"class":310}," IServiceProxy",[293,319,320],{"class":306}," }",[293,322,323],{"class":299}," from",[293,325,326],{"class":306}," '",[293,328,330],{"class":329},"sfazB","@kinotic-ai\u002Fcore",[293,332,333],{"class":306},"'\n",[293,335,337,339,341,343,346,348,350,352,355],{"class":295,"line":336},2,[293,338,300],{"class":299},[293,340,303],{"class":299},[293,342,307],{"class":306},[293,344,345],{"class":310}," Observable",[293,347,320],{"class":306},[293,349,323],{"class":299},[293,351,326],{"class":306},[293,353,354],{"class":329},"rxjs",[293,356,333],{"class":306},[293,358,360],{"class":295,"line":359},3,[293,361,363],{"emptyLinePlaceholder":362},true,"\n",[293,365,367,370,374,378],{"class":295,"line":366},4,[293,368,369],{"class":299},"export",[293,371,373],{"class":372},"spNyl"," interface",[293,375,377],{"class":376},"sBMFI"," INotificationService",[293,379,380],{"class":306}," {\n",[293,382,384,388,391,395,