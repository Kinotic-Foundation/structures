gateway rejects any send or subscribe outside the zones the authenticated participant may address, so a wrong or missing zone routes nowhere — it can never reach another application.",[251,848,850],{"id":849},"registering-on-a-specific-client","Registering on a specific client",[239,852,853,855,856,858,859,862,863,866,867,870],{},[243,854,245],{}," registers every instance with the global ",[243,857,593],{}," client. A service hosted on a client you created yourself — a second ",[243,860,861],{},"KinoticSingleton",", connected under its own credentials or to another server — is registered through that client's ",[243,864,865],{},"serviceRegistry"," with a ",[243,868,869],{},"ServiceIdentifier"," naming the namespace, the service name, and the full zone:",[256,872,874],{"className":258,"code":873,"language":260,"meta":261,"style":261},"import { KinoticSingleton, ServiceIdentifier } from '@kinotic-ai\u002Fcore'\n\nconst host = new KinoticSingleton()\nawait host.connect({ server: { host: 'localhost', port: 58505 }, credentials })   \u002F\u002F the app server\n\nconst identifier = new ServiceIdentifier('com.example', 'GreetingService', 'app.acme-org.orders-app')\nhost.serviceRegistry.register(identifier, new GreetingService())   \u002F\u002F → srv:\u002F\u002Fapp.acme-org.orders-app~com.example.GreetingService\n\n\u002F\u002F later, when the service should no longer be reachable\nhost.serviceRegistry.unRegister(identifier)\n",[243,875,876,900,904,921,981,985,1026,1055,1059,1064],{"__ignoreMap":261},[265,877,878,880,882,885,887,890,892,894,896,898],{"class":267,"line":268},[265,879,272],{"class":271},[265,881,276],{"class":275},[265,883,884],{"class":279}," KinoticSingleton",[265,886,283],{"class":275},[265,888,889],{"class":279}," ServiceIdentifier",[265,891,289],{"class":275},[265,893,292],{"class":271},[265,895,295],{"class":275},[265,897,299],{"class":298},[265,899,302],{"class":275},[265,901,902],{"class":267,"line":305},[265,903,309],{"emptyLinePlaceholder":308},[