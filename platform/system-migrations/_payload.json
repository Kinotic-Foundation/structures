latform\u002Fdefense-in-depth","02.platform\u002F06.defense-in-depth",{"title":176,"path":177,"stem":178,"icon":179},"MCP Tools","\u002Fplatform\u002Fmcp-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":181,"path":182,"stem":183,"icon":184},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":186,"path":187,"stem":188,"icon":189},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":191,"path":192,"stem":193,"icon":194},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":196,"path":197,"stem":198,"icon":199},"Service Call Liveness","\u002Fplatform\u002Fservice-call-liveness","02.platform\u002F11.service-call-liveness","i-lucide-heart-pulse",{"title":128,"icon":129,"path":201,"stem":202,"children":203,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F12.reference",[204,209,214],{"title":205,"path":206,"stem":207,"icon":208},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":210,"path":211,"stem":212,"icon":213},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","02.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":215,"path":216,"stem":217,"icon":151},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","02.platform\u002F12.reference\u002F03.project-publishing-design",{"title":219,"path":220,"stem":221,"icon":222},"Development Server","\u002Fplatform\u002Fdevelopment-server","02.platform\u002F13.development-server","i-lucide-server-cog",{"title":224,"path":225,"stem":226,"icon":227},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","02.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":229,"path":230,"stem":231,"icon":232},"Enterprise License","\u002Fplatform\u002Fenterprise-license","02.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":234,"title":191,"body":235,"description":851,"extension":852,"links":853,"meta":854,"navigation":855,"path":192,"seo":856,"stem":193,"__hash__":857},"docs\u002F02.platform\u002F10.system-migrations.md",{"type":236,"value":237,"toc":838},"minimark",[238,247,252,255,267,271,279,283,286,302,307,310,363,377,482,485,500,506,510,525,535,539,553,583,599,607,627,645,692,706,717,751,769,799,815,819,834],[239,240,241,242,246],"p",{},"The Kinotic platform uses the same migration SQL system as application developers to manage its own internal Elasticsearch indices. This page covers considerations specific to platform development — for general migration syntax, see ",[243,244,245],"a",{"href":89},"App Migrations",".",[248,249,251],"h2",{"id":250},"what-are-system-migrations","What Are System Migrations?",[239,253,254],{},"System migrations define and evolve the indices that the platform itself relies on — things like migration history tracking, system configuration, and other internal data stores. They run during platform startup before any application migrations and are scoped to the system project rather than a per-application project.",[239,256,257,258,262,263,266],{},"System migrations live in ",[259,260,261],"code",{},"kinotic-migration\u002Fsrc\u002Fmain\u002Fresources\u002Fmigrations\u002F"," and follow the same ",[259,264,265],{},"V\u003CN>__\u003Cdescription>.sql"," naming convention.",[248,268,270],{"id":269},"using-composite-types-in-system-indices","Using Composite Types in System Indices",[239,272,273,274,278],{},"OBJECT, NESTED, and UNION columns work the same way in system migrations as in application migrations. Refer to the ",[243,275,277],{"href":276},"\u002Fapps\u002Fpersistence\u002Fmigrations#composite-column-types","Composite Column Types"," section of the app documentation for syntax and examples.",[248,280,282],{"id":281},"deserializing-union-types","Deserializing Union Types",[239,284,285],{},"Elasticsearch stores UNION fields as a flat merged object — it has no knowledge of which variant a document contains. When reading documents back into Java, the platform needs to route deserialization to the correct subclass.",[239,287,288,289,293,294,297,298,301],{},"The standard approach is Jackson's polymorphic type handling, driven by a ",[290,291,292],"strong",{},"discriminator field"," stored in the document. This is the same ",[259,295,296],{},"kind"," (or similar) ",[259,299,300],{},"KEYWORD"," field you include in each union variant in the migration SQL.",[303,304,306],"h3",{"id":305},"example","Example",[239,308,309],{},"Given this migration:",[311,312,317],"pre",{"className":313,"code":314,"language":315,"meta":316,"style":316},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","CREATE TABLE assets (\n    id KEYWORD,\n    item UNION (\n        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n        Video (kind KEYWORD, title TEXT, duration INTEGER)\n    )\n);\n","sql","",[259,318,319,327,333,339,345,351,357],{"__ignoreMap":316},[320,321,324],"span",{"class":322,"line":323},"line",1,[320,325,326],{},"CREATE TABLE assets (\n",[320,328,330],{"class":322,"line":329},2,[320,331,332],{},"    id KEYWORD,\n",[320,334,336],{"class":322,"line":335},3,[320,337,338],{},"    item UNION (\n",[320,340,342],{"class":322,"line":341},4,[320,343,344],{},"        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n",[320,346,348],{"class":322,"line":347},5,[320,349,350],{},"        Video (kind KEYWORD, title TEXT, duration INTEGER)\n",[320,352,354],{"class":322,"line":353},6,[320,355,356],{},"    )\n",[320,358,360],{"class":322,"line":359},7,[320,361,362],{},");\n",[239,364,365,366,369,370,373,374,376],{},"The corresponding Java model uses ",[259,367,368],{},"@JsonTypeInfo"," and ",[259,371,372],{},"@JsonSubTypes"," to map the ",[259,375,296],{}," field value to the correct subclass:",[311,378,382],{"className":379,"code":380,"language":381,"meta":316,"style":316},"language-java shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","@JsonTypeInfo(use = JsonTypeInfo.Id.NAME, property = \"kind\")\n@JsonSubTypes({\n    @JsonSubTypes.Type(value = Book.class,  name = \"Book\"),\n    @JsonSubTypes.Type(value = Video.class, name = \"Video\")\n})\npublic abstract class Item {}\n\npublic class Book extends Item {\n    public String kind;\n    public String title;\n    public String isbn;\n}\n\npublic class Video extends Item {\n    public String kind;\n    public String title;\n    public Integer duration;\n}\n","java",[259,383,384,389,394,399,404,409,414,420,426,432,438,444,450,455,461,466,471,477],{"__ignoreMap":316},[320,385,386],{"class":322,"line":323},[320,387,388],{},"@JsonTypeInfo(use = JsonTypeInfo.Id.NAME, property = \"kind\")\n",[320,390,391],{"class":322,"line":329},[320,392,393],{},"@JsonSubTypes({\n",[320,395,396],{"class":322,"line":335},[320,397,398],{},"    @JsonSubTypes.Type(value = Book.class,  name = \"Book\"),\n",[320,400,401],{"class":322,"line":341},[320,402,403],{},"    @JsonSubTypes.Type(value = Video.class, name = \"Video\")\n",[320,405,406],{"class":322,"line":347},[320,407,408],{},"})\n",[320,410,411],{"class":322,"line":353},[320,412,413],{},"public abstract class Item {}\n",[320,415,416],{"class":322,"line":359},[320,417,419],{"emptyLinePlaceholder":418},true,"\n",[320,421,423],{"class":322,"line":422},8,[320,424,425],{},"public class Book extends Item {\n",[320,427,429],{"class":322,"line":428},9,[320,430,431],{},"    public String kind;\n",[320,433,435],{"class":322,"line":434},10,[320,436,437],{},"    public String title;\n",[320,439,441],{"class":322,"line":440},11,[320,442,443],{},"    public String isbn;\n",[320,445,447],{"class":322,"line":446},12,[320,448,449],{},"}\n",[320,451,453],{"class":322,"line":452},13,[320,454,419],{"emptyLinePlaceholder":418},[320,456,458],{"class":322,"line":457},14,[320,459,460],{},"public class Video extends Item {\n",[320,462,464],{"class":322,"line":463},15,[320,465,431],{},[320,467,469],{"class":322,"line":468},16,[320,470,437],{},[320,472,474],{"class":322,"line":473},17,[320,475,476],{},"    public Integer duration;\n",[320,478,480],{"class":322,"line":479},18,[320,481,449],{},[239,483,484],{},"When inserting documents, always write the discriminator value:",[311,486,488],{"className":313,"code":487,"language":315,"meta":316,"style":316},"INSERT INTO assets (id, item)\n    VALUES ('a1', { kind: 'Book', title: 'Clean Code', isbn: '978-0132350884' }) WITH REFRESH;\n",[259,489,490,495],{"__ignoreMap":316},[320,491,492],{"class":322,"line":323},[320,493,494],{},"INSERT INTO assets (id, item)\n",[320,496,497],{"class":322,"line":329},[320,498,499],{},"    VALUES ('a1', { kind: 'Book', title: 'Clean Code', isbn: '978-0132350884' }) WITH REFRESH;\n",[239,501,502,503,505],{},"If the ",[259,504,296],{}," field is absent from a stored document, Jackson will fail to deserialize it. Ensure every INSERT that targets a UNION field includes the discriminator.",[303,507,509],{"id":508},"conflict-validation","Conflict validation",[239,511,512,513,516,517,520,521,524],{},"If two variants declare the same field name with different scalar types — e.g. ",[259,514,515],{},"title TEXT"," in one variant and ",[259,518,519],{},"title KEYWORD"," in another — the migration executor will throw an ",[259,522,523],{},"IllegalArgumentException"," at mapping time. Fields shared across variants must have identical types.",[239,526,527,530,531,534],{},[290,528,529],{},"Known limitation:"," Conflict detection is shallow for composite types. If two variants share a field name with the same composite type (OBJECT, NESTED, or UNION) but different sub-fields, no exception is thrown — only the first variant's sub-field definitions are used and the second's are silently dropped. Until named type support is added to the migration DSL, avoid sharing composite-typed fields across variants. Scalar shared fields (such as a ",[259,532,533],{},"kind KEYWORD"," discriminator) are always safe.",[248,536,538],{"id":537},"data-streams","Data Streams",[239,540,541,542,545,546,552],{},"System data that is append-only and time-series — audit trails, events, telemetry — should be backed by an Elasticsearch ",[290,543,544],{},"data stream"," rather than a regular index, so old data ages out and backing indices roll over automatically. Create one from a migration with ",[243,547,549],{"href":548},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#create-data-stream",[259,550,551],{},"CREATE DATA STREAM",":",[311,554,556],{"className":313,"code":555,"language":315,"meta":316,"style":316},"CREATE DATA STREAM system_audit (\n    actor  KEYWORD,\n    action KEYWORD,\n    detail TEXT\n) WITH (DATA_RETENTION = '90d') ;\n",[259,557,558,563,568,573,578],{"__ignoreMap":316},[320,559,560],{"class":322,"line":323},[320,561,562],{},"CREATE DATA STREAM system_audit (\n",[320,564,565],{"class":322,"line":329},[320,566,567],{},"    actor  KEYWORD,\n",[320,569,570],{"class":322,"line":335},[320,571,572],{},"    action KEYWORD,\n",[320,574,575],{"class":322,"line":341},[320,576,577],{},"    detail TEXT\n",[320,579,580],{"class":322,"line":347},[320,581,582],{},") WITH (DATA_RETENTION = '90d') ;\n",[239,584,585,588,589,595,596,598],{},[259,586,587],{},"DATA_RETENTION"," is the native ",[243,590,594],{"href":591,"rel":592},"https:\u002F\u002Fwww.elastic.co\u002Fdocs\u002Fmanage-data\u002Flifecycle\u002Fdata-stream",[593],"nofollow","data stream lifecycle"," — Elasticsearch deletes data past the period (measured per backing index from rollover, not per document). See the ",[243,597,139],{"href":548}," for the full statement and the exact retention semantics.",[303,600,602,603,606],{"id":601},"every-document-needs-a-timestamp-and-java-needs-ceremony-for-it","Every document needs a ",[259,604,605],{},"@timestamp"," — and Java needs ceremony for it",[239,608,609,610,613,614,616,617,620,621,623,624,626],{},"Elasticsearch ",[290,611,612],{},"requires"," every document written to a data stream to carry a ",[259,615,605],{}," date field, and rejects any that don't with ",[259,618,619],{},"data stream timestamp field [@timestamp] is missing",". The migration adds ",[259,622,605],{}," to the mapping automatically — you neither declare it as a column nor can you, since ",[259,625,605],{}," is not a legal column identifier.",[239,628,629,630,633,634,636,637,640,641,644],{},"The catch is on the ",[290,631,632],{},"write"," side: ",[259,635,605],{}," is also not a legal Java field name, so a system DTO cannot carry it directly. Bridge it with Jackson's ",[259,638,639],{},"@JsonProperty"," — the ",[259,642,643],{},"ElasticsearchAsyncClient"," serializes through a Jackson mapper, so the annotation is honored on both write and read:",[311,646,648],{"className":379,"code":647,"language":381,"meta":316,"style":316},"public class AuditEvent {\n    private String  id;\n\n    @JsonProperty(\"@timestamp\")      \u002F\u002F Java field `timestamp` ⇄ Elasticsearch field `@timestamp`\n    private Instant timestamp;\n\n    private String  actor;\n    private String  action;\n}\n",[259,649,650,655,660,664,669,674,678,683,688],{"__ignoreMap":316},[320,651,652],{"class":322,"line":323},[320,653,654],{},"public class AuditEvent {\n",[320,656,657],{"class":322,"line":329},[320,658,659],{},"    private String  id;\n",[320,661,662],{"class":322,"line":335},[320,663,419],{"emptyLinePlaceholder":418},[320,665,666],{"class":322,"line":341},[320,667,668],{},"    @JsonProperty(\"@timestamp\")      \u002F\u002F Java field `timestamp` ⇄ Elasticsearch field `@timestamp`\n",[320,670,671],{"class":322,"line":347},[320,672,673],{},"    private Instant timestamp;\n",[320,675,676],{"class":322,"line":353},[320,677,419],{"emptyLinePlaceholder":418},[320,679,680],{"class":322,"line":359},[320,681,682],{},"    private String  actor;\n",[320,684,685],{"class":322,"line":422},[320,686,687],{},"    private String  action;\n",[320,689,690],{"class":322,"line":428},[320,691,449],{},[239,693,694,695,698,699,701,702,705],{},"This ",[290,696,697],{},"renames"," the field — the stored document has only ",[259,700,605],{},", so any query or sort must use that literal name (",[259,703,704],{},"timestamp"," does not exist in the index). For most internal stream DTOs this is the simplest correct choice.",[239,707,708,709,713,714,716],{},"If you instead want a friendly, separately-queryable field name ",[710,711,712],"em",{},"alongside"," ",[259,715,605],{},", keep your own field and add a serialize-only companion:",[311,718,720],{"className":379,"code":719,"language":381,"meta":316,"style":316},"@JsonProperty(\"eventTime\")           \u002F\u002F stays queryable as eventTime\nprivate Instant eventTime;\n\n\u002F\u002F emitted as @timestamp on write, ignored on read (eventTime is restored from its own key)\n@JsonProperty(value = \"@timestamp\", access = JsonProperty.Access.READ_ONLY)\npublic Instant esTimestamp() { return eventTime; }\n",[259,721,722,727,732,736,741,746],{"__ignoreMap":316},[320,723,724],{"class":322,"line":323},[320,725,726],{},"@JsonProperty(\"eventTime\")           \u002F\u002F stays queryable as eventTime\n",[320,728,729],{"class":322,"line":329},[320,730,731],{},"private Instant eventTime;\n",[320,733,734],{"class":322,"line":335},[320,735,419],{"emptyLinePlaceholder":418},[320,737,738],{"class":322,"line":341},[320,739,740],{},"\u002F\u002F emitted as @timestamp on write, ignored on read (eventTime is restored from its own key)\n",[320,742,743],{"class":322,"line":347},[320,744,745],{},"@JsonProperty(value = \"@timestamp\", access = JsonProperty.Access.READ_ONLY)\n",[320,747,748],{"class":322,"line":353},[320,749,750],{},"public Instant esTimestamp() { return eventTime; }\n",[239,752,694,753,756,757,369,760,762,763,768],{},[290,754,755],{},"duplicates"," the value (both ",[259,758,759],{},"eventTime",[259,761,605],{}," are stored). It is the same document shape that application entities get from the ",[243,764,765],{"href":73},[259,766,767],{},"@TimeReference"," decorator. When a migration creates the stream backing such an entity, declare the pairing so the stream documents which column is the natural time field:",[311,770,772],{"className":313,"code":771,"language":315,"meta":316,"style":316},"CREATE DATA STREAM sensor_readings (\n    id        KEYWORD,\n    eventTime DATE,\n    value     DOUBLE\n) WITH (DATA_RETENTION = '30d', TIME_REFERENCE = 'eventTime') ;\n",[259,773,774,779,784,789,794],{"__ignoreMap":316},[320,775,776],{"class":322,"line":323},[320,777,778],{},"CREATE DATA STREAM sensor_readings (\n",[320,780,781],{"class":322,"line":329},[320,782,783],{},"    id        KEYWORD,\n",[320,785,786],{"class":322,"line":335},[320,787,788],{},"    eventTime DATE,\n",[320,790,791],{"class":322,"line":341},[320,792,793],{},"    value     DOUBLE\n",[320,795,796],{"class":322,"line":347},[320,797,798],{},") WITH (DATA_RETENTION = '30d', TIME_REFERENCE = 'eventTime') ;\n",[239,800,801,804,805,808,809,811,812,814],{},[259,802,803],{},"TIME_REFERENCE"," must name a declared ",[259,806,807],{},"DATE"," column; the migration validates this and fails fast otherwise. It declares intent and pairs with the entity's ",[259,810,767],{}," — the write-time duplication into ",[259,813,605],{}," is performed by the persistence layer, not the migration.",[303,816,818],{"id":817},"writing-and-reading","Writing and reading",[239,820,821,822,825,826,829,830,833],{},"Data streams are ",[290,823,824],{},"append-only",": Elasticsearch accepts only the ",[259,827,828],{},"create"," op-type and rejects the ",[259,831,832],{},"index"," op and by-id updates\u002Fdeletes. Documents are retrieved by search\u002Fquery, not by id. System services that write to a stream must therefore use a create (append) write, and read through search rather than a find-by-id lookup.",[835,836,837],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":316,"searchDepth":329,"depth":329,"links":839},[840,841,842,846],{"id":250,"depth":329,"text":251},{"id":269,"depth":329,"text":270},{"id":281,"depth":329,"text":282,"children":843},[844,845],{"id":305,"depth":335,"text":306},{"id":508,"depth":335,"text":509},{"id":537,"depth":329,"text":538,"children":847},[848,850],{"id":601,"depth":335,"text":849},"Every document needs a @timestamp — and Java needs ceremony for it",{"id":817,"depth":335,"text":818},"Writing and maintaining migration scripts for Kinotic's internal system indices.","md",null,{},{"icon":194},{"title":191,"description":851},"YBKPRIuIyPm3yUu82Q0HaD4nbPZsWLEuTPDyWjZI1Lw",[859,861],{"title":186,"path":187,"stem":188,"description":860,"icon":189,"children":-1},"How to contribute to the Kinotic OS project.",{"title":196,"path":197,"stem":198,"description":862,"icon":199,"children":-1},"How a call through a service proxy fails when the node serving it dies, instead of waiting forever — without a timeout anywhere.",1791997978994]