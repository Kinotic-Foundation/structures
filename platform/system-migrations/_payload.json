Fdefense-in-depth","02.platform\u002F06.defense-in-depth",{"title":176,"path":177,"stem":178,"icon":179},"MCP Tools","\u002Fplatform\u002Fmcp-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":181,"path":182,"stem":183,"icon":184},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":186,"path":187,"stem":188,"icon":189},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":191,"path":192,"stem":193,"icon":194},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":196,"path":197,"stem":198,"icon":199},"Service Call Liveness","\u002Fplatform\u002Fservice-call-liveness","02.platform\u002F11.service-call-liveness","i-lucide-heart-pulse",{"title":128,"icon":129,"path":201,"stem":202,"children":203,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F12.reference",[204,209,214],{"title":205,"path":206,"stem":207,"icon":208},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":210,"path":211,"stem":212,"icon":213},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","02.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":215,"path":216,"stem":217,"icon":151},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","02.platform\u002F12.reference\u002F03.project-publishing-design",{"id":219,"title":191,"body":220,"description":836,"extension":837,"links":838,"meta":839,"navigation":840,"path":192,"seo":841,"stem":193,"__hash__":842},"docs\u002F02.platform\u002F10.system-migrations.md",{"type":221,"value":222,"toc":823},"minimark",[223,232,237,240,252,256,264,268,271,287,292,295,348,362,467,470,485,491,495,510,520,524,538,568,584,592,612,630,677,691,702,736,754,784,800,804,819],[224,225,226,227,231],"p",{},"The Kinotic platform uses the same migration SQL system as application developers to manage its own internal Elasticsearch indices. This page covers considerations specific to platform development — for general migration syntax, see ",[228,229,230],"a",{"href":89},"App Migrations",".",[233,234,236],"h2",{"id":235},"what-are-system-migrations","What Are System Migrations?",[224,238,239],{},"System migrations define and evolve the indices that the platform itself relies on — things like migration history tracking, system configuration, and other internal data stores. They run during platform startup before any application migrations and are scoped to the system project rather than a per-application project.",[224,241,242,243,247,248,251],{},"System migrations live in ",[244,245,246],"code",{},"kinotic-migration\u002Fsrc\u002Fmain\u002Fresources\u002Fmigrations\u002F"," and follow the same ",[244,249,250],{},"V\u003CN>__\u003Cdescription>.sql"," naming convention.",[233,253,255],{"id":254},"using-composite-types-in-system-indices","Using Composite Types in System Indices",[224,257,258,259,263],{},"OBJECT, NESTED, and UNION columns work the same way in system migrations as in application migrations. Refer to the ",[228,260,262],{"href":261},"\u002Fapps\u002Fpersistence\u002Fmigrations#composite-column-types","Composite Column Types"," section of the app documentation for syntax and examples.",[233,265,267],{"id":266},"deserializing-union-types","Deserializing Union Types",[224,269,270],{},"Elasticsearch stores UNION fields as a flat merged object — it has no knowledge of which variant a document contains. When reading documents back into Java, the platform needs to route deserialization to the correct subclass.",[224,272,273,274,278,279,282,283,286],{},"The standard approach is Jackson's polymorphic type handling, driven by a ",[275,276,277],"strong",{},"discriminator field"," stored in the document. This is the same ",[244,280,281],{},"kind"," (or similar) ",[244,284,285],{},"KEYWORD"," field you include in each union variant in the migration SQL.",[288,289,291],"h3",{"id":290},"example","Example",[224,293,294],{},"Given this migration:",[296,297,302],"pre",{"className":298,"code":299,"language":300,"meta":301,"style":301},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","CREATE TABLE assets (\n    id KEYWORD,\n    item UNION (\n        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n        Video (kind KEYWORD, title TEXT, duration INTEGER)\n    )\n);\n","sql","",[244,303,304,312,318,324,330,336,342],{"__ignoreMap":301},[305,306,309],"span",{"class":307,"line":308},"line",1,[305,310,311],{},"CREATE TABLE assets (\n",[305,313,315],{"class":307,"line":314},2,[305,316,317],{},"    id KEYWORD,\n",[305,319,321],{"class":307,"line":320},3,[305,322,323],{},"    item UNION (\n",[305,325,327],{"class":307,"line":326},4,[305,328,329],{},"        Book  (kind KEYWORD, title TEXT, isbn KEYWORD),\n",[305,331,333],{"class":307,"line":332},5,[305,334,335],{},"        Video (kind KEYWORD, title TEXT, duration INTEGER)\n",[305,337,339],{"class":307,"line":338},6,[305,340,341],{},"    )\n",[305,343,345],{"class":307,"line":344},7,[305,346,347],{},");\n",[224,349,350,351,354,355,358,359,361],{},"The corresponding Java model uses ",[244,352,353],{},"@JsonTypeInfo"," and ",[244,356,357],{},"@JsonSubTypes"," to map the ",[244,360,281],{}," field value to the correct subclass:",[296,363,367],{"className":364,"code":365,"language":366,"meta":301,"style":301},"language-java shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","@JsonTypeInfo(use = JsonTypeInfo.Id.NAME, property = \"kind\")\n@JsonSubTypes({\n    @JsonSubTypes.Type(value = Book.class,  name = \"Book\"),\n    @JsonSubTypes.Type(value = Video.class, name = \"Video\")\n})\npublic abstract class Item {}\n\npublic class Book extends Item {\n    public String kind;\n    public String title;\n    public String isbn;\n}\n\npublic class Video extends Item {\n    public String kind;\n    public String title;\n    public Integer duration;\n}\n","java",[244,368,369,374,379,384,389,394,399,405,411,417,423,429,435,440,446,451,456,462],{"__ignoreMap":301},[305,370,371],{"class":307,"line":308},[305,372,373],{},"@JsonTypeInfo(use = JsonTypeInfo.Id.NAME, property = \"kind\")\n",[305,375,376],{"class":307,"line":314},[305,377,378],{},"@JsonSubTypes({\n",[305,380,381],{"class":307,"line":320},[305,382,383],{},"    @JsonSubTypes.Type(value = Book.class,  name = \"Book\"),\n",[305,385,386],{"class":307,"line":326},[305,387,388],{},"    @JsonSubTypes.Type(value = Video.class, name = \"Video\")\n",[305,390,391],{"class":307,"line":332},[305,392,393],{},"})\n",[305,395,396],{"class":307,"line":338},[305,397,398],{},"public abstract class Item {}\n",[305,400,401],{"class":307,"line":344},[305,402,404],{"emptyLinePlaceholder":403},true,"\n",[305,406,408],{"class":307,"line":407},8,[305,409,410],{},"public class Book extends Item {\n",[305,412,414],{"class":307,"line":413},9,[305,415,416],{},"    public String kind;\n",[305,418,420],{"class":307,"line":419},10,[305,421,422],{},"    public String title;\n",[305,424,426],{"class":307,"line":425},11,[305,427,428],{},"    public String isbn;\n",[305,430,432],{"class":307,"line":431},12,[305,433,434],{},"}\n",[305,436,438],{"class":307,"line":437},13,[305,439,404],{"emptyLinePlaceholder":403},[305,441,443],{"class":307,"line":442},14,[305,444,445],{},"public class Video extends Item {\n",[305,447,449],{"class":307,"line":448},15,[305,450,416],{},[305,452,454],{"class":307,"line":453},16,[305,455,422],{},[305,457,459],{"class":307,"line":458},17,[305,460,461],{},"    public Integer duration;\n",[305,463,465],{"class":307,"line":464},18,[305,466,434],{},[224,468,469],{},"When inserting documents, always write the discriminator value:",[296,471,473],{"className":298,"code":472,"language":300,"meta":301,"style":301},"INSERT INTO assets (id, item)\n    VALUES ('a1', { kind: 'Book', title: 'Clean Code', isbn: '978-0132350884' }) WITH REFRESH;\n",[244,474,475,480],{"__ignoreMap":301},[305,476,477],{"class":307,"line":308},[305,478,479],{},"INSERT INTO assets (id, item)\n",[305,481,482],{"class":307,"line":314},[305,483,484],{},"    VALUES ('a1', { kind: 'Book', title: 'Clean Code', isbn: '978-0132350884' }) WITH REFRESH;\n",[224,486,487,488,490],{},"If the ",[244,489,281],{}," field is absent from a stored document, Jackson will fail to deserialize it. Ensure every INSERT that targets a UNION field includes the discriminator.",[288,492,494],{"id":493},"conflict-validation","Conflict validation",[224,496,497,498,501,502,505,506,509],{},"If two variants declare the same field name with different scalar types — e.g. ",[244,499,500],{},"title TEXT"," in one variant and ",[244,503,504],{},"title KEYWORD"," in another — the migration executor will throw an ",[244,507,508],{},"IllegalArgumentException"," at mapping time. Fields shared across variants must have identical types.",[224,511,512,515,516,519],{},[275,513,514],{},"Known limitation:"," Conflict detection is shallow for composite types. If two variants share a field name with the same composite type (OBJECT, NESTED, or UNION) but different sub-fields, no exception is thrown — only the first variant's sub-field definitions are used and the second's are silently dropped. Until named type support is added to the migration DSL, avoid sharing composite-typed fields across variants. Scalar shared fields (such as a ",[244,517,518],{},"kind KEYWORD"," discriminator) are always safe.",[233,521,523],{"id":522},"data-streams","Data Streams",[224,525,526,527,530,531,537],{},"System data that is append-only and time-series — audit trails, events, telemetry — should be backed by an Elasticsearch ",[275,528,529],{},"data stream"," rather than a regular index, so old data ages out and backing indices roll over automatically. Create one from a migration with ",[228,532,534],{"href":533},"\u002Fapps\u002Freference\u002Fmigration-sql-grammar#create-data-stream",[244,535,536],{},"CREATE DATA STREAM",":",[296,539,541],{"className":298,"code":540,"language":300,"meta":301,"style":301},"CREATE DATA STREAM system_audit (\n    actor  KEYWORD,\n    action KEYWORD,\n    detail TEXT\n) WITH (DATA_RETENTION = '90d') ;\n",[244,542,543,548,553,558,563],{"__ignoreMap":301},[305,544,545],{"class":307,"line":308},[305,546,547],{},"CREATE DATA STREAM system_audit (\n",[305,549,550],{"class":307,"line":314},[305,551,552],{},"    actor  KEYWORD,\n",[305,554,555],{"class":307,"line":320},[305,556,557],{},"    action KEYWORD,\n",[305,559,560],{"class":307,"line":326},[305,561,562],{},"    detail TEXT\n",[305,564,565],{"class":307,"line":332},[305,566,567],{},") WITH (DATA_RETENTION = '90d') ;\n",[224,569,570,573,574,580,581,583],{},[244,571,572],{},"DATA_RETENTION"," is the native ",[228,575,579],{"href":576,"rel":577},"https:\u002F\u002Fwww.elastic.co\u002Fdocs\u002Fmanage-data\u002Flifecycle\u002Fdata-stream",[578],"nofollow","data stream lifecycle"," — Elasticsearch deletes data past the period (measured per backing index from rollover, not per document). See the ",[228,582,139],{"href":533}," for the full statement and the exact retention semantics.",[288,585,587,588,591],{"id":586},"every-document-needs-a-timestamp-and-java-needs-ceremony-for-it","Every document needs a ",[244,589,590],{},"@timestamp"," — and Java needs ceremony for it",[224,593,594,595,598,599,601,602,605,606,608,609,611],{},"Elasticsearch ",[275,596,597],{},"requires"," every document written to a data stream to carry a ",[244,600,590],{}," date field, and rejects any that don't with ",[244,603,604],{},"data stream timestamp field [@timestamp] is missing",". The migration adds ",[244,607,590],{}," to the mapping automatically — you neither declare it as a column nor can you, since ",[244,610,590],{}," is not a legal column identifier.",[224,613,614,615,618,619,621,622,625,626,629],{},"The catch is on the ",[275,616,617],{},"write"," side: ",[244,620,590],{}," is also not a legal Java field name, so a system DTO cannot carry it directly. Bridge it with Jackson's ",[244,623,624],{},"@JsonProperty"," — the ",[244,627,628],{},"ElasticsearchAsyncClient"," serializes through a Jackson mapper, so the annotation is honored on both write and read:",[296,631,633],{"className":364,"code":632,"language":366,"meta":301,"style":301},"public class AuditEvent {\n    private String  id;\n\n    @JsonProperty(\"@timestamp\")      \u002F\u002F Java field `timestamp` ⇄ Elasticsearch field `@timestamp`\n    private Instant timestamp;\n\n    private String  actor;\n    private String  action;\n}\n",[244,634,635,640,645,649,654,659,663,668,673],{"__ignoreMap":301},[305,636,637],{"class":307,"line":308},[305,638,639],{},"public class AuditEvent {\n",[305,641,642],{"class":307,"line":314},[305,643,644],{},"    private String  id;\n",[305,646,647],{"class":307,"line":320},[305,648,404],{"emptyLinePlaceholder":403},[305,650,651],{"class":307,"line":326},[305,652,653],{},"    @JsonProperty(\"@timestamp\")      \u002F\u002F Java field `timestamp` ⇄ Elasticsearch field `@timestamp`\n",[305,655,656],{"class":307,"line":332},[305,657,658],{},"    private Instant timestamp;\n",[305,660,661],{"class":307,"line":338},[305,662,404],{"emptyLinePlaceholder":403},[305,664,665],{"class":307,"line":344},[305,666,667],{},"    private String  actor;\n",[305,669,670],{"class":307,"line":407},[305,671,672],{},"    private String  action;\n",[305,674,675],{"class":307,"line":413},[305,676,434],{},[224,678,679,680,683,684,686,687,690],{},"This ",[275,681,682],{},"renames"," the field — the stored document has only ",[244,685,590],{},", so any query or sort must use that literal name (",[244,688,689],{},"timestamp"," does not exist in the index). For most internal stream DTOs this is the simplest correct choice.",[224,692,693,694,698,699,701],{},"If you instead want a friendly, separately-queryable field name ",[695,696,697],"em",{},"alongside"," ",[244,700,590],{},", keep your own field and add a serialize-only companion:",[296,703,705],{"className":364,"code":704,"language":366,"meta":301,"style":301},"@JsonProperty(\"eventTime\")           \u002F\u002F stays queryable as eventTime\nprivate Instant eventTime;\n\n\u002F\u002F emitted as @timestamp on write, ignored on read (eventTime is restored from its own key)\n@JsonProperty(value = \"@timestamp\", access = JsonProperty.Access.READ_ONLY)\npublic Instant esTimestamp() { return eventTime; }\n",[244,706,707,712,717,721,726,731],{"__ignoreMap":301},[305,708,709],{"class":307,"line":308},[305,710,711],{},"@JsonProperty(\"eventTime\")           \u002F\u002F stays queryable as eventTime\n",[305,713,714],{"class":307,"line":314},[305,715,716],{},"private Instant eventTime;\n",[305,718,719],{"class":307,"line":320},[305,720,404],{"emptyLinePlaceholder":403},[305,722,723],{"class":307,"line":326},[305,724,725],{},"\u002F\u002F emitted as @timestamp on write, ignored on read (eventTime is restored from its own key)\n",[305,727,728],{"class":307,"line":332},[305,729,730],{},"@JsonProperty(value = \"@timestamp\", access = JsonProperty.Access.READ_ONLY)\n",[305,732,733],{"class":307,"line":338},[305,734,735],{},"public Instant esTimestamp() { return eventTime; }\n",[224,737,679,738,741,742,354,745,747,748,753],{},[275,739,740],{},"duplicates"," the value (both ",[244,743,744],{},"eventTime",[244,746,590],{}," are stored). It is the same document shape that application entities get from the ",[228,749,750],{"href":73},[244,751,752],{},"@TimeReference"," decorator. When a migration creates the stream backing such an entity, declare the pairing so the stream documents which column is the natural time field:",[296,755,757],{"className":298,"code":756,"language":300,"meta":301,"style":301},"CREATE DATA STREAM sensor_readings (\n    id        KEYWORD,\n    eventTime DATE,\n    value     DOUBLE\n) WITH (DATA_RETENTION = '30d', TIME_REFERENCE = 'eventTime') ;\n",[244,758,759,764,769,774,779],{"__ignoreMap":301},[305,760,761],{"class":307,"line":308},[305,762,763],{},"CREATE DATA STREAM sensor_readings (\n",[305,765,766],{"class":307,"line":314},[305,767,768],{},"    id        KEYWORD,\n",[305,770,771],{"class":307,"line":320},[305,772,773],{},"    eventTime DATE,\n",[305,775,776],{"class":307,"line":326},[305,777,778],{},"    value     DOUBLE\n",[305,780,781],{"class":307,"line":332},[305,782,783],{},") WITH (DATA_RETENTION = '30d', TIME_REFERENCE = 'eventTime') ;\n",[224,785,786,789,790,793,794,796,797,799],{},[244,787,788],{},"TIME_REFERENCE"," must name a declared ",[244,791,792],{},"DATE"," column; the migration validates this and fails fast otherwise. It declares intent and pairs with the entity's ",[244,795,752],{}," — the write-time duplication into ",[244,798,590],{}," is performed by the persistence layer, not the migration.",[288,801,803],{"id":802},"writing-and-reading","Writing and reading",[224,805,806,807,810,811,814,815,818],{},"Data streams are ",[275,808,809],{},"append-only",": Elasticsearch accepts only the ",[244,812,813],{},"create"," op-type and rejects the ",[244,816,817],{},"index"," op and by-id updates\u002Fdeletes. Documents are retrieved by search\u002Fquery, not by id. System services that write to a stream must therefore use a create (append) write, and read through search rather than a find-by-id lookup.",[820,821,822],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);