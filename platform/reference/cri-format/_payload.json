1,1002,1006,1091],[224,225,25],"h2",{"id":226},"overview",[228,229,230],"p",{},"A CRI (Kinotic Resource Identifier) is used by Kinotic to route requests to the appropriate service, method, or event stream. It is a URI-like format with parts named for clarity within the Kinotic platform.",[224,232,234],{"id":233},"format","Format",[236,237,242],"pre",{"className":238,"code":240,"language":241},[239],"language-text","scheme:\u002F\u002F[scope@][zone~]resourceName[\u002Fpath][#version]\n","text",[243,244,240],"code",{"__ignoreMap":245},"",[228,247,248,249,252],{},"Everything in brackets (",[243,250,251],{},"[]",") is optional.",[224,254,256],{"id":255},"case","Case",[228,258,259,260,263,264,266],{},"Every part keeps the case it was written with, and addresses match by exact string comparison — ",[243,261,262],{},"OrderService"," and ",[243,265,262],{}," are two different addresses. Service names carry the case of the class that published them, so a typical address looks like:",[236,268,271],{"className":269,"code":270,"language":241},[239],"srv:\u002F\u002Fmanagement-api~org.kinotic.management.api.services.ProjectService\u002FfindByRepoFullName\n",[243,272,270],{"__ignoreMap":245},[224,274,276],{"id":275},"components","Components",[278,279,281],"h3",{"id":280},"scheme","Scheme",[228,283,284],{},"Identifies the type of resource being addressed.",[286,287,288,300],"table",{},[289,290,291],"thead",{},[292,293,294,297],"tr",{},[295,296,281],"th",{},[295,298,299],{},"Description",[301,302,303,314],"tbody",{},[292,304,305,311],{},[306,307,308],"td",{},[243,309,310],{},"srv",[306,312,313],{},"Published services and their methods",[292,315,316,321],{},[306,317,318],{},[243,319,320],{},"stream",[306,322,323],{},"Event streams (not yet routable through the gateway)",[278,325,327],{"id":326},"scope","Scope",[228,329,330,331,334],{},"An optional qualifier that narrows the CRI to a specific context, such as a tenant ID, user ID, or device ID. When present, it appears before the ",[243,332,333],{},"@"," symbol.",[228,336,337,338,341],{},"If a scope needs sub-scopes, use the format ",[243,339,340],{},"scope:sub-scope",".",[236,343,346],{"className":344,"code":345,"language":241},[239],"srv:\u002F\u002Ftenant-123@app.acme-org.orders-app~OrderService\nstream:\u002F\u002Fdevice-42@app.acme-org.orders-app~temperature\u002Fsensor-1\n",[243,347,345],{"__ignoreMap":245},[278,349,351],{"id":350},"zone","Zone",[228,353,354,355,358],{},"The optional zone places the resource in the isolation boundary the gateway validates on every send and subscribe. It precedes the resourceName, separated by ",[243,356,357],{},"~",". A zone is one or more dot-separated labels of lowercase letters, digits, and interior dashes.",[286,360,361,369],{},[289,362,363],{},[292,364,365,367],{},[295,366,351],{},[295,368,299],{},[301,370,371,384,394,404],{},[292,372,373,378],{},[306,374,375],{},[243,376,377],{},"app.\u003CorganizationId>.\u003CapplicationId>",[306,379,380,381,341],{},"One application's services. Only that application (and system participants) can call them; they are hosted by the owning organization's runtime, which authenticates as an organization participant. Applications may nest their own sub-zones, e.g. ",[243,382,383],{},"app.acme-org.orders-app.billing",[292,385,386,391],{},[306,387,388],{},[243,389,390],{},"app-api",[306,392,393],{},"The platform's data plane for applications, such as entity persistence and named query execution. Hosted in-process by the platform only.",[292,395,396,401],{},[306,397,398],{},[243,399,400],{},"management-api",[306,402,403],{},"The platform services organizations manage the system through, such as member, application, and entity definition management. Hosted in-process by the platform only.",[292,405,406,411],{},[306,407,408],{},[243,409,410],{},"system-api",[306,412,413],{},"Platform-internal services. Only system participants can call or host them.",[228,415,416,417,420,421,423],{},"Organization and application ids become zone labels, but only ever after the ",[243,418,419],{},"app"," prefix, so they cannot collide with the platform's own zones. The one exception is guarded explicitly: creating an organization or application whose name slugifies to ",[243,422,410],{}," is rejected.",[228,425,426,427,429,430,433,434,436],{},"Which zones a connection may address is determined by the authenticated participant. A participant may also address any sub-zone of a zone it is allowed, so ",[243,428,383],{}," is reachable by whoever may reach ",[243,431,432],{},"app.acme-org.orders-app",". An address without a ",[243,435,357],{}," carries no zone at all and is only reachable by system participants.",[286,438,439,452],{},[289,440,441],{},[292,442,443,446,449],{},[295,444,445],{},"Participant",[295,447,448],{},"May send to",[295,450,451],{},"May subscribe to",[301,453,454,470,489],{},[292,455,456,459,467],{},[306,457,458],{},"APPLICATION (org, app)",[306,460,461,463,464],{},[243,462,390],{},", ",[243,465,466],{},"app.\u003Corg>.\u003Capp>",[306,468,469],{},"reply destinations only",[292,471,472,475,484],{},[306,473,474],{},"ORGANIZATION (org)",[306,476,477,463,479,463,481],{},[243,478,400],{},[243,480,390],{},[243,482,483],{},"app.\u003Corg>.*",[306,485,486,488],{},[243,487,483],{}," — its applications' zones",[292,490,491,494,497],{},[306,492,493],{},"SYSTEM",[306,495,496],{},"everything",[306,498,499],{},[243,500,410],{},[278,502,504],{"id":503},"resource-name","Resource Name",[228,506,507],{},"The name of the resource being addressed, excluding the zone. For services, this is the fully qualified service name. For streams, this is the event type name.",[236,509,512],{"className":510,"code":511,"language":241},[239],"srv:\u002F\u002Fmanagement-api~com.example.UserService\nstream:\u002F\u002Fapp.acme-org.orders-app~temperature\n",[243,513,511],{"__ignoreMap":245},[278,515,517],{"id":516},"path","Path",[228,519,520],{},"An optional path that identifies a specific part of the resource, such as a method name on a service. The path's case is preserved.",[236,522,525],{"className":523,"code":524,"language":241},[239],"srv:\u002F\u002Fmanagement-api~com.example.UserService\u002FfindById\nstream:\u002F\u002Fapp.acme-org.orders-app~temperature\u002Fsensor-1\n",[243,526,524],{"__ignoreMap":245},[278,528,530],{"id":529},"version","Version",[228,532,533],{},"An optional semantic version for the resource. Enables versioned service routing so multiple versions of a service can coexist.",[236,535,538],{"className":536,"code":537,"language":241},[239],"srv:\u002F\u002Fmanagement-api~com.example.UserService\u002FfindById#1.0.0\nsrv:\u002F\u002Fmanagement-api~com.example.UserService#2.0.0\n",[243,539,537],{"__ignoreMap":245},[224,541,543],{"id":542},"factory-function","Factory Function",[228,545,546,547,550],{},"The ",[243,548,549],{},"createCRI"," function provides several overloads for constructing CRI instances:",[236,552,556],{"className":553,"code":554,"language":555,"meta":245,"style":245},"language-typescript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { createCRI } from '@kinotic-ai\u002Fcore'\n\n\u002F\u002F From a raw string\nconst cri1 = createCRI('srv:\u002F\u002Fmanagement-api~com.example.UserService\u002FfindById#1.0.0')\n\n\u002F\u002F From scheme and resource name (which may carry a zone)\nconst cri2 = createCRI('srv', 'management-api~com.example.UserService')\n\n\u002F\u002F From scheme, scope, and resource name\nconst cri3 = createCRI('stream', 'tenant-123', 'app.acme-org.orders-app~orders')\n\n\u002F\u002F From all components\nconst cri4 = createCRI('srv', null, 'management-api~com.example.UserService', 'findById', '1.0.0')\n","typescript",[243,557,558,591,598,605,635,640,646,678,683,689,729,734,740],{"__ignoreMap":245},[559,560,563,567,571,575,578,581,584,588],"span",{"class":561,"line":562},"line",1,[559,564,566],{"class":565},"s7zQu","import",[559,568,570],{"class":569},"sMK4o"," {",[559,572,574],{"class":57