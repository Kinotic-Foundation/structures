p",{},"We welcome contributions to Kinotic OS. This guide covers the repository structure, build process, and contribution workflow.",[224,232,234],{"id":233},"repository-structure","Repository Structure",[236,237,238,251],"table",{},[239,240,241],"thead",{},[242,243,244,248],"tr",{},[245,246,247],"th",{},"Directory",[245,249,250],{},"Description",[252,253,254,266,276,294,316,326],"tbody",{},[242,255,256,263],{},[257,258,259],"td",{},[260,261,262],"code",{},"kinotic-core\u002F",[257,264,265],{},"Java\u002FKotlin backend (Spring Boot) — RPC gateway, service registry, authentication",[242,267,268,273],{},[257,269,270],{},[260,271,272],{},"kinotic-management-api\u002F",[257,274,275],{},"Domain model and management API services — application, project, and cluster management",[242,277,278,283],{},[257,279,280],{},[260,281,282],{},"kinotic-js\u002F",[257,284,285,286,289,290,293],{},"TypeScript SDK workspace (Bun) — ",[260,287,288],{},"@kinotic-ai\u002Fcore",", ",[260,291,292],{},"@kinotic-ai\u002Fpersistence",", and related packages",[242,295,296,301],{},[257,297,298],{},[260,299,300],{},"kinotic-frontend\u002F",[257,302,303,304,307,308,311,312,315],{},"Vue.js UI workspace (pnpm) — ",[260,305,306],{},"apps\u002Fportal"," (the Kinotic OS dashboard), ",[260,309,310],{},"apps\u002Fsystem"," (the platform-operator console), ",[260,313,314],{},"packages\u002Fcommon"," (shared UI code)",[242,317,318,323],{},[257,319,320],{},[260,321,322],{},"website\u002F",[257,324,325],{},"Documentation site (Docus\u002FNuxt)",[242,327,328,333],{},[257,329,330],{},[260,331,332],{},"deployment\u002F",[257,334,335],{},"Helm charts, Docker Compose, Terraform configurations",[224,337,339],{"id":338},"building","Building",[341,342,344],"h3",{"id":343},"javakotlin-backend","Java\u002FKotlin Backend",[346,347,352],"pre",{"className":348,"code":349,"language":350,"meta":351,"style":351},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight",".\u002Fgradlew build\n","bash","",[260,353,354],{"__ignoreMap":351},[355,356,359,363],"span",{"class":357,"line":358},"line",1,[355,360,362],{"class":361},"sBMFI",".\u002Fgradlew",[355,364,366],{"class":365},"sfazB"," build\n",[341,368,370],{"id":369},"typescript-sdk","TypeScript SDK",[346,372,374],{"className":348,"code":373,"language":350,"meta":351,"style":351},"cd kinotic-js\nbun install\nbun run build\n",[260,375,376,385,394],{"__ignoreMap":351},[355,377,378,382],{"class":357,"line":358},[355,379,381],{"class":380},"s2Zo4","cd",[355,383,384],{"class":365}," kinotic-js\n",[355,386,388,391],{"class":357,"line":387},2,[355,389,390],{"class":361},"bun",[355,392,393],{"class":365}," install\n",[355,395,397,399,402],{"class":357,"line":396},3,[355,398,390],{"class":361},[355,400,401],{"class":365}," run",[355,403,366],{"class":365},[341,405,407],{"id":406},"website","Website",[346,409,411],{"className":348,"code":410,"language":350,"meta":351,"style":351},"cd website\nbun install\nbun run dev\n",[260,412,413,420,426],{"__ignoreMap":351},[355,414,415,417],{"class":357,"line":358},[355,416,381],{"class":380},[355,418,419],{"class":365}," website\n",[355,421,422,424],{"class":357,"line":387},[355,423,390],{"class":361},[355,425,393],{"class":365},[355,427,428,430,432],{"class":357,"line":396},[355,429,390],{"class":361},[355,431,401],{"class":365},[355,433,434],{"class":365}," dev\n",[224,436,438],{"id":437},"testing","Testing",[341,440,442],{"id":441},"javakotlin","Java\u002FKotlin",[346,444,446],{"className":348,"code":445,"language":350,"meta":351,"style":351},".\u002Fgradlew test\n",[260,447,448],{"__ignoreMap":351},[355,449,450,452],{"class":357,"line":358},[355,451,362],{"class":361},[355,453,454],{"class":365}," test\n",[341,456,458],{"id":457},"typescript-vitest","TypeScript (Vitest)",[346,460,462],{"className":348,"code":461,"language":350,"meta":351,"style":351},"cd kinotic-js\nbun test\n",[260,463,464,470],{"__ignoreMap":351},[355,465,466,468],{"class":357,"line":358},[355,467,381],{"class":380},[355,469,384],{"class":365},[355,471,472,474],{"class":357,"line":387},[355,473,390],{"class":361},[355,475,454],{"class":365},[341,477,479],{"id":478},"publishing-uis-against-azure","Publishing UIs against Azure",[228,481,482],{},"The development profile marks every published UI ready without uploading or serving it. To\nexercise the real path — sites published into a sites account and served through Front Door —\npoint the server at a subscription of your own.",[228,484,485],{},"Create what the server cannot create itself, once:",[346,487,489],{"className":348,"code":488,"language":350,"meta":351,"style":351},"az login\ncd deployment\u002Fterraform\u002Fazure\u002Fdev\nterraform init\nterraform apply -target=module.sites.azurerm_cdn_frontdoor_profile.sites   # the profile's identity first: its principal id is unknown until it exists\nterraform apply   # environment = \"local\" in terraform.tfvars; lets_encrypt_email in local.auto.tfvars\nterraform output -raw application_local_yml > ..\u002F..\u002F..\u002F..\u002Fkinotic-server\u002Fsrc\u002Fmain\u002Fresources\u002Fapplication-local.yml\n",[260,490,491,499,506,514,529,539],{"__ignoreMap":351},[355,492,493,496],{"class":357,"line":358},[355,494,495],{"class":361},"az",[355,497,498],{"class":365}," login\n",[355,500,501,503],{"class":357,"line":387},[355,502,381],{"class":380},[355,504,505],{"class":365}," deployment\u002Fterraform\u002Fazure\u002Fdev\n",[355,507,508,511],{"class":357,"line":396},[355,509,510],{"class":361},"terraform",[355,512,513],{"class":365}," init\n",[355,515,517,519,522,525],{"class":357,"line":516},4,[355,518,510],{"class":361},[355,520,521],{"class":365}," apply",[355,523,524],{"class":365}," -target=module.sites.azurerm_cdn_frontdoor_profile.sites",[355,526,528],{"class":527},"sHwdD","   # the profile's identity first: its principal id is unknown until it exists\n",[355,530,532,534,536],{"class":357,"line":531},5,[355,533,510],{"class":361},[355,535,521],{"class":365},[355,537,538],{"class":527},"   # environment = \"local\" in terraform.tfvars; lets_encrypt_email in local.auto.tfvars\n",[355,540,542,544,547,550,553,557],{"class":357,"line":541},6,[355,543,510],{"class":361},[355,545,546],{"class":365}," output",[355,548,549],{"class":365}," -raw",[355,551,552],{"class":365}," application_local_yml",[355,554,556],{"class":555},"sMK4o"," >",[355,558,559],{"class":365}," ..\u002F..\u002F..\u002F..\u002Fkinotic-server\u002Fsrc\u002Fmain\u002Fresources\u002Fapplication-local.yml\n",[228,561,562,563,566,567,570,571,574],{},"That is a resource group with the sites storage account, a Front Door Standard profile with\nan endpoint and an identity that reads the account, the ",[260,564,565],{},"apps-\u003Cenvironment>.\u003Czone>"," sites\ndomain on a Let's Encrypt wildcard certificate in a key vault of its own, and a service\nprincipal for the server with the roles it needs: Storage Blob Data Contributor on the\naccount, with which it signs each site's upload and removal URLs, and Contributor on the\nemail service, so it sends mail too. The written file is the git-ignored ",[260,568,569],{},"local"," profile: it\nturns the site provisioner on and names the domain and the account. The ",[260,572,573],{},"environment"," is\nyours alone: a site hostname can be bound to one Front Door profile in all of Azure, so two\ndevelopers sharing a sites domain would collide.",[228,576,577,578,289,581,584,585,588,589,592,593,596,597,600,601,604],{},"The principal's ",[260,579,580],{},"AZURE_CLIENT_ID",[260,582,583],{},"AZURE_CLIENT_SECRET"," and ",[260,586,587],{},"AZURE_TENANT_ID"," are written to\n",[260,590,591],{},".env.local"," at the repository root, which git ignores, as a commented block after a blank\nline. When the file exists its other lines are kept and the block a previous apply wrote is\nreplaced, or appended if absent. Run the server with that file in its environment;\n",[260,594,595],{},"DefaultAzureCredential"," takes those variables before anything else, so the server signs as\nthe principal whatever ",[260,598,599],{},"az login"," is signed in as. A role assignment takes a minute or two to\nbecome visible; a publish before that fails with ",[260,602,603],{},"AuthorizationFailed"," on the workload, and\nthe next deploy of the project succeeds.",[228,606,607],{},"Run the server with both profiles:",[346,609,611],{"className":348,"code":610,"language":350,"meta":351,"style":351},"SPRING_PROFILES_ACTIVE=development,local\n",[260,612,613],{"__ignoreMap":351},[355,614,615,619,622],{"class":357,"line":358},[355,616,618],{"class":617},"sTEyZ","SPRING_PROFILES_ACTIVE",[355,620,621],{"class":555},"=",[355,623,624],{"class":365},"development,local\n",[228,626,627],{},"A developer machine is outside any platform VNet, so the publish workload reaches the sites\naccount over its public endpoint, which the workload's egress allowlist names.",[228,629,630,631,634],{},"Before involving the server, publish a site against your subscription from a test. It does\nwhat a deployment does for a site ",[260,632,633],{},"azure-it.apps-\u003Cenvironment>.\u003Czone>",", uploading through an\nupload URL and reading back through Front Door what it published, and checks that the URLs\nit issues act on one site's directory alone, so a step Azure rejects fails naming the call:",[346,636,638],{"className":348,"code":637,"language":350,"meta":351,"style":351},".\u002Fgradlew :kinotic-system-api:test --tests '*AzureProvisioningIntegrationTest*'\n",[260,639,640],{"__ignoreMap":351},[355,641,642,644,647,650,653,656],{"class":357,"line":358},[355,643,362],{"class":361},[355,645,646],{"class":365}," :kinotic-system-api:test",[355,648,649],{"class":365}," --tests",[355,651,652],{"class":555}," '",[355,654,655],{"class":365},"*AzureProvisioningIntegrationTest*",[355,657,658],{"class":555},"'\n",[228,660,661,662,664,665,668,669,672],{},"The module's test task puts ",[260,663,591],{}," in the test's environment, and the test reads your\n",[260,666,667],{},"application-local.yml","; without either it skips. What it publishes is left in place, so a\nsecond run is quick, and ",[260,670,671],{},"terraform destroy"," removes it with the account.",[228,674,675,676,679],{},"Then deploy a project that contains a UI; the deployment publishes it into the sites account\nand the site serves at ",[260,677,678],{},"https:\u002F\u002F\u003Clabel>.apps-\u003Cenvironment>.\u003Czone>"," as soon as its files are\nup, which shows as the deployment turning from provisioning to ready within moments.",[228,681,682,684,685,688],{},[260,683,671],{}," removes the resource group with the account, the profile and the key\nvault, and the wildcard records under ",[260,686,687],{},"apps-\u003Cenvironment>"," in the platform's DNS zone.",[224,690,692],{"id":691},"submitting-changes","Submitting Changes",[694,695,696,703,706,709],"ol",{},[697,698,699,700],"li",{},"Fork the repository and create a feature branch from ",[260,701,702],{},"develop",[697,704,705],{},"Make your changes with clear, descriptive commit messages",[697,707,708],{},"Ensure all tests pass before submitting",[697,710,711,712,714],{},"Submit a pull request against the ",[260,713,702],{}," branch",[716,717,718],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: v