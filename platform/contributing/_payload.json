p",{},"We welcome contributions to Kinotic OS. This guide covers the repository structure, build process, and contribution workflow.",[224,232,234],{"id":233},"repository-structure","Repository Structure",[236,237,238,251],"table",{},[239,240,241],"thead",{},[242,243,244,248],"tr",{},[245,246,247],"th",{},"Directory",[245,249,250],{},"Description",[252,253,254,266,276,294,316,326],"tbody",{},[242,255,256,263],{},[257,258,259],"td",{},[260,261,262],"code",{},"kinotic-core\u002F",[257,264,265],{},"Java\u002FKotlin backend (Spring Boot) — RPC gateway, service registry, authentication",[242,267,268,273],{},[257,269,270],{},[260,271,272],{},"kinotic-management-api\u002F",[257,274,275],{},"Domain model and management API services — application, project, and cluster management",[242,277,278,283],{},[257,279,280],{},[260,281,282],{},"kinotic-js\u002F",[257,284,285,286,289,290,293],{},"TypeScript SDK workspace (Bun) — ",[260,287,288],{},"@kinotic-ai\u002Fcore",", ",[260,291,292],{},"@kinotic-ai\u002Fpersistence",", and related packages",[242,295,296,301],{},[257,297,298],{},[260,299,300],{},"kinotic-frontend\u002F",[257,302,303,304,307,308,311,312,315],{},"Vue.js UI workspace (pnpm) — ",[260,305,306],{},"apps\u002Fportal"," (the Kinotic OS dashboard), ",[260,309,310],{},"apps\u002Fsystem"," (the platform-operator console), ",[260,313,314],{},"packages\u002Fcommon"," (shared UI code)",[242,317,318,323],{},[257,319,320],{},[260,321,322],{},"website\u002F",[257,324,325],{},"Documentation site (Docus\u002FNuxt)",[242,327,328,333],{},[257,329,330],{},[260,331,332],{},"deployment\u002F",[257,334,335],{},"Helm charts, Docker Compose, Terraform configurations",[224,337,339],{"id":338},"building","Building",[341,342,344],"h3",{"id":343},"javakotlin-backend","Java\u002FKotlin Backend",[346,347,352],"pre",{"className":348,"code":349,"language":350,"meta":351,"style":351},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight",".\u002Fgradlew build\n","bash","",[260,353,354],{"__ignoreMap":351},[355,356,359,363],"span",{"class":357,"line":358},"line",1,[355,360,362],{"class":361},"sBMFI",".\u002Fgradlew",[355,364,366],{"class":365},"sfazB"," build\n",[341,368,370],{"id":369},"typescript-sdk","TypeScript SDK",[346,372,374],{"className":348,"code":373,"language":350,"meta":351,"style":351},"cd kinotic-js\nbun install\nbun run build\n",[260,375,376,385,394],{"__ignoreMap":351},[355,377,378,382],{"class":357,"line":358},[355,379,381],{"class":380},"s2Zo4","cd",[355,383,384],{"class":365}," kinotic-js\n",[355,386,388,391],{"class":357,"line":387},2,[355,389,390],{"class":361},"bun",[355,392,393],{"class":365}," install\n",[355,395,397,399,402],{"class":357,"line":396},3,[355,398,390],{"class":361},[355,400,401],{"class":365}," run",[355,403,366],{"class":365},[341,405,407],{"id":406},"website","Website",[346,409,411],{"className":348,"code":410,"language":350,"meta":351,"style":351},"cd website\nbun install\nbun run dev\n",[260,412,413,420,426],{"__ignoreMap":351},[355,414,415,417],{"class":357,"line":358},[355,416,381],{"class":380},[355,418,419],{"class":365}," website\n",[355,421,422,424],{"class":357,"line":387},[355,423,390],{"class":361},[355,425,393],{"class":365},[355,427,428,430,432],{"class":357,"line":396},[355,429,390],{"class":361},[355,431,401],{"class":365},[355,433,434],{"class":365}," dev\n",[224,436,438],{"id":437},"testing","Testing",[341,440,442],{"id":441},"javakotlin","Java\u002FKotlin",[346,444,446],{"className":348,"code":445,"language":350,"meta":351,"style":351},".\u002Fgradlew test\n",[260,447,448],{"__ignoreMap":351},[355,449,450,452],{"class":357,"line":358},[355,451,362],{"class":361},[355,453,454],{"class":365}," test\n",[341,456,458],{"id":457},"typescript-vitest","TypeScript (Vitest)",[346,460,462],{"className":348,"code":461,"language":350,"meta":351,"style":351},"cd kinotic-js\nbun test\n",[260,463,464,470],{"__ignoreMap":351},[355,465,466,468],{"class":357,"line":358},[355,467,381],{"class":380},[355,469,384],{"class":365},[355,471,472,474],{"class":357,"line":387},[355,473,390],{"class":361},[355,475,454],{"class":365},[341,477,479],{"id":478},"publishing-uis-against-azure","Publishing UIs against Azure",[228,481,482],{},"The development profile publishes UIs to a local Azurite and marks every site ready without\nFront Door. To exercise the real path — a storage account per organization, sites served\nthrough Front Door — point the server at a subscription of your own.",[228,484,485],{},"Create what the server cannot create itself, once:",[346,487,489],{"className":348,"code":488,"language":350,"meta":351,"style":351},"az login\ncd deployment\u002Fterraform\u002Fazure\u002Fdev\nterraform init\nterraform apply -target=azurerm_cdn_frontdoor_profile.sites   # the profile's identity first: its principal id is unknown until it exists\nterraform apply   # environment = \"local\" in terraform.tfvars; pick a name of your own\nterraform output -raw application_local_yml > ..\u002F..\u002F..\u002F..\u002Fkinotic-server\u002Fsrc\u002Fmain\u002Fresources\u002Fapplication-local.yml\n",[260,490,491,499,506,514,529,539],{"__ignoreMap":351},[355,492,493,496],{"class":357,"line":358},[355,494,495],{"class":361},"az",[355,497,498],{"class":365}," login\n",[355,500,501,503],{"class":357,"line":387},[355,502,381],{"class":380},[355,504,505],{"class":365}," deployment\u002Fterraform\u002Fazure\u002Fdev\n",[355,507,508,511],{"class":357,"line":396},[355,509,510],{"class":361},"terraform",[355,512,513],{"class":365}," init\n",[355,515,517,519,522,525],{"class":357,"line":516},4,[355,518,510],{"class":361},[355,520,521],{"class":365}," apply",[355,523,524],{"class":365}," -target=azurerm_cdn_frontdoor_profile.sites",[355,526,528],{"class":527},"sHwdD","   # the profile's identity first: its principal id is unknown until it exists\n",[355,530,532,534,536],{"class":357,"line":531},5,[355,533,510],{"class":361},[355,535,521],{"class":365},[355,537,538],{"class":527},"   # environment = \"local\" in terraform.tfvars; pick a name of your own\n",[355,540,542,544,547,550,553,557],{"class":357,"line":541},6,[355,543,510],{"class":361},[355,545,546],{"class":365}," output",[355,548,549],{"class":365}," -raw",[355,551,552],{"class":365}," application_local_yml",[355,554,556],{"class":555},"sMK4o"," >",[355,558,559],{"class":365}," ..\u002F..\u002F..\u002F..\u002Fkinotic-server\u002Fsrc\u002Fmain\u002Fresources\u002Fapplication-local.yml\n",[228,561,562,563,566,567,570,571,574],{},"That is a resource group, a Front Door Standard profile with an endpoint and an identity\nthat reads every organization's storage, the\n",[260,564,565],{},"apps-\u003Cenvironment>.\u003Czone>"," sites domain in the platform's DNS zone, and a service principal\nfor the server with the roles it needs: Contributor and Storage Blob Data Contributor on the\ngroup, DNS Zone Contributor on the zone, and Contributor on the email service, so it sends\nmail too. The written file is the git-ignored ",[260,568,569],{},"local"," profile: it turns both provisioners on\nand names those resources. Turning the storage provisioner on is also what moves publishing\noff the development profile's Azurite, whose connection string the layered profile still\ncarries: with the provisioner on, each organization is reached at the account it was\nprovisioned in. The ",[260,572,573],{},"environment"," is yours alone: a site hostname can be bound to\none Front Door profile in all of Azure, so two developers sharing a sites domain would\ncollide.",[228,576,577,578,289,581,584,585,588,589,592,593,596,597,600,601,604,605,609],{},"The principal's ",[260,579,580],{},"AZURE_CLIENT_ID",[260,582,583],{},"AZURE_CLIENT_SECRET"," and ",[260,586,587],{},"AZURE_TENANT_ID"," are written to\n",[260,590,591],{},".env.local"," at the repository root, which git ignores, as a commented block after a blank\nline. When the file exists its other lines are kept and the block a previous apply wrote is\nreplaced, or appended if absent. Run the server with that file\nin its environment; ",[260,594,595],{},"DefaultAzureCredential"," takes those variables before anything else, so\nthe server provisions as the principal whatever ",[260,598,599],{},"az login"," is signed in as. A role\nassignment takes a minute or two to become visible; an organization provisioned before that\nfails with ",[260,602,603],{},"AuthorizationFailed",", and ",[606,607,608],"strong",{},"Provision again"," finishes it once the roles have\npropagated.",[228,611,612],{},"Run the server with both profiles:",[346,614,616],{"className":348,"code":615,"language":350,"meta":351,"style":351},"SPRING_PROFILES_ACTIVE=development,local\n",[260,617,618],{"__ignoreMap":351},[355,619,620,624,627],{"class":357,"line":358},[355,621,623],{"class":622},"sTEyZ","SPRING_PROFILES_ACTIVE",[355,625,626],{"class":555},"=",[355,628,629],{"class":365},"development,local\n",[228,631,632,633,635],{},"The ",[260,634,569],{}," profile overrides the development one, which already disables private endpoints:\na developer machine is outside any platform VNet, so the server and the publish workload reach\neach storage account over its public endpoint, and the workload's egress allowlist names that\nhost.",[228,637,638,639,642,643,646],{},"Before involving the server, run the provisioning against your subscription as a test. It\ndoes what the provisioning job and a deployment do, for a fixed organization ",[260,640,641],{},"kinotic-azure-it","\nand a site ",[260,644,645],{},"azure-it.apps-\u003Cenvironment>.\u003Czone>",", and reads back from Azure what each step\ncreated, so a step Azure rejects fails naming the call:",[346,648,650],{"className":348,"code":649,"language":350,"meta":351,"style":351},".\u002Fgradlew :kinotic-system-api:test --tests '*AzureProvisioningIntegrationTest*'\n",[260,651,652],{"__ignoreMap":351},[355,653,654,656,659,662,665,668],{"class":357,"line":358},[355,655,362],{"class":361},[355,657,658],{"class":365}," :kinotic-system-api:test",[355,660,661],{"class":365}," --tests",[355,663,664],{"class":555}," '",[355,666,667],{"class":365},"*AzureProvisioningIntegrationTest*",[355,669,670],{"class":555},"'\n",[228,672,673,674,676,677,680,681,684,685,688],{},"The module's test task puts ",[260,675,591],{}," in the test's environment, and the test reads your\n",[260,678,679],{},"application-local.yml","; without either it skips. What it creates is left in place, so a second\nrun is quick, and ",[260,682,683],{},"terraform destroy"," removes the account with the resource group; the site's\nrecords under ",[260,686,687],{},"apps-\u003Cenvironment>"," in the zone are removed by hand.",[228,690,691,692,694,695,698,699,702,703,706],{},"Then sign up an organization, or open an existing one in the system console and choose\n",[606,693,608],{},": the ",[260,696,697],{},"provision-organization-\u003Cid>"," job creates its storage account and\nprepares its Front Door origin group, and the organization's overview shows the\noutcome. Deploy a project that contains a UI; the deployment publishes it and provisions its\nsite, served at ",[260,700,701],{},"https:\u002F\u002F\u003Clabel>.apps-\u003Cenvironment>.\u003Czone>"," once Front Door has validated the\ndomain, issued its certificate and serves the UI's ",[260,704,705],{},"version.json",", which takes a few minutes\nand shows as the deployment turning from provisioning to ready.",[228,708,709,711,712,714],{},[260,710,683],{}," removes the resource group with every storage account and Front Door\nresource the server created in it. The CNAME and validation TXT records of sites live in the\nplatform's DNS zone, outside the group; removing a deployment removes them, so remove your\ndeployments first, or delete the records under ",[260,713,687],{}," by hand.",[224,716,718],{"id":717},"submitting-changes","Submitting Changes",[720,721,722,729,732,735],"ol",{},[723,724,725,726],"li",{},"Fork the repository and create a feature branch from ",[260,727,728],{},"develop",[723,730,731],{},"Make your changes with clear, descriptive commit messages",[723,733,734],{},"Ensure all tests pass before submitting",[723,736,737,738,740],{},"Submit a pull request against the ",[260,739,728],{}," branch",[742,743,744],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sHw