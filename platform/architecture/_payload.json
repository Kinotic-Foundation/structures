02Fdefense-in-depth","02.platform\u002F06.defense-in-depth",{"title":176,"path":177,"stem":178,"icon":179},"MCP Tools","\u002Fplatform\u002Fmcp-tools","02.platform\u002F07.mcp-tools","i-lucide-bot",{"title":181,"path":182,"stem":183,"icon":184},"Observability","\u002Fplatform\u002Fobservability","02.platform\u002F08.observability","i-lucide-activity",{"title":186,"path":187,"stem":188,"icon":189},"Contributing","\u002Fplatform\u002Fcontributing","02.platform\u002F09.contributing","i-lucide-git-pull-request",{"title":191,"path":192,"stem":193,"icon":194},"System Migrations","\u002Fplatform\u002Fsystem-migrations","02.platform\u002F10.system-migrations","i-lucide-database-zap",{"title":196,"path":197,"stem":198,"icon":199},"Service Call Liveness","\u002Fplatform\u002Fservice-call-liveness","02.platform\u002F11.service-call-liveness","i-lucide-heart-pulse",{"title":128,"icon":129,"path":201,"stem":202,"children":203,"page":36},"\u002Fplatform\u002Freference","02.platform\u002F12.reference",[204,209,214],{"title":205,"path":206,"stem":207,"icon":208},"CRI Format","\u002Fplatform\u002Freference\u002Fcri-format","02.platform\u002F12.reference\u002F01.cri-format","i-lucide-link",{"title":210,"path":211,"stem":212,"icon":213},"Grind Jobs","\u002Fplatform\u002Freference\u002Fgrind-jobs","02.platform\u002F12.reference\u002F02.grind-jobs","i-lucide-workflow",{"title":215,"path":216,"stem":217,"icon":151},"Project Publishing Design","\u002Fplatform\u002Freference\u002Fproject-publishing-design","02.platform\u002F12.reference\u002F03.project-publishing-design",{"title":219,"path":220,"stem":221,"icon":222},"Development Server","\u002Fplatform\u002Fdevelopment-server","02.platform\u002F13.development-server","i-lucide-server-cog",{"title":224,"path":225,"stem":226,"icon":227},"Supply Chain Security","\u002Fplatform\u002Fsupply-chain-security","02.platform\u002F14.supply-chain-security","i-lucide-package-check",{"title":229,"path":230,"stem":231,"icon":232},"Enterprise License","\u002Fplatform\u002Fenterprise-license","02.platform\u002F15.enterprise-license","i-lucide-badge-check",{"id":234,"title":148,"body":235,"description":492,"extension":493,"links":494,"meta":495,"navigation":496,"path":149,"seo":497,"stem":150,"__hash__":498},"docs\u002F02.platform\u002F01.architecture.md",{"type":236,"value":237,"toc":484},"minimark",[238,242,246,250,314,322,326,394,398,401,411,417,422,444,477,480],[239,240,25],"h2",{"id":241},"overview",[243,244,245],"p",{},"Kinotic OS is a full-stack application platform that handles service communication, persistence, authentication, authorization, deployment, and observability. The system is composed of several core components that work together to provide a seamless development and runtime experience.",[239,247,249],{"id":248},"core-components","Core Components",[251,252,253,270,283,296,302,308],"ul",{},[254,255,256,260,261,265,266,269],"li",{},[257,258,259],"strong",{},"Management server"," (",[262,263,264],"code",{},"kinotic-server-management",") — The API the portal, the Kinotic CLI and organization members' MCP hosts call: sign-up, logins and invitations, the ",[262,267,268],{},"management-api"," services, and the GitHub App's webhook.",[254,271,272,260,275,278,279,282],{},[257,273,274],{},"System server",[262,276,277],{},"kinotic-server-system",") — The API the system console and the vm-managers call: the ",[262,280,281],{},"system-api"," services, project deployments, and the cluster singletons that reconcile deployments and delete old workload runs.",[254,284,285,260,288,291,292,295],{},[257,286,287],{},"App server",[262,289,290],{},"kinotic-server-app",") — The API every application's users, UIs and microservices call: the ",[262,293,294],{},"app-api"," persistence services and the services applications publish in their own zones, each application at its own API host.",[254,297,298,301],{},[257,299,300],{},"RPC Gateway"," — Each server's gateway routes remote procedure calls between its clients and published services over STOMP\u002FWebSocket, and serves the server's REST and MCP endpoints.",[254,303,304,307],{},[257,305,306],{},"Persistence Layer"," — Provides automatic CRUD operations for entities backed by Elasticsearch.",[254,309,310,313],{},[257,311,312],{},"Auth System"," — Handles authentication (email\u002Fpassword and OIDC) across three authorization hierarchies: System, Organization, and Application. Each server admits only the participants it serves.",[243,315,316,317,321],{},"The three servers are Spring Boot applications that form one Ignite cluster, in which each hosts only its own zones. ",[318,319,172],"a",{"href":320},"\u002Fplatform\u002Fdefense-in-depth#network-architecture"," shows which participants each admits and which zones each hosts.",[239,323,325],{"id":324},"tech-stack","Tech Stack",[327,328,329,342],"table",{},[330,331,332],"thead",{},[333,334,335,339],"tr",{},[336,337,338],"th",{},"Component",[336,340,341],{},"Technology",[343,344,345,354,362,370,378,386],"tbody",{},[333,346,347,351],{},[348,349,350],"td",{},"Orchestration",[348,352,353],{},"Kubernetes",[333,355,356,359],{},[348,357,358],{},"Build Isolation",[348,360,361],{},"Firecracker VMs",[333,363,364,367],{},[348,365,366],{},"Runtime",[348,368,369],{},"Bun",[333,371,372,375],{},[348,373,374],{},"Search\u002FPersistence",[348,376,377],{},"Elasticsearch",[333,379,380,383],{},[348,381,382],{},"Logging",[348,384,385],{},"Grafana Loki",[333,387,388,391],{},[348,389,390],{},"Payments",[348,392,393],{},"Stripe Connect",[239,395,397],{"id":396},"communication","Communication",[243,399,400],{},"Services communicate via STOMP over WebSocket, with messages routed by CRI (Kinotic Resource Identifier). Each service, method, and event stream is addressable through a CRI, which follows the format:",[402,403,408],"pre",{"className":404,"code":406,"language":407},[405],"language-text","scheme:\u002F\u002F[scope@]resourceName[\u002Fpath][#version]\n","text",[262,409,406],{"__ignoreMap":410},"",[243,412,413,414,416],{},"The RPC gateway uses CRIs to route requests to the correct service instance, apply versioning, and enforce scope-based multi-tenancy. See the ",[318,415,205],{"href":206}," reference for details.",[418,419,421],"h3",{"id":420},"never-block-the-event-loop","Never block the event loop",[243,423,424,425,428,429,432,433,432,436,439,440,443],{},"A Java service published with ",[262,426,427],{},"@Publish"," is invoked on a Vert.x event loop it shares with the other services on the node, the same rule Vert.x sets for its own handlers. A method returns a ",[262,430,431],{},"Future",", ",[262,434,435],{},"CompletableFuture",[262,437,438],{},"Mono"," or ",[262,441,442],{},"Flux"," and lets the work complete off the loop; a method that is slow, because it blocks on a synchronous client, a lock or a sleep, or because it does heavy CPU work, hands that work off inside itself:",[402,445,449],{"className":446,"code":447,"language":448,"meta":410,"style":410},"language-java shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","@Override\npublic Future\u003CReport> render(String id) {\n    return vertx.executeBlocking(() -> renderer.render(id));   \u002F\u002F the loop is free while the worker runs\n}\n","java",[262,450,451,459,465,471],{"__ignoreMap":410},[452,453,456],"span",{"class":454,"line":455},"line",1,[452,457,458],{},"@Override\n",[452,460,462],{"class":454,"line":461},2,[452,463,464],{},"public Future\u003CReport> render(String id) {\n",[452,466,468],{"class":454,"line":467},3,[452,469,470],{},"    return vertx.executeBlocking(() -> renderer.render(id));   \u002F\u002F the loop is free while the worker runs\n",[452,472,474],{"class":454,"line":473},4,[452,475,476],{},"}\n",[243,478,479],{},"The platform never hands off on a service's behalf. A method that blocks stalls every service sharing its loop, and Vert.x's blocked-thread checker reports it in the log.",[481,482,483],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":410,"searchDepth":461,"depth":461,"links":485},[486,487,488,489],{"id":241,"depth":461,"text":25},{"id":248,"depth":461,"text":249},{"id":324,"depth":461,"text":325},{"id":396,"depth":461,"text":397,"children":490},[491],{"id":420,"depth":467,"text":421},"High-level architecture of the Kinotic OS platform.","md",null,{},{"icon":151},{"title":148,"description":492},"ebGXgzRkuvDeWdkupzuKD9UTfdmoSRdMk4fc070c-rg",[500,502],{"title":139,"path":140,"stem":141,"description":501,"icon":60,"children":-1},"Complete SQL grammar reference for migration scripts.",{"title":153,"path":154,"stem":155,"description":503,"icon":6,"children":-1},"Deploying and operating Kinotic OS in various environments.",1792489710941]